<figure class="supervision-diagram" data-supervision-diagram aria-labelledby="supervision-diagram-title supervision-diagram-caption">
  <div class="supervision-diagram__canvas">
    <svg class="supervision-diagram__connections" viewBox="0 0 620 400" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="supervision-beam" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffd66f" stop-opacity=".68" />
          <stop offset="1" stop-color="#ffd66f" stop-opacity=".16" />
        </linearGradient>
      </defs>
      <path class="supervision-diagram__beam" data-supervision-beam d="M310 120 402 178H218Z" />
      <g class="supervision-diagram__routes">
        <path data-supervision-route="legacy" d="M310 220H310" />
        <path data-supervision-route="data" d="M310 220H310" />
        <path data-supervision-route="pipelines" d="M310 220H310" />
        <path data-supervision-route="sis" d="M310 220H310" />
        <path data-supervision-route="future" d="M310 220H310" />
        <path data-supervision-route="lms" d="M310 220H310" />
      </g>
      <g class="supervision-diagram__signals">
        <circle r="4.5"><animateMotion data-supervision-signal="legacy" dur="3s" begin="-.4s" repeatCount="indefinite" path="M310 220H310" /></circle>
        <circle r="4.5"><animateMotion data-supervision-signal="data" dur="3.25s" begin="-1.7s" repeatCount="indefinite" path="M310 220H310" /></circle>
        <circle r="4.5"><animateMotion data-supervision-signal="pipelines" dur="3.5s" begin="-.9s" repeatCount="indefinite" path="M310 220H310" /></circle>
        <circle r="4.5"><animateMotion data-supervision-signal="sis" dur="3.15s" begin="-2.1s" repeatCount="indefinite" path="M310 220H310" /></circle>
        <circle r="4.5"><animateMotion data-supervision-signal="future" dur="3.35s" begin="-1.1s" repeatCount="indefinite" path="M310 220H310" /></circle>
        <circle r="4.5"><animateMotion data-supervision-signal="lms" dur="3.6s" begin="-2.6s" repeatCount="indefinite" path="M310 220H310" /></circle>
      </g>
    </svg>

    <div class="supervision-diagram__engineer">
      <span class="supervision-diagram__person" aria-hidden="true">
        <svg viewBox="0 0 64 64">
          <circle cx="32" cy="32" r="29" />
          <circle cx="32" cy="24" r="10" />
          <path d="M15 51c2.4-10 8.1-15 17-15s14.6 5 17 15" />
        </svg>
      </span>
      <span><strong id="supervision-diagram-title">Engineer</strong></span>
    </div>

    <div class="supervision-diagram__agent-group">
      <div class="supervision-agent-pool" data-supervision-target aria-label="Specialized Akaden agents coordinate the platform workflow">
        <div class="supervision-agent-pool__icons" aria-hidden="true">
          <span><svg viewBox="0 0 32 32"><rect x="6" y="8" width="20" height="17" rx="5" /><path d="M16 4v4M11 15h.1M21 15h.1M11 20h10" /></svg></span>
          <span><svg viewBox="0 0 32 32"><rect x="6" y="8" width="20" height="17" rx="5" /><path d="M16 4v4M11 15h.1M21 15h.1M11 20h10" /></svg></span>
          <span><svg viewBox="0 0 32 32"><rect x="6" y="8" width="20" height="17" rx="5" /><path d="M16 4v4M11 15h.1M21 15h.1M11 20h10" /></svg></span>
        </div>
        <span><strong>Specialized agents</strong></span>
      </div>
    </div>

    <div class="supervision-node supervision-node--legacy" data-supervision-source="legacy">
      <span aria-hidden="true"><svg viewBox="0 0 28 28"><rect x="3" y="5" width="22" height="18" rx="2" /><path d="m8 11 3 3-3 3M14 17h5" /></svg></span>
      <strong>Legacy systems</strong>
    </div>
    <div class="supervision-node supervision-node--data" data-supervision-source="data">
      <span aria-hidden="true"><svg viewBox="0 0 28 28"><ellipse cx="14" cy="7" rx="9" ry="3.5" /><path d="M5 7v7c0 2 4 3.5 9 3.5s9-1.5 9-3.5V7M5 14v7c0 2 4 3.5 9 3.5s9-1.5 9-3.5v-7" /></svg></span>
      <strong>Data warehouse</strong>
    </div>
    <div class="supervision-node supervision-node--pipelines" data-supervision-source="pipelines">
      <span aria-hidden="true"><svg viewBox="0 0 28 28"><circle cx="5" cy="7" r="2" /><circle cx="23" cy="21" r="2" /><path d="M7 7h8a4 4 0 0 1 4 4v8M5 9v8a4 4 0 0 0 4 4h12M12 4v6M10 12h5" /></svg></span>
      <strong>Build / test / monitor / debug pipelines</strong>
    </div>
    <div class="supervision-node supervision-node--sis" data-supervision-source="sis">
      <span aria-hidden="true"><svg viewBox="0 0 28 28"><rect x="3" y="4" width="22" height="20" rx="2" /><circle cx="10" cy="11" r="3" /><path d="M6 19c1-3 2.4-4.5 4-4.5S13 16 14 19M17 9h5M17 13h5M17 17h4" /></svg></span>
      <strong>Student records / SIS</strong>
    </div>
    <div class="supervision-node supervision-node--lms" data-supervision-source="lms">
      <span aria-hidden="true"><svg viewBox="0 0 28 28"><path d="m3 11 11-6 11 6-11 6zM7 13.2V20c3.1 2.2 10.9 2.2 14 0v-6.8M24 12v7" /></svg></span>
      <strong>LMS</strong>
    </div>
    <div class="supervision-node supervision-node--future" data-supervision-source="future">
      <span aria-hidden="true"><svg viewBox="0 0 28 28"><rect x="3" y="3" width="22" height="22" rx="6" stroke-dasharray="3 3" /><path d="M14 9v10M9 14h10" /></svg></span>
      <strong>What comes next</strong>
    </div>
  </div>
  <figcaption id="supervision-diagram-caption">Data from every connected system flows into one platform. Your engineer manages the agents and stays in control of every decision.</figcaption>
</figure>

<style>
  .supervision-diagram{margin:0}.supervision-diagram__canvas{position:relative;isolation:isolate;width:100%;min-height:0;aspect-ratio:29/20;overflow:hidden;border:1px solid #c9d7ea;background:linear-gradient(145deg,rgb(255 255 255/.95),rgb(231 241 255/.88));box-shadow:0 26px 58px -42px rgb(15 46 104/.55)}
  .supervision-diagram__canvas::before{position:absolute;z-index:-1;right:-7rem;bottom:-7rem;width:21rem;height:21rem;border:3rem solid rgb(85 182 231/.12);border-radius:50%;content:""}.supervision-diagram__connections{position:absolute;z-index:0;inset:0;width:100%;height:100%;pointer-events:none;opacity:0;transition:opacity .16s ease}.supervision-diagram.is-ready .supervision-diagram__connections{opacity:1}.supervision-diagram__beam{fill:url(#supervision-beam)}.supervision-diagram__routes{fill:none;stroke:#1769e0;stroke-width:2.25;stroke-linecap:round;opacity:.58;vector-effect:non-scaling-stroke}.supervision-diagram__signals circle{fill:#1769e0;stroke:#fff;stroke-width:1.5;filter:drop-shadow(0 2px 3px rgb(23 105 224/.3));opacity:0;transition:opacity .5s ease;vector-effect:non-scaling-stroke}.supervision-diagram.is-ready .supervision-diagram__signals circle{opacity:1}
  .supervision-diagram__engineer{position:absolute;z-index:2;top:2rem;left:50%;display:flex;flex-direction:column;align-items:center;gap:.28rem;width:max-content;max-width:84%;text-align:center;transform:translateX(-50%)}.supervision-diagram__person{display:block;width:4.1rem;height:4.1rem;flex:none}.supervision-diagram__person svg{display:block;width:100%;height:100%;fill:none;stroke:#15285d;stroke-width:2.7}.supervision-diagram__person circle:nth-child(2),.supervision-diagram__person path{fill:#15285d;stroke:none}.supervision-diagram__engineer>span:last-child{display:grid;gap:.16rem}.supervision-diagram__engineer strong{color:#15285d;font-size:1.12rem}.supervision-diagram__engineer small{color:#5a6881;font-size:.7rem;line-height:1.3}
  .supervision-diagram__agent-group{position:absolute;z-index:2;top:11.8rem;left:50%;transform:translateX(-50%)}.supervision-agent-pool{display:flex;width:11.5rem;min-height:4.7rem;align-items:center;justify-content:center;gap:.62rem;border:1px solid rgb(197 140 19/.28);background:#fff;padding:.58rem .7rem;box-shadow:0 0 0 5px rgb(255 214 111/.15),0 16px 30px -22px rgb(13 43 98/.7)}.supervision-agent-pool__icons{display:flex;flex:none;padding-left:.5rem}.supervision-agent-pool__icons span{display:grid;width:1.95rem;height:1.95rem;place-items:center;margin-left:-.5rem;border:2px solid #fff;border-radius:50%;background:#e7f1ff;color:#1769e0}.supervision-agent-pool__icons span:nth-child(2){background:#1769e0;color:#fff}.supervision-agent-pool__icons svg{width:1.32rem;height:1.32rem;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.supervision-agent-pool>span:last-child{display:grid;gap:.1rem}.supervision-agent-pool strong{color:#15285d;font-size:.78rem;line-height:1.15}
  .supervision-node{position:absolute;z-index:2;display:flex;align-items:center;gap:.55rem;border:1px solid #bdd0e9;background:rgb(255 255 255/.94);padding:.66rem .72rem;color:#25416f;box-shadow:0 15px 28px -21px rgb(13 43 98/.58)}.supervision-node>span{display:grid;width:1.75rem;height:1.75rem;place-items:center;flex:none;color:#1769e0}.supervision-node svg{display:block;width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.supervision-node strong{font-size:.72rem;line-height:1.22}.supervision-node--legacy{top:8.1rem;left:14%;width:9.2rem}.supervision-node--data{top:13.15rem;left:5%;width:9.4rem}.supervision-node--pipelines{top:18.95rem;left:17%;width:12.4rem}.supervision-node--sis{top:8.25rem;right:11%;width:10.4rem}.supervision-node--future{top:13.3rem;right:5%;width:9.8rem}.supervision-node--lms{top:19.05rem;right:19%;width:7.5rem}
  .supervision-diagram figcaption{max-width:35rem;margin:1rem 0 0;color:#5a6881;font-size:.78rem;line-height:1.5}
  @media(max-width:900px){.supervision-diagram{max-width:38rem;margin-inline:auto}}
  @media(max-width:520px){.supervision-diagram__canvas{min-height:35rem;aspect-ratio:auto}.supervision-diagram__engineer{top:1.35rem;max-width:90%}.supervision-diagram__person{width:3.75rem;height:3.75rem}.supervision-diagram__agent-group{top:11.5rem}.supervision-agent-pool{gap:.55rem;padding:.55rem .6rem}.supervision-node{width:calc(50% - 1.15rem);min-height:3.5rem;padding:.55rem}.supervision-node--legacy,.supervision-node--data,.supervision-node--pipelines{left:.55rem}.supervision-node--sis,.supervision-node--lms,.supervision-node--future{right:.55rem}.supervision-node--legacy,.supervision-node--sis{top:7.4rem}.supervision-node--data,.supervision-node--lms{top:17.1rem}.supervision-node--pipelines,.supervision-node--future{top:26.8rem}.supervision-diagram__connections{transform:scaleX(1.15)}.supervision-diagram__routes,.supervision-diagram__signals{display:none}}
  @media(prefers-reduced-motion:reduce){.supervision-diagram__signals{display:none}}
</style>

<script>
  type Point = { x: number; y: number };
  type DiagramElement = HTMLElement & { _supervisionCleanup?: () => void };

  const VIEWBOX_WIDTH = 620;
  const VIEWBOX_HEIGHT = 400;

  const edgeToward = (from: DOMRect, to: DOMRect): Point => {
    const fromCenter = { x: from.left + from.width / 2, y: from.top + from.height / 2 };
    const toCenter = { x: to.left + to.width / 2, y: to.top + to.height / 2 };
    const dx = toCenter.x - fromCenter.x;
    const dy = toCenter.y - fromCenter.y;
    const xScale = dx === 0 ? Number.POSITIVE_INFINITY : from.width / 2 / Math.abs(dx);
    const yScale = dy === 0 ? Number.POSITIVE_INFINITY : from.height / 2 / Math.abs(dy);
    const scale = Math.min(xScale, yScale);

    return { x: fromCenter.x + dx * scale, y: fromCenter.y + dy * scale };
  };

  const setupSupervisionDiagram = (diagram: DiagramElement) => {
    diagram._supervisionCleanup?.();

    const canvas = diagram.querySelector<HTMLElement>('.supervision-diagram__canvas');
    const engineer = diagram.querySelector<HTMLElement>('.supervision-diagram__engineer');
    const target = diagram.querySelector<HTMLElement>('[data-supervision-target]');
    const beam = diagram.querySelector<SVGPathElement>('[data-supervision-beam]');
    const sources = [...diagram.querySelectorAll<HTMLElement>('[data-supervision-source]')];
    if (!canvas || !engineer || !target || !beam || sources.length === 0) return;

    let frame = 0;
    const update = () => {
      const canvasRect = canvas.getBoundingClientRect();
      const targetRect = target.getBoundingClientRect();
      const engineerRect = engineer.getBoundingClientRect();
      if (canvasRect.width === 0 || canvasRect.height === 0) return;

      const toSvg = (point: Point): Point => ({
        x: (point.x - canvasRect.left) * VIEWBOX_WIDTH / canvasRect.width,
        y: (point.y - canvasRect.top) * VIEWBOX_HEIGHT / canvasRect.height,
      });
      const format = (point: Point) => `${point.x.toFixed(1)} ${point.y.toFixed(1)}`;

      const beamApex = toSvg({
        x: engineerRect.left + engineerRect.width / 2,
        y: engineerRect.bottom + 4,
      });
      const beamLeft = toSvg({ x: targetRect.left, y: targetRect.top });
      const beamRight = toSvg({ x: targetRect.right, y: targetRect.top });
      beam.setAttribute('d', `M${format(beamApex)}L${format(beamRight)}H${beamLeft.x.toFixed(1)}Z`);

      sources.forEach((source) => {
        const key = source.dataset.supervisionSource;
        if (!key) return;
        const route = diagram.querySelector<SVGPathElement>(`[data-supervision-route="${key}"]`);
        const motion = diagram.querySelector<SVGElement>(`[data-supervision-signal="${key}"]`);
        if (!route || !motion) return;

        const sourceRect = source.getBoundingClientRect();
        const start = toSvg(edgeToward(sourceRect, targetRect));
        const end = toSvg(edgeToward(targetRect, sourceRect));
        const direction = Math.sign(end.x - start.x) || 1;
        const handle = Math.min(78, Math.max(26, Math.abs(end.x - start.x) * .52));
        const path = `M${format(start)}C${(start.x + direction * handle).toFixed(1)} ${start.y.toFixed(1)} ${(end.x - direction * handle * .58).toFixed(1)} ${end.y.toFixed(1)} ${format(end)}`;

        route.setAttribute('d', path);
        motion.setAttribute('path', path);
      });

      diagram.classList.add('is-ready');
    };

    const queueUpdate = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };
    const observer = new ResizeObserver(queueUpdate);
    observer.observe(canvas);
    observer.observe(engineer);
    observer.observe(target);
    sources.forEach((source) => observer.observe(source));
    window.addEventListener('resize', queueUpdate, { passive: true });
    document.fonts?.ready.then(queueUpdate);
    queueUpdate();

    diagram._supervisionCleanup = () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      window.removeEventListener('resize', queueUpdate);
    };
  };

  document.querySelectorAll<DiagramElement>('[data-supervision-diagram]').forEach(setupSupervisionDiagram);
</script>
