---
import { nav, site } from '../data/site';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pageLink = (href: string) => href.startsWith('#') ? `${basePath}${href}` : href;
---
<header class="site-header" data-site-header>
  <nav class="site-nav" aria-label="Primary navigation">
    <a href={basePath} class="site-brand" aria-label="Akaden home">
      <span class="site-brand__icon" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <path d="M18 77 50 22l32 55" opacity=".45" />
          <path d="M50 22 18 77" />
          <circle cx="50" cy="78" r="10" />
        </svg>
      </span>
      <span>AKADEN</span>
    </a>

    <span class="site-nav__divider" aria-hidden="true"></span>
    <span class="site-nav__descriptor">Pipeline IDE</span>

    <ul class="site-nav__links">
      {nav.tabs.map((tab) => (
        <li><a href={pageLink(tab.href)}>{tab.label}</a></li>
      ))}
    </ul>

    <div class="site-nav__actions">
      <a class="site-nav__owner" href={site.ownerUrl}>ABCloudz</a>
      <a class="site-nav__cta" href={pageLink(nav.cta.href)}>{nav.cta.label}</a>
    </div>
  </nav>
</header>

<style>
  .site-header{position:sticky;top:0;z-index:40;border-bottom:1px solid #d7dce5;background:rgb(255 255 255/.96);backdrop-filter:blur(14px)}
  .site-nav{display:flex;align-items:center;gap:1.05rem;width:min(100% - 2rem,75rem);height:4.25rem;margin-inline:auto}
  .site-brand{display:inline-flex;align-items:center;gap:.58rem;color:#11213f;font-size:1.32rem;font-style:italic;font-weight:900;letter-spacing:-.04em;text-decoration:none}
  .site-brand__icon{display:grid;width:1.75rem;height:1.75rem;place-items:center;border-radius:.35rem;background:#1769e0}
  .site-brand__icon svg{width:82%;height:82%;fill:#fff;stroke:#fff;stroke-width:10;stroke-linecap:round;stroke-linejoin:round}
  .site-nav__divider{width:1px;height:1.8rem;background:#8992a5}
  .site-nav__descriptor{color:#17223a;font-size:.95rem;font-weight:700;white-space:nowrap}
  .site-nav__links{display:flex;align-items:center;gap:.15rem;margin:0 0 0 1rem;padding:0;list-style:none}
  .site-nav__links a,.site-nav__owner{display:inline-flex;min-height:2.75rem;align-items:center;padding:.45rem .75rem;color:#263044;font-size:.9rem;font-weight:600;text-decoration:none}
  .site-nav__links a:hover,.site-nav__owner:hover{text-decoration:underline;text-underline-offset:.25rem}
  .site-nav__actions{display:flex;align-items:center;gap:.4rem;margin-left:auto}
  .site-nav__cta{display:inline-flex;min-height:2.55rem;align-items:center;background:#162d52;padding:.55rem 1.05rem;color:#fff;font-size:.9rem;font-weight:700;text-decoration:none}
  .site-nav__cta:hover{background:#0c1c37}
  @media(max-width:880px){.site-nav__links{display:none}.site-nav__descriptor{font-size:.86rem}}
  @media(max-width:560px){.site-nav{width:min(100% - 1.25rem,75rem);height:3.85rem;gap:.7rem}.site-nav__divider,.site-nav__descriptor,.site-nav__owner{display:none}.site-nav__cta{min-height:2.4rem;padding:.5rem .85rem;font-size:.82rem}}
</style>
