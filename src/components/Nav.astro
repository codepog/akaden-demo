---
import { nav, site } from '../data/site';
---
<header class="sticky top-0 z-50 border-b border-rule bg-ground/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-[1200px] items-center gap-6 px-4 sm:px-6" aria-label="Primary">
    <a href="./" class="u-wordmark text-[1.375rem] text-blue-deep shrink-0">
      AKADEN
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {nav.tabs.map((tab) => (
        <li>
          {tab.live ? (
            <a
              href={tab.href}
              aria-current="page"
              class="rounded-md px-3 py-2 text-[0.9375rem] font-semibold text-ink hover:text-blue-bright"
            >
              {tab.label}
            </a>
          ) : (
            <span
              aria-disabled="true"
              class="flex cursor-default items-center gap-2 rounded-md px-3 py-2 text-[0.9375rem] text-ink-soft"
            >
              {tab.label}
              <span class="u-label rounded-sm border border-rule-strong px-1.5 py-0.5 text-[0.5625rem] text-ink-soft">
                Soon
              </span>
            </span>
          )}
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-3">
      <a href={site.ownerUrl} class="hidden text-[0.9375rem] text-ink-soft hover:text-ink sm:inline">
        ABCloudz
      </a>
      <a href={nav.cta.href} class="u-btn u-btn-primary !px-4 !py-2 !text-[0.9375rem]">
        {nav.cta.label}
      </a>
    </div>
  </nav>
</header>
