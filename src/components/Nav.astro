---
import { nav, site } from '../data/site';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const pageHref = (href: string) => {
  if (href.startsWith('#')) return href;
  const route = href.replace(/^\.\//, '').replace(/\/$/, '');
  if (!route) return basePath;
  return import.meta.env.DEV ? `${basePath}${route}` : `${basePath}${route}.html`;
};
const isCurrentPage = (href: string) => {
  if (href.startsWith('#')) return false;
  const route = href.replace(/^\.\//, '').replace(/\/$/, '');
  if (!route) return currentPath === '' || currentPath === basePath.replace(/\/$/, '');
  return currentPath.endsWith(`/${route}`) || currentPath.endsWith(`/${route}.html`);
};
const bookingHref = isCurrentPage('./') ? nav.cta.href : `${basePath}${nav.cta.href}`;
---
<header class="sticky top-0 z-50 border-b border-rule bg-ground/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-[1200px] items-center gap-6 px-4 sm:px-6" aria-label="Primary">
    <a href="./" class="u-wordmark flex shrink-0 items-center gap-2 text-[1.375rem] text-blue-deep">
      <span class="grid h-7 w-7 place-items-center rounded-[.4rem] bg-blue-bright" aria-hidden="true">
        <svg class="h-[78%] w-[78%]" viewBox="0 0 100 100">
          <defs>
            <clipPath id="nav-appicon-clip-left" clipPathUnits="userSpaceOnUse">
              <polygon points="78.96,92.89 9.13,-28.45 -103.55,36.39 -33.72,157.73" />
            </clipPath>
            <clipPath id="nav-appicon-clip-right" clipPathUnits="userSpaceOnUse">
              <polygon points="21.04,92.89 90.87,-28.45 203.55,36.39 133.72,157.73" />
            </clipPath>
          </defs>
          <g fill="none" stroke="white" stroke-width="20.76" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18.13 77.24 50 21.86 81.87 77.24" opacity=".475" />
            <path d="M50 21.86 81.87 77.24" opacity=".475" clip-path="url(#nav-appicon-clip-right)" />
            <path d="M50 21.86 18.13 77.24" clip-path="url(#nav-appicon-clip-left)" />
          </g>
          <circle cx="50" cy="77.89" r="10.37" fill="white" />
        </svg>
      </span>
      <span>AKADEN</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {nav.tabs.map((tab) => (
        <li>
          {tab.live ? (
            <a
              href={pageHref(tab.href)}
              aria-current={isCurrentPage(tab.href) ? 'page' : undefined}
              data-section-link={tab.href.startsWith('#') ? tab.href.slice(1) : undefined}
              class="section-nav-link rounded-md px-3 py-2 text-[0.9375rem] font-semibold text-ink hover:text-blue-bright"
            >
              {tab.label}
            </a>
          ) : (
            <span
              aria-disabled="true"
              class="flex cursor-default items-center gap-2 rounded-md px-3 py-2 text-[0.9375rem] text-ink-soft"
            >
              {tab.label}
              <span class="u-label rounded-sm border border-rule-strong px-1.5 py-0.5 text-[0.5625rem] text-ink-soft">
                Soon
              </span>
            </span>
          )}
        </li>
      ))}
    </ul>

    <div class="ml-auto flex items-center gap-3">
      <a href={site.ownerUrl} class="hidden text-[0.9375rem] text-ink-soft hover:text-ink sm:inline">
        ABCloudz
      </a>
      <a href={bookingHref} class="u-btn u-btn-primary !px-4 !py-2 !text-[0.9375rem]">
        {nav.cta.label}
      </a>
    </div>
  </nav>
</header>

<style>
  .section-nav-link{position:relative}
  .section-nav-link::after{position:absolute;right:.75rem;bottom:-.78rem;left:.75rem;height:3px;border-radius:999px;background:#1769e0;content:"";opacity:0;transform:scaleX(.45);transition:opacity .18s ease,transform .18s ease}
  .section-nav-link.is-active{color:#1769e0}
  .section-nav-link.is-active::after{opacity:1;transform:scaleX(1)}
  @media(prefers-reduced-motion:reduce){.section-nav-link::after{transition:none}}
</style>

<script>
  const sectionItems = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'))
    .map((link) => {
      const sectionId = link.dataset.sectionLink;
      const section = sectionId ? document.getElementById(sectionId) : null;
      return section ? { link, section } : null;
    })
    .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item !== null);

  if (sectionItems.length) {
    let updateScheduled = false;

    const updateActiveSection = () => {
      const activationLine = window.scrollY + Math.min(window.innerHeight * .32, 260);
      let activeItem = sectionItems[0];

      sectionItems.forEach((item) => {
        if (item.section.offsetTop <= activationLine) activeItem = item;
      });

      sectionItems.forEach((item) => {
        const isActive = item === activeItem;
        item.link.classList.toggle('is-active', isActive);
        if (isActive) item.link.setAttribute('aria-current', 'location');
        else item.link.removeAttribute('aria-current');
      });
      updateScheduled = false;
    };

    const scheduleActiveSectionUpdate = () => {
      if (updateScheduled) return;
      updateScheduled = true;
      window.requestAnimationFrame(updateActiveSection);
    };

    window.addEventListener('scroll', scheduleActiveSectionUpdate, { passive: true });
    window.addEventListener('resize', scheduleActiveSectionUpdate);
    window.addEventListener('hashchange', scheduleActiveSectionUpdate);
    scheduleActiveSectionUpdate();
  }
</script>
