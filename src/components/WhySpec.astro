---
import { whySpec } from '../data/site';
---
<section id="why" class="border-b border-rule bg-paper scroll-mt-20">
  <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 sm:py-28">
    <p class="u-label text-blue">{whySpec.eyebrow}</p>
    <h2 class="u-h2 mt-4 text-blue-deep">{whySpec.headline}</h2>
    <p class="u-lead u-measure mt-5">{whySpec.lead}</p>

    <div class="mt-14 grid gap-x-14 gap-y-12 sm:grid-cols-2">
      {whySpec.points.map((p) => (
        <div>
          <h3 class="u-h3 text-blue-deep">{p.title}</h3>
          <p class="mt-3 max-w-[46ch] text-ink-soft">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
