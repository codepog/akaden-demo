---
const stages = [
  {
    number: '01',
    title: 'Prepare workspace',
    detail: 'Add the business request and the context Akaden needs.',
    kind: 'workspace',
    mark: '↓',
  },
  {
    number: '02',
    title: 'Draft specification',
    detail: 'The Specification Builder Agent turns the request into a clear plan.',
    kind: 'agent',
    mark: 'AI',
  },
  {
    number: '03',
    title: 'Review specification',
    detail: 'A person checks the decisions and approves the work to continue.',
    kind: 'review',
    mark: '✓',
  },
  {
    number: '04',
    title: 'Build pipeline',
    detail: 'The Pipeline Builder Agent generates the pipeline from the approved plan.',
    kind: 'agent',
    mark: 'AI',
  },
  {
    number: '05',
    title: 'Deploy and validate',
    detail: 'Deploy to the tenant, run it, and check the result against the specification.',
    kind: 'deploy',
    mark: '↑',
  },
];
---

<section id="walkthrough" class="border-b border-rule scroll-mt-20">
  <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 sm:py-28">
    <p class="u-label text-blue">How it works</p>
    <h2 class="u-h2 mt-4 max-w-[18ch] text-blue-deep">From request to reliable pipeline.</h2>
    <p class="u-lead u-measure mt-5">
      Akaden keeps the human decision at the center, then carries that approved specification all the way to a validated deployment.
    </p>

    <ol class="flow mt-14" aria-label="The Akaden workflow">
      {stages.map((stage) => (
        <li class="flow-step">
          <span class={`flow-icon ${stage.kind}`} aria-hidden="true">{stage.mark}</span>
          <p class="flow-number">{stage.number}</p>
          <h3>{stage.title}</h3>
          <p class="flow-detail">{stage.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .flow{
    list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2rem;
  }
  .flow-step{position:relative;min-width:0;}
  .flow-step:not(:last-child)::after{
    content:"";position:absolute;z-index:0;top:2.8rem;left:calc(50% + 3.6rem);right:calc(-50% + 3.6rem);
    border-top:2px solid var(--color-rule-strong);
  }
  .flow-step:not(:last-child)::before{
    content:"";position:absolute;z-index:1;top:calc(2.8rem - 4px);right:calc(-50% + 3.5rem);
    width:8px;height:8px;border-top:2px solid var(--color-rule-strong);border-right:2px solid var(--color-rule-strong);transform:rotate(45deg);
  }
  .flow-icon{
    position:relative;z-index:2;display:grid;place-items:center;width:5.5rem;height:5.5rem;border:3px solid var(--color-blue);
    border-radius:50%;background:var(--color-ground);color:var(--color-blue);font-family:var(--font-mono);font-size:1.65rem;font-weight:700;
  }
  .flow-icon.workspace{border-radius:.75rem;background:var(--color-blue-deep);color:#fff;border-color:var(--color-blue-deep);}
  .flow-icon.workspace::before{content:"";position:absolute;left:.65rem;top:-.42rem;width:2.2rem;height:.65rem;border-radius:.4rem .4rem 0 0;background:var(--color-blue-deep);}
  .flow-icon.agent{border-color:var(--color-agent);color:#8a5600;font-size:1rem;letter-spacing:.06em;}
  .flow-icon.review{font-family:var(--font-sans);font-size:3.1rem;line-height:1;}
  .flow-icon.deploy{border-radius:1.45rem;color:var(--color-blue);font-size:2.6rem;}
  .flow-number{margin:1.2rem 0 .4rem;font-family:var(--font-mono);font-size:.6875rem;font-weight:700;letter-spacing:.1em;color:var(--color-ink-soft);}
  .flow-step h3{margin:0;color:var(--color-blue-deep);font-size:1.125rem;line-height:1.2;letter-spacing:-.01em;}
  .flow-detail{margin:.65rem 0 0;color:var(--color-ink-soft);font-size:.9375rem;line-height:1.45;}

  @media (max-width:900px){
    .flow{grid-template-columns:repeat(2,minmax(0,1fr));gap:2.5rem 3rem;}
    .flow-step:not(:last-child)::after,.flow-step:not(:last-child)::before{display:none;}
  }
  @media (max-width:560px){
    .flow{grid-template-columns:1fr;gap:0;}
    .flow-step{display:grid;grid-template-columns:4rem minmax(0,1fr);column-gap:1rem;padding-bottom:2rem;}
    .flow-step:not(:last-child)::after{display:block;top:4rem;bottom:0;left:2rem;right:auto;border-top:0;border-left:2px solid var(--color-rule-strong);}
    .flow-step:not(:last-child)::before{display:none;}
    .flow-icon{grid-row:span 3;width:4rem;height:4rem;font-size:1.2rem;}
    .flow-icon.review{font-size:2.35rem;}
    .flow-icon.deploy{font-size:2rem;}
    .flow-icon.workspace::before{left:.45rem;width:1.65rem;}
    .flow-number{margin:.3rem 0;}
    .flow-step h3{font-size:1.125rem;}
    .flow-detail{margin:.35rem 0 0;}
  }
</style>
