---
import { footer, site } from '../data/site';
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pageLink = (href: string) => href.startsWith('#') ? `${basePath}${href}` : href;
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__brand">AKADEN</p>
      <p class="site-footer__tagline">{site.tagline}</p>
      <p class="site-footer__note">{footer.note}</p>
    </div>
    <nav aria-label="Footer navigation">
      <ul>
        {footer.links.map((link) => <li><a href={pageLink(link.href)}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="site-footer__legal">
    <p>Built by <a href={site.ownerUrl}>{site.owner}</a>.</p>
    <p>© 2026 ABCloudz</p>
  </div>
</footer>

<style>
  .site-footer{background:#081b3a;color:#fff;padding:4.5rem max(1rem,calc((100% - 75rem)/2)) 2rem}
  .site-footer__inner{display:flex;align-items:flex-start;justify-content:space-between;gap:3rem}
  .site-footer__brand{margin:0;font-size:1.65rem;font-style:italic;font-weight:900;letter-spacing:-.04em}
  .site-footer__tagline{max-width:29rem;margin:.8rem 0 0;color:#d5e9ff;font-size:1.05rem}
  .site-footer__note{max-width:34rem;margin:1rem 0 0;color:#aebed8;font-size:.92rem}
  .site-footer ul{display:grid;grid-template-columns:repeat(2,minmax(8rem,1fr));gap:.8rem 2rem;margin:0;padding:0;list-style:none}
  .site-footer a{color:#fff;text-underline-offset:.25rem}.site-footer a:hover{text-decoration-thickness:2px}
  .site-footer__legal{display:flex;justify-content:space-between;gap:2rem;margin-top:3.5rem;border-top:1px solid rgb(255 255 255/.18);padding-top:1.5rem;color:#aebed8;font-size:.8rem}
  .site-footer__legal p{margin:0}
  @media(max-width:680px){.site-footer__inner{display:grid}.site-footer ul{grid-template-columns:1fr}.site-footer__legal{display:grid;gap:.5rem}}
</style>
