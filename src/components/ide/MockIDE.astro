---
import Rail from './Rail.astro';
import Sidebar from './Sidebar.astro';
import Editor from './Editor.astro';
import Chat from './Chat.astro';
---
<div class="ide" data-ide>
  <div class="menubar">
    <button type="button" class="mi top-item">File<span class="top-popover"><b>File</b><small>Create, open, or manage workspace files.</small></span></button>
    <button type="button" class="mi top-item">Edit<span class="top-popover"><b>Edit</b><small>Make changes to the active artifact.</small></span></button>
    <button type="button" class="mi top-item">View<span class="top-popover"><b>View</b><small>Choose what you see in the workspace.</small></span></button>
    <button type="button" class="mi top-item">Help<span class="top-popover"><b>Help</b><small>Find guidance for the current task.</small></span></button>
    <button type="button" class="chipbtn top-item"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h16v14H4z"/><path d="M8 10l2 2-2 2M13 14h4" stroke-linecap="round"/></svg> Command Palette<span class="top-popover"><b>Command Palette</b><small>Jump straight to a workspace action.</small></span></button>
    <button type="button" class="chipbtn top-item"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5h6l2 2h8v12H4z"/></svg> test-env <span class="cv">⌄</span><span class="top-popover"><b>test-env</b><small>The selected workspace environment.</small></span></button>
    <button type="button" class="mi plus top-item" aria-label="New item">+<span class="top-popover"><b>New</b><small>Add a file, folder, or pipeline item.</small></span></button>
    <div class="run-actions" role="group" aria-label="Pipeline actions">
      <button type="button" class="top-item" data-top-action="deploy">Deploy<span class="top-popover"><b>Deploy</b><small>Choose a tenant and send the approved pipeline.</small></span></button>
      <button type="button" class="top-item" data-top-action="run">Run<span class="top-popover"><b>Run</b><small>Execute the current pipeline with its parameters.</small></span></button>
    </div>
    <span class="spacer"></span>
  </div>

  <Rail />
  <Sidebar />
  <Editor />
  <Chat />
</div>

<style>
  .ide{
    --ide-menubar:#E5E5E5;
    --ide-rail:#F0F0F0;
    --ide-panel:#F5F6F8;
    --ide-editor:#FAFCFF;
    --ide-accent:#3376CD;
    --ide-active:#DDE6F3;
    --ide-selected:#D9E5FD;
    --ide-border:#E5E5E5;
    --ide-border-strong:#CDD4DE;
    --ide-hover:#ECEFF5;
    --ide-ink:#1B2331;
    --ide-ink-soft:#68707E;
    --ide-icon:#5A6270;
    --ide-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;

    display:grid;
    grid-template-columns:56px 300px minmax(0,1fr) 400px;
    grid-template-rows:auto minmax(0,1fr);
    grid-template-areas:
      "menu menu menu menu"
      "rail side ed   chat";
    height:100%; min-height:0; overflow:hidden;
    background:var(--ide-editor);
    font-family:"Figtree",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    color:var(--ide-ink);
    font-size:14px; line-height:1.55;
  }

  .menubar{
    grid-area:menu; display:flex; align-items:center; gap:4px;
    background:var(--ide-menubar); border-bottom:1px solid #D8D8D8;
    position:relative;z-index:60;padding:6px 10px; font-size:13px; overflow:visible;
  }
  .mi{border:0;background:transparent;padding:5px 9px;border-radius:5px;color:var(--ide-ink);font:inherit;white-space:nowrap;cursor:pointer;}
  .mi.plus{color:var(--ide-ink-soft);font-size:16px;padding:2px 8px;}
  .chipbtn{
    display:inline-flex;align-items:center;gap:6px;background:var(--ide-editor);
    border:1px solid #D2D2D2;border-radius:6px;padding:4px 10px;white-space:nowrap;font-size:12.5px;
  }
  .cv{color:var(--ide-ink-soft);font-size:11px;}
  .run-actions{display:flex;align-items:center;gap:5px;}
  .run-actions button{border:1px solid #C5D7EF;background:var(--ide-editor);border-radius:5px;padding:4px 10px;font:inherit;font-size:11.5px;font-weight:700;color:var(--ide-accent);cursor:pointer;}
  .run-actions button:hover,.run-actions button[aria-current="true"]{background:var(--ide-accent);border-color:var(--ide-accent);color:#fff;}
  .run-actions button:focus-visible{outline:2px solid var(--ide-ink);outline-offset:2px;}
  .spacer{flex:1;}
  .top-item{position:relative;}
  .top-popover{display:none;position:absolute;z-index:30;top:calc(100% + 8px);left:0;width:13.5rem;border:1px solid #B9C7D9;border-radius:7px;background:#fff;padding:.55rem .65rem;box-shadow:0 12px 28px rgba(0,33,99,.18);color:var(--ide-ink);text-align:left;white-space:normal;}
  .top-popover b{display:block;font-size:11.5px;}.top-popover small{display:block;margin-top:2px;color:var(--ide-ink-soft);font-size:10.5px;line-height:1.35;}
  .top-item:hover .top-popover,.top-item:focus-visible .top-popover{display:block;}

  /* ---- focus: the pane holding the action stays bright, the rest recede ---- */
  .ide :global(.side),.ide :global(.ed),.ide :global(.chat){
    transition:opacity 220ms ease-out, filter 220ms ease-out;
  }
  .ide :global(.dim){opacity:.38;filter:saturate(.5);}
  .ide :global(.sdlc-row){transition:opacity 200ms ease-out;}
  .ide :global(.sdlc-row.faded){opacity:.42;}

  /* the one control worth looking at */
  .ide :global(.is-target){
    position:relative;
    box-shadow:0 0 0 3px rgba(51,118,205,.55), 0 0 0 8px rgba(51,118,205,.18);
    border-radius:8px;
  }
  @media (prefers-reduced-motion: no-preference){
    .ide :global(.is-target){animation:coachPulse 2.4s ease-in-out infinite;}
    @keyframes coachPulse{
      0%,100%{box-shadow:0 0 0 3px rgba(51,118,205,.55), 0 0 0 8px rgba(51,118,205,.16);}
      50%    {box-shadow:0 0 0 3px rgba(51,118,205,.75), 0 0 0 13px rgba(51,118,205,.05);}
    }
  }
  @media (prefers-reduced-motion: reduce){
    .ide :global(.side),.ide :global(.ed),.ide :global(.chat),.ide :global(.sdlc-row){transition:none;}
  }

  /* done markers in the step list */
  .ide :global(.sdlc-row.done .sdlc-n){background:#1E7A55;color:#fff;font-size:11px;}
  .ide :global(.sdlc-row.done .sdlc-t){color:var(--ide-ink-soft);}
  @media (prefers-reduced-motion: no-preference){
    .ide.step-change :global(.side){animation:paneArrive .34s ease-out both;}
    .ide.step-change :global(.ed-bar){animation:paneArrive .38s ease-out both;}
    .ide.step-change :global(.chat){animation:paneArrive .42s ease-out both;}
    @keyframes paneArrive{from{opacity:.55;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
  }

  @media (max-width:1020px){
    .ide{grid-template-columns:48px 220px minmax(0,1fr) minmax(250px,.8fr);}
    .menubar .chipbtn{max-width:9rem;overflow:hidden;text-overflow:ellipsis;}
  }
  @media (max-width:820px){
    .ide{grid-template-columns:minmax(0,1fr) minmax(235px,.82fr);grid-template-areas:"menu menu" "ed chat";}
    .ide :global(.rail){display:none;}
    .ide :global(.side){display:none;}
    .menubar .mi:not(.plus){display:none;}
    .menubar .chipbtn:first-of-type{display:none;}
    .menubar{gap:2px;}
  }
</style>

<script>
  import { steps } from '../../data/ide';

  const ide = document.querySelector<HTMLElement>('[data-ide]');
  if (ide) {
    const q  = <T extends Element>(sel: string, r: ParentNode = ide) => r.querySelector<T>(sel);
    const qa = <T extends Element>(sel: string, r: ParentNode = ide) => Array.from(r.querySelectorAll<T>(sel));

    const sdlcRows = qa<HTMLButtonElement>('[data-goto]');
    const fileBtns = qa<HTMLButtonElement>('[data-file]');
    const tabBtns  = qa<HTMLButtonElement>('[data-tab]');
    const tabBar   = q<HTMLElement>('[data-tabs]');
    const views    = qa<HTMLElement>('.view');
    const turnsets = qa<HTMLElement>('[data-turns]');
    const toolbarEl= q<HTMLElement>('[data-toolbar]');
    const agentLbl = q<HTMLElement>('[data-agent-label]');
    const agentBtn = q<HTMLButtonElement>('[data-agent-btn]');
    const picker   = q<HTMLElement>('[data-picker]');
    const thread   = q<HTMLElement>('[data-thread]');
    const pendingTurn = q<HTMLElement>('[data-pending-turn]');
    const pendingMessage = q<HTMLElement>('[data-pending-message]');
    const ask      = q<HTMLTextAreaElement>('[data-ask]');
    const send     = q<HTMLButtonElement>('[data-send]');
    const typing   = q<HTMLElement>('[data-typing]');
    const deployPanel = q<HTMLElement>('[data-deploy-panel]');
    const deployClose = q<HTMLButtonElement>('[data-deploy-close]');
    const explorer = q<HTMLElement>('[data-explorer]');
    const explorerToggle = q<HTMLButtonElement>('[data-explorer-toggle]');
    const panes    = { side: q<HTMLElement>('.side'), ed: q<HTMLElement>('.ed'), chat: q<HTMLElement>('.chat') };
    const topActions = qa<HTMLButtonElement>('[data-top-action]');

    // The guide bar lives outside the IDE frame — it is demo navigation, not product UI.
    const bar      = document.querySelector<HTMLElement>('[data-guide]');
    const gCount   = document.querySelector<HTMLElement>('[data-g-count]');
    const gTitle   = document.querySelector<HTMLElement>('[data-g-title]');
    const gPrev    = document.querySelector<HTMLButtonElement>('[data-g-prev]');
    const gNext    = document.querySelector<HTMLButtonElement>('[data-g-next]');
    const gDots    = document.querySelector<HTMLElement>('[data-g-dots]');
    const callout  = document.querySelector<HTMLElement>('[data-callout]');
    const calloutCount = document.querySelector<HTMLElement>('[data-callout-count]');
    const calloutTitle = document.querySelector<HTMLElement>('[data-callout-title]');
    const calloutText = document.querySelector<HTMLElement>('[data-callout-text]');

    let cur = 1;
    let openFile: string | null = null;
    let uploadPlaying = false;
    let deployOpen = false;
    let exploreMode = false;
    let calloutTarget: HTMLElement | null = null;

    const step = () => steps[cur - 1];
    const promptFor = (candidate = step()) => candidate.chat.find((message) => message.from === 'you')?.text ?? null;

    /* The cutoff typed at step 8 turns up in the run log at step 9. The value flows
       forward — the product thesis, in miniature. */
    const logTemplate = q<HTMLElement>('[data-log]')?.textContent ?? '';
    const cutoffInput = q<HTMLInputElement>('[data-param="dateOfBirthCutoff"]');
    function applyCutoff() {
      const logEl = q<HTMLElement>('[data-log]');
      const val = (cutoffInput?.value || '').trim() || '2000-01-01';
      if (logEl) logEl.textContent = logTemplate.replace('{{CUTOFF}}', val);
    }
    cutoffInput?.addEventListener('input', applyCutoff);

    const viewFor = (file: string | null, fallback: string) =>
      !file ? fallback : file === 'pipeline' ? 'pipeline' : `doc:${file}`;

    function positionCallout() {
      if (!callout || !calloutTarget || callout.hidden) return;
      const target = calloutTarget.getBoundingClientRect();
      const bubble = callout.getBoundingClientRect();
      const inset = 14;
      const gap = 18;
      const room = {
        top: target.top,
        right: window.innerWidth - target.right,
        bottom: window.innerHeight - target.bottom,
        left: target.left,
      };
      let side: 'top' | 'right' | 'bottom' | 'left';
      if (room.right >= bubble.width + gap && target.left < window.innerWidth * .62) side = 'right';
      else if (room.left >= bubble.width + gap) side = 'left';
      else if (room.top >= bubble.height + gap) side = 'top';
      else side = 'bottom';

      let left = target.left + target.width / 2 - bubble.width / 2;
      let top = target.top + target.height / 2 - bubble.height / 2;
      if (side === 'right') left = target.right + gap;
      if (side === 'left') left = target.left - bubble.width - gap;
      if (side === 'top') top = target.top - bubble.height - gap;
      if (side === 'bottom') top = target.bottom + gap;

      left = Math.max(inset, Math.min(left, window.innerWidth - bubble.width - inset));
      top = Math.max(inset, Math.min(top, window.innerHeight - bubble.height - inset));
      callout.dataset.side = side;
      callout.style.left = `${left}px`;
      callout.style.top = `${top}px`;
      callout.style.setProperty('--callout-arrow-y', `${Math.max(22, Math.min(target.top + target.height / 2 - top, bubble.height - 22))}px`);
      callout.style.setProperty('--callout-arrow-x', `${Math.max(22, Math.min(target.left + target.width / 2 - left, bubble.width - 22))}px`);
    }

    function updateCallout(target: HTMLElement | null, s = step()) {
      calloutTarget = target;
      if (!callout) return;
      if (exploreMode || !target) {
        callout.hidden = true;
        return;
      }
      if (calloutCount) calloutCount.textContent = `Step ${cur} of ${steps.length}`;
      if (calloutTitle) calloutTitle.textContent = s.title;
      if (calloutText) calloutText.textContent = s.instruct;
      callout.hidden = false;
      window.requestAnimationFrame(positionCallout);
    }

    function render() {
      const s = step();

      // step list: done gets a check, everything but the current one recedes
      sdlcRows.forEach((r) => {
        const n = Number(r.dataset.goto);
        const done = n < cur;
        r.setAttribute('aria-current', String(n === cur));
        r.classList.toggle('done', done);
        r.classList.toggle('faded', n !== cur);
        r.classList.remove('is-next');
        const numEl = r.querySelector<HTMLElement>('.sdlc-n');
        if (numEl) numEl.textContent = done ? '✓' : String(n);
      });

      fileBtns.forEach((b) => {
        b.hidden = !s.files.includes(b.dataset.file!);
        b.setAttribute('aria-current', String(b.dataset.file === openFile));
        b.classList.toggle('file-arrived', cur === 1 && b.dataset.file === 'requirement');
      });
      tabBtns.forEach((t) => {
        t.hidden = t.dataset.tab !== openFile;
        t.setAttribute('aria-current', String(t.dataset.tab === openFile));
      });
      if (tabBar) tabBar.hidden = openFile === null;

      views.forEach((v) => {
        const active = v.dataset.view === viewFor(openFile, s.view);
        v.hidden = !active;
        if (active) {
          v.classList.remove('step-enter');
          void v.offsetWidth;
          v.classList.add('step-enter');
        }
      });

      if (agentLbl) agentLbl.textContent = s.agent;
      qa<HTMLInputElement>('input[name="agent"]').forEach((i) => { i.checked = i.value === s.agent; });

      if (toolbarEl) {
        toolbarEl.innerHTML = '';
        (s.toolbar ?? []).forEach((b) => {
          const el = document.createElement('button');
          el.type = 'button';
          el.className = 'tb-btn' + (b.kind === 'primary' ? ' primary' : '');
          el.dataset.toolbarAction = b.action;
          el.textContent = b.label;
          el.addEventListener('click', next);
          toolbarEl.appendChild(el);
        });
      }

      const draft = promptFor(s);
      if (ask) {
        ask.value = draft ?? '';
        ask.readOnly = Boolean(draft);
        ask.placeholder = draft ? '' : 'Ask anything';
      }
      turnsets.forEach((t) => {
        const turn = Number(t.dataset.turns);
        const turnHasDraft = Boolean(promptFor(steps[turn - 1]));
        t.hidden = turn > cur || (turn === cur && turnHasDraft);
      });
      if (pendingTurn) pendingTurn.hidden = true;
      if (typing) typing.hidden = true;
      if (deployPanel) deployPanel.hidden = !deployOpen;
      applyCutoff();
      if (thread) thread.scrollTop = thread.scrollHeight;

      // dim every pane except the one holding the action
      Object.entries(panes).forEach(([k, el]) => el?.classList.toggle('dim', !exploreMode && (cur === 1 ? k === 'chat' : k !== s.focus)));

      // ring the one control worth looking at
      qa<HTMLElement>('.is-target').forEach((e) => e.classList.remove('is-target'));
      const target = !exploreMode ? (q<HTMLElement>(s.ring) ?? document.querySelector<HTMLElement>(s.ring)) : null;
      target?.classList.add('is-target');
      updateCallout(target, s);

      // guide bar
      if (gCount) gCount.textContent = exploreMode ? 'Workspace tour' : `Step ${cur} of ${steps.length}`;
      if (gTitle) gTitle.textContent = exploreMode ? 'Explore Akaden' : s.title;
      if (gPrev)  gPrev.disabled = cur === 1;
      if (gNext) { gNext.textContent = exploreMode ? 'Explore the workspace' : s.nextLabel; gNext.disabled = exploreMode; }
      if (bar) bar.dataset.step = String(cur);
      topActions.forEach((button) => {
        const action = button.dataset.topAction;
        const current = action === 'deploy' ? cur >= 6 && cur < 8 : cur === 8;
        button.setAttribute('aria-current', String(current));
      });
      ide!.dataset.step = String(cur);
      ide!.dataset.explore = String(exploreMode);
      ide!.classList.remove('step-change');
      void ide!.offsetWidth;
      ide!.classList.add('step-change');
      qa<HTMLElement>('[data-dot]', gDots ?? document).forEach((d) => {
        const n = Number(d.dataset.dot);
        d.classList.toggle('on', n === cur);
        d.classList.toggle('past', n < cur);
        d.setAttribute('aria-current', String(n === cur));
      });
    }

    function go(n: number) {
      const nextStep = Math.min(Math.max(n, 1), steps.length);
      if (nextStep !== 6) deployOpen = false;
      exploreMode = false;
      cur = nextStep;
      openFile = step().open;
      if (openFile && !step().files.includes(openFile)) openFile = null;
      render();
    }
    function openDeploy() {
      deployOpen = true;
      go(6);
    }
    function next() {
      if (exploreMode) return;
      if (cur === 1 && !uploadPlaying) {
        uploadPlaying = true;
        const uploadView = q<HTMLElement>('[data-view="empty"]');
        const requestFile = q<HTMLButtonElement>('[data-file="requirement"]');
        const source = q<HTMLElement>('[data-upload-source]');
        const destination = q<HTMLElement>('[data-folder="inputs"] .folder-row');
        uploadView?.classList.add('is-uploading');
        if (source && destination) {
          const sourceBox = source.getBoundingClientRect();
          const destinationBox = destination.getBoundingClientRect();
          const flying = source.cloneNode(true) as HTMLElement;
          flying.classList.add('upload-flying');
          flying.removeAttribute('data-upload-source');
          flying.style.left = `${sourceBox.left}px`;
          flying.style.top = `${sourceBox.top}px`;
          flying.style.width = `${sourceBox.width}px`;
          flying.style.height = `${sourceBox.height}px`;
          document.body.appendChild(flying);
          destination.classList.add('upload-target');
          const dx = destinationBox.left + destinationBox.width / 2 - (sourceBox.left + sourceBox.width / 2);
          const dy = destinationBox.top + destinationBox.height / 2 - (sourceBox.top + sourceBox.height / 2);
          flying.animate([
            { transform: 'translate(0, 0) scale(1)', opacity: 1 },
            { transform: `translate(${dx}px, ${dy}px) scale(.2)`, opacity: .55 },
          ], { duration: 900, easing: 'cubic-bezier(.2,.78,.25,1)', fill: 'forwards' });
          window.setTimeout(() => {
            flying.remove();
            destination.classList.remove('upload-target');
          }, 930);
        }
        if (requestFile) {
          requestFile.hidden = false;
          requestFile.classList.remove('file-arrived');
          void requestFile.offsetWidth;
          requestFile.classList.add('file-arrived');
        }
        if (gNext) gNext.disabled = true;
        window.setTimeout(() => {
          uploadView?.classList.remove('is-uploading');
          uploadPlaying = false;
          if (gNext) gNext.disabled = false;
          go(2);
        }, 1060);
        return;
      }
      if (promptFor()) {
        const currentChat = panes.chat;
        const prompt = promptFor();
        // Once the message leaves the composer, its coaching cue has done its job.
        // Keep the response animation clear, then introduce the next cue with the next step.
        updateCallout(null);
        if (ask) ask.value = '';
        if (pendingMessage) pendingMessage.textContent = prompt ?? '';
        if (pendingTurn) pendingTurn.hidden = false;
        if (typing) typing.hidden = false;
        if (thread) thread.scrollTop = thread.scrollHeight;
        if (currentChat) currentChat.dataset.sending = 'true';
        if (gNext) gNext.disabled = true;
        if (send) send.disabled = true;
        window.setTimeout(() => {
          if (typing) typing.hidden = true;
          if (currentChat) delete currentChat.dataset.sending;
          if (gNext) gNext.disabled = false;
          if (send) send.disabled = false;
          go(cur + 1);
        }, 820);
        return;
      }
      if (step().id === 'refine') {
        openDeploy();
        return;
      }
      if (cur === steps.length) {
        exploreMode = true;
        render();
        return;
      }
      go(cur + 1);
    }
    function prev() { go(cur - 1); }

    gNext?.addEventListener('click', next);
    send?.addEventListener('click', next);
    gPrev?.addEventListener('click', prev);
    sdlcRows.forEach((r) => r.addEventListener('click', () => go(Number(r.dataset.goto))));
    fileBtns.forEach((b) => b.addEventListener('click', () => { openFile = b.dataset.file!; render(); }));
    tabBtns.forEach((t) => t.addEventListener('click', () => { openFile = t.dataset.tab!; render(); }));
    q<HTMLButtonElement>('[data-openreq]')?.addEventListener('click', () => { openFile = 'requirement'; render(); });
    qa<HTMLElement>('[data-dot]', gDots ?? document).forEach((d) =>
      d.addEventListener('click', () => go(Number(d.dataset.dot))));

    agentBtn?.addEventListener('click', () => {
      const open = picker?.hidden === false;
      if (picker) picker.hidden = open;
      agentBtn.setAttribute('aria-expanded', String(!open));
    });
    qa<HTMLInputElement>('input[name="agent"]').forEach((i) =>
      i.addEventListener('change', () => {
        if (agentLbl) agentLbl.textContent = i.value;
        if (picker) picker.hidden = true;
        agentBtn?.setAttribute('aria-expanded', 'false');
      }));
    document.addEventListener('click', (e) => {
      if (!picker || picker.hidden) return;
      const t = e.target as Node;
      if (!picker.contains(t) && !agentBtn?.contains(t)) {
        picker.hidden = true;
        agentBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    topActions.forEach((button) =>
      button.addEventListener('click', () => button.dataset.topAction === 'deploy' ? openDeploy() : go(8)));
    deployClose?.addEventListener('click', () => { deployOpen = false; if (deployPanel) deployPanel.hidden = true; });
    explorerToggle?.addEventListener('click', () => {
      const fileMode = explorer?.dataset.explorerMode === 'files';
      if (explorer) explorer.dataset.explorerMode = fileMode ? 'folders' : 'files';
      explorerToggle.setAttribute('aria-label', fileMode ? 'Switch to file view' : 'Switch to folder view');
    });

    document.querySelector('[data-reset]')?.addEventListener('click', () => go(1));

    // arrow keys move through the walkthrough
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); prev(); }
    });
    window.addEventListener('resize', () => window.requestAnimationFrame(positionCallout));

    go(1);
  }
</script>
