---
const icons = [
  { id: 'files', label: 'Explorer', description: 'Browse files, folders, specifications, and pipelines.', d: 'M3 6h6l2 2h10v11H3z' },
  { id: 'search', label: 'Search', description: 'Find an artifact or text across this workspace.', d: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.5-4.5' },
  { id: 'secrets', label: 'Secrets', description: 'Manage the protected credentials used by integrations.', d: 'M7 11V8a5 5 0 0 1 10 0v3M5 11h14v9H5z' },
  { id: 'api', label: 'Ethos / Colleague API', description: 'Connect to approved Ethos and Colleague endpoints.', text: 'API' },
  { id: 'skills', label: 'Spec APIs', description: 'Define the APIs and reusable rules in your specification.', d: 'M12 3v5a4 4 0 0 1-4 4H5a3 3 0 1 0 0 6h3a4 4 0 0 1 4 4v5M12 3v5a4 4 0 0 0 4 4h3a3 3 0 1 1 0 6h-3a4 4 0 0 0-4 4v5' },
  { id: 'deploy', label: 'Ellucian DataConnect', description: 'Deploy and operate pipelines in Integration Designer.', d: 'M6 15a4 4 0 0 1 .8-7.9 5.5 5.5 0 0 1 10.6 1.4A3.5 3.5 0 0 1 17 15zM5 19h14M12 15v4M9 19a1 1 0 1 0 0 .01M15 19a1 1 0 1 0 0 .01' },
  { id: 'data', label: 'Database', description: 'Inspect the data sources and records this work uses.', d: 'M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6' },
  { id: 'git', label: 'Source control', description: 'Track the files and decisions that define this pipeline.', d: 'M7 4v10M7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM7 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 8v2a4 4 0 0 1-4 4H7' },
];
---
<nav class="rail" aria-label="Workbench">
  <ul>
    {icons.map((i) => (
      <li>
        <button type="button" class="rail-btn" data-rail-tool title={i.label} aria-label={i.label} aria-expanded="false">
          {i.text
            ? <span class="rail-text">{i.text}</span>
            : <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={i.d} /></svg>}
          <span class="rail-popover"><b>{i.label}</b><small>{i.description}</small></span>
        </button>
      </li>
    ))}
  </ul>
  <button type="button" class="rail-btn" data-rail-tool title="Settings" aria-label="Settings" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M19.43 12.98c.04-.32.07-.65.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46a.5.5 0 0 0-.6-.22l-2.49 1a7.4 7.4 0 0 0-1.69-.98l-.38-2.65A.5.5 0 0 0 14 2h-4a.5.5 0 0 0-.5.42l-.38 2.65c-.61.25-1.17.58-1.69.98l-2.49-1a.5.5 0 0 0-.6.22l-2 3.46a.5.5 0 0 0 .12.64l2.11 1.65a7.23 7.23 0 0 0 0 1.96l-2.11 1.65a.5.5 0 0 0-.12.64l2 3.46a.5.5 0 0 0 .6.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.04.24.25.42.5.42h4c.25 0 .46-.18.5-.42l.38-2.65c.61-.25 1.17-.58 1.69-.98l2.49 1a.5.5 0 0 0 .6-.22l2-3.46a.5.5 0 0 0-.12-.64l-2.11-1.65ZM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Z" />
    </svg>
    <span class="rail-popover"><b>Settings</b><small>Configure this workspace and your preferences.</small></span>
  </button>
</nav>

<style>
  .rail{
    grid-area:rail; background:var(--ide-rail); border-right:1px solid var(--ide-border);
    display:flex; flex-direction:column; align-items:center; justify-content:space-between;
    position:relative;z-index:40;padding:10px 0 24px;gap:8px;overflow:visible;
  }
  .rail ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px;align-items:center;}
  .rail-btn{
    width:38px;height:38px;border:0;background:transparent;border-radius:7px;
    display:flex;align-items:center;justify-content:center;
    position:relative;color:var(--ide-icon);cursor:pointer;transition:background-color 120ms,color 120ms;
  }
  .rail-btn:hover{background:var(--ide-hover);color:var(--ide-ink);}
  .rail-text{font-family:var(--ide-mono);font-size:11px;font-weight:700;letter-spacing:.02em;}
  .rail-btn:focus-visible{outline:2px solid var(--ide-accent);outline-offset:-2px;}
  .rail-popover{display:none;position:absolute;z-index:45;left:calc(100% + 8px);top:0;width:13rem;border:1px solid #B9C7D9;border-radius:7px;background:#fff;padding:.55rem .65rem;box-shadow:0 12px 28px rgba(0,33,99,.18);color:var(--ide-ink);text-align:left;white-space:normal;}
  .rail-popover b{display:block;font-size:11.5px;}.rail-popover small{display:block;margin-top:2px;color:var(--ide-ink-soft);font-size:10.5px;line-height:1.35;}
  .rail-btn:hover .rail-popover,.rail-btn:focus-visible .rail-popover,.rail-btn.open .rail-popover{display:block;}
</style>

<script>
  const railTools = document.querySelectorAll<HTMLButtonElement>('[data-rail-tool]');
  railTools.forEach((tool) => tool.addEventListener('click', () => {
    const willOpen = !tool.classList.contains('open');
    railTools.forEach((item) => { item.classList.remove('open'); item.setAttribute('aria-expanded', 'false'); });
    if (willOpen) { tool.classList.add('open'); tool.setAttribute('aria-expanded', 'true'); }
  }));
  railTools.forEach((tool) => tool.addEventListener('pointerleave', () => {
    tool.classList.remove('open');
    tool.setAttribute('aria-expanded', 'false');
  }));
</script>
