---
import { marked } from 'marked';
import { FILES, jobParams, runLog, outputCsv, acceptance } from '../../data/ide';

import requirementRaw from '../../data/demo/01-requirement.md?raw';
import specRaw from '../../data/demo/02-specification.md?raw';
import readmeRaw from '../../data/demo/03-pipeline-readme.md?raw';
import pipelineRaw from '../../data/demo/04-alumni-contact-export.pipeline?raw';

marked.setOptions({ gfm: true, breaks: false });
const docs: Record<string, string> = {
  requirement: await marked.parse(requirementRaw),
  spec: await marked.parse(specRaw),
  readme: await marked.parse(readmeRaw),
};

const pipeline = JSON.parse(pipelineRaw) as {
  name: string;
  pipeline: string[];
  segments: Record<string, { class: string; description?: string }>;
};
const CLASS_LABEL: Record<string, string> = {
  JavaScriptTransform: 'JS transform',
  ethosProxyGetFilter: 'Ethos API',
  SubPipeline: 'Sub-pipeline',
  forEach: 'Loop',
  reducer: 'Reducer',
};
const pipelineIcon = (kind?: string) =>
  kind === 'JavaScriptTransform' ? '</>'
    : kind === 'ethosProxyGetFilter' ? '☁'
      : kind === 'SubPipeline' ? '↗'
        : kind === 'forEach' ? '↻'
          : kind === 'reducer' ? '∑'
            : '•';
const pipelineDetail = (name: string, kind?: string) => {
  if (kind === 'ethosProxyGetFilter') return `GET /${name.replace(/^GET\s*-\s*/i, '').split(' ')[0].toLowerCase()}\nFilters the required student records through Ethos.`;
  if (kind === 'JavaScriptTransform') return `JavaScript transform\nNormalizes the contact record and applies the approved mapping rules.`;
  if (kind === 'SubPipeline') return `Calls a reusable sub-pipeline\nPasses this record into the shared mapping flow.`;
  if (kind === 'forEach') return `for each record\nRuns the next steps once for every matching student.`;
  if (kind === 'reducer') return `Collect output rows\nBuilds the final CSV ready for delivery.`;
  return 'Generated from the approved specification.';
};
---
<main class="ed" aria-label="Editor">
  <div class="tabs" data-tabs hidden>
    {Object.entries(FILES).map(([key, v]) => (
      <button type="button" class="tab" data-tab={key} hidden>
        <span class:list={['ficon', v.kind]} aria-hidden="true">{v.kind === 'pipeline' ? 'S' : 'TXT'}</span>
        {v.name}
      </button>
    ))}
  </div>

  <div class="editor-toolbar" data-toolbar aria-label="Editor actions"></div>

  <div class="ed-body">
    <!-- step 1: the incoming request visibly lands in inputs/ -->
    <div class="view drop-stage" data-view="empty">
      <div class="stage-in">
        <p class="from">From campus communications</p>
        <div class="dragcard" data-upload-source aria-describedby="dragcard-hint">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M6 2h8l4 4v16H6z"/><path d="M14 2v4h4"/><path d="M9 12h6M9 16h6" stroke-linecap="round"/>
          </svg>
          <span class="dc-name">contact-request.md</span>
          <span class="dc-sub" id="dragcard-hint">Ready to upload to <b>inputs</b></span>
        </div>
      </div>
      <svg class="mark" viewBox="0 0 200 200" aria-hidden="true">
        <rect x="10" y="10" width="180" height="180" rx="44" fill="#DBDCDE"/>
        <path d="M74 92a24 24 0 0 1 4.8-47.5A33 33 0 0 1 142 53a21 21 0 0 1-2 39z" fill="#FAFCFF"/>
        <rect x="76" y="112" width="12" height="20" rx="6" fill="#FAFCFF"/>
        <rect x="96" y="112" width="12" height="30" rx="6" fill="#FAFCFF"/>
        <rect x="116" y="112" width="12" height="20" rx="6" fill="#FAFCFF"/>
      </svg>
    </div>

    <!-- documents -->
    {Object.entries(docs).map(([key, html]) => (
      <div class="view doc" data-view={`doc:${key}`} hidden><article set:html={html} /></div>
    ))}

    <!-- pipeline -->
    <div class="view" data-view="pipeline" hidden>
      <div class="pl">
        <header class="pl-head">
          <h2>{pipeline.name}</h2>
          <p>{pipeline.pipeline.length} generated steps from the approved specification</p>
        </header>
        <ol class="pl-canvas" data-pipeline-canvas>
          {pipeline.pipeline.map((seg, i) => {
            const def = pipeline.segments[seg];
            const detail = pipelineDetail(seg, def?.class);
            return (
              <li data-segment data-segment-index={i}>
                <button type="button" class="segment-drag" data-segment-handle draggable="true" aria-label={`Drag ${seg}`}>⠿</button>
                <article class:list={['segment-card', def?.class]} data-segment-card tabindex="0" aria-expanded="false">
                  <span class="segment-icon" aria-hidden="true">{pipelineIcon(def?.class)}</span>
                  <div class="segment-copy">
                    <h3>{seg}</h3>
                    <p class="segment-kind">{CLASS_LABEL[def?.class ?? ''] ?? def?.class}</p>
                    <div class="segment-detail">
                      <p>{def?.description ?? 'Generated pipeline step'}</p>
                      <code>{detail}</code>
                    </div>
                  </div>
                  <div class="segment-actions">
                    <button
                      type="button"
                      class="segment-menu-toggle"
                      data-segment-menu-toggle
                      aria-label={`Actions for ${seg}`}
                      aria-expanded="false"
                      aria-controls={`segment-menu-${i}`}
                    >⋮</button>
                    <div id={`segment-menu-${i}`} class="segment-menu" data-segment-menu role="menu" hidden>
                      <button type="button" role="menuitem" data-segment-action="disable">Disable</button>
                      <button type="button" role="menuitem" data-segment-action="disable-below">Disable current and all below</button>
                      <button type="button" role="menuitem" data-segment-action="copy">Copy</button>
                      <hr />
                      <button type="button" role="menuitem" class="delete-action" data-segment-action="delete">Delete</button>
                    </div>
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </div>

    <!-- job parameters -->
    <div class="view" data-view="params" hidden>
      <div class="form">
        <h2>Job parameters</h2>
        <p class="form-note">Read from the pipeline. <b>Date of Birth Cutoff</b> is the value your specification set.</p>
        {jobParams.map((p) => (
          <label class="field">
            <span class="fl">{p.label}{p.required && <b class="req">required</b>}{p.fromSpec && <b class="spec">from the spec</b>}</span>
            {p.type === 'select'
              ? <select name={p.name}>{p.options!.map((o) => <option selected={o === p.value}>{o}</option>)}</select>
              : <input type="text" name={p.name} value={p.value} data-param={p.name} />}
          </label>
        ))}
      </div>
    </div>

    <!-- run + validate -->
    <div class="view" data-view="run" hidden>
      <div class="run">
        <h2>Job run</h2>
        <pre class="log" data-log>{runLog.join('\n')}</pre>

        <h3>output.csv</h3>
        <div class="tw">
          <table>
            <thead><tr>{outputCsv.header.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>{outputCsv.rows.map((r) => <tr>{r.map((c) => <td>{c || <span class="empty">—</span>}</td>)}</tr>)}</tbody>
          </table>
        </div>
        <p class="synth">Synthetic records. Nothing on this page resembles real student data.</p>

        <h3>Acceptance criteria</h3>
        <ul class="acc">{acceptance.map((a) => <li><span class="tick" aria-hidden="true">✓</span>{a}</li>)}</ul>
      </div>
    </div>

  </div>

  <section class="deploy-drawer" data-deploy-panel hidden aria-label="Deploy pipeline">
      <header class="deploy-head">
        <div class="deploy-tabs" role="tablist" aria-label="Deployment panels">
          <button type="button" role="tab" aria-selected="true">↥&nbsp; Deploy</button>
          <button type="button" role="tab" aria-selected="false">▷&nbsp; Run</button>
          <button type="button" role="tab" aria-selected="false">Results</button>
        </div>
        <div class="deploy-title"><span aria-hidden="true">↥</span> Deploy</div>
        <div class="deploy-window-actions">
          <button type="button" aria-label="Open deploy panel in a new window">▣</button>
          <button type="button" aria-label="Collapse deploy panel">⌃</button>
          <button type="button" data-deploy-close aria-label="Close deploy panel">×</button>
        </div>
      </header>
      <div class="deploy-fields">
        <label class="deploy-field"><span>Tenant</span><select aria-label="Tenant"><option>Northstar University demo</option></select></label>
        <label class="deploy-field"><span>Package</span><select aria-label="Package"><option>demo-package</option></select></label>
        <label class="deploy-field"><span>Pipeline name</span><input type="text" value="contact-export" aria-label="Pipeline name" /></label>
      </div>
  </section>
</main>

<style>
  .ed{grid-area:ed;position:relative;background:var(--ide-editor);display:flex;flex-direction:column;min-width:0;min-height:0;border-right:1px solid var(--ide-border);}

  .tabs{display:flex;gap:0;background:var(--ide-panel);border-bottom:1px solid var(--ide-border);overflow-x:auto;}
  .tab{
    display:flex;align-items:center;gap:7px;padding:8px 14px;border:0;border-right:1px solid var(--ide-border);
    background:var(--ide-panel);color:var(--ide-ink-soft);font:inherit;font-size:12.5px;cursor:pointer;white-space:nowrap;
  }
  .tab[aria-current="true"]{background:var(--ide-editor);color:var(--ide-ink);}
  .ficon{font-size:7px;font-weight:700;font-family:var(--ide-mono);border:1px solid currentColor;border-radius:2px;padding:1px 2px;color:#5B8DD6;}
  .ficon.pipeline{color:#C0392B;}

  .editor-toolbar{display:flex;align-items:center;justify-content:flex-end;gap:8px;min-height:43px;padding:6px 14px;background:#F5F8FC;border-bottom:1px solid var(--ide-border);}
  .editor-toolbar:empty{display:none;}
  .tb-btn{height:30px;border:1px solid var(--ide-border-strong);border-radius:6px;background:var(--ide-editor);padding:0 11px;color:var(--ide-ink);font:inherit;font-size:12px;font-weight:600;cursor:pointer;}
  .tb-btn:hover{border-color:var(--ide-ink-soft);}.tb-btn:focus-visible{outline:2px solid var(--ide-accent);outline-offset:2px;}
  .tb-btn.primary{border-color:var(--ide-accent);background:var(--ide-accent);color:#fff;}
  .tb-btn.primary:hover{background:#2866B5;border-color:#2866B5;}

  .ed-body{flex:1;min-height:0;overflow:hidden;position:relative;}
  .view{position:absolute;inset:0;overflow-y:auto;}
  .view[hidden]{display:none;}
  .deploy-drawer{position:absolute;z-index:9;right:0;bottom:0;left:0;height:15.4rem;border-top:1px solid #B8C7D9;background:#F1F3F6;box-shadow:0 -10px 24px rgba(0,33,99,.14);overflow:hidden;animation:deployDrawer .25s ease-out both;}
  .deploy-drawer[hidden]{display:none;}
  .deploy-head{display:flex;align-items:center;min-height:2.75rem;border-bottom:1px solid #C9CDD3;background:#E8EBF0;}
  .deploy-tabs{display:flex;align-self:stretch;}
  .deploy-tabs button{border:0;border-right:1px solid #C9CDD3;background:transparent;padding:0 1rem;color:#565C67;font:inherit;font-size:.82rem;cursor:pointer;}
  .deploy-tabs button[aria-selected="true"]{border-top:3px solid var(--ide-accent);background:#fff;color:var(--ide-ink);font-weight:600;}
  .deploy-title{margin-left:auto;color:#0879D6;font-size:.85rem;font-weight:600;white-space:nowrap;}
  .deploy-title span{font-size:1rem;vertical-align:-.1em;}
  .deploy-window-actions{display:flex;gap:.4rem;margin-left:1rem;padding-right:.8rem;}
  .deploy-window-actions button{border:0;background:transparent;color:#606774;font:inherit;font-size:1.25rem;line-height:1;cursor:pointer;}
  .deploy-fields{display:grid;grid-template-columns:minmax(0,1fr);gap:.55rem;padding:.7rem 1.1rem;}
  .deploy-field{display:grid;gap:.22rem;color:#555B64;font-size:.72rem;font-weight:600;}
  .deploy-field select,.deploy-field input{width:100%;height:2.25rem;border:1px solid #BFC4CC;border-radius:.48rem;background:#FAFCFF;padding:0 .65rem;color:var(--ide-ink);font:inherit;font-size:.78rem;}
  @keyframes deployDrawer{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
  [data-view="empty"]{display:flex;align-items:center;justify-content:center;position:absolute;}
  .mark{width:min(30%,190px);height:auto;opacity:.45;position:absolute;z-index:0;}
  /* the card is the subject at step 1 — the watermark stops competing with it */
  .drop-stage:has(.stage-in:not([hidden])) .mark{display:none;}
  .stage-in{position:relative;z-index:1;text-align:center;}
  .from{
    margin:0 0 12px;font-family:var(--ide-mono);font-size:10.5px;letter-spacing:.11em;
    text-transform:uppercase;color:var(--ide-ink-soft);
  }
  .dragcard{
    display:flex;flex-direction:column;align-items:center;gap:9px;
    padding:22px 26px;border:1px solid var(--ide-border-strong);border-radius:12px;
    background:var(--ide-editor);color:var(--ide-accent);font:inherit;
    box-shadow:0 1px 2px rgba(0,33,99,.06),0 10px 26px rgba(0,33,99,.10);
    transition:transform 140ms ease-out,box-shadow 140ms ease-out;
  }
  .dragcard:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(0,33,99,.08),0 16px 34px rgba(0,33,99,.14);}
  .dc-name{font-family:var(--ide-mono);font-size:12.5px;color:var(--ide-ink);}
  .dc-sub{font-size:12px;color:var(--ide-ink-soft);}
  .dc-sub b{color:var(--ide-ink);}
  .drop-stage.is-uploading .dragcard{opacity:.25;transform:scale(.95);}
  .upload-flying{position:fixed!important;z-index:100;pointer-events:none;box-sizing:border-box;box-shadow:0 14px 32px rgba(0,33,99,.24)!important;}
  @media (prefers-reduced-motion: reduce){
    .dragcard,.dragcard:hover{transition:none;transform:none;}
    .drop-stage.is-uploading .dragcard{opacity:1;transform:none;}
  }

  /* documents */
  .doc article{max-width:74ch;margin:0 auto;padding:34px 32px 80px;font-size:14.5px;line-height:1.7;color:var(--ide-ink);}
  .doc :global(h1){font-size:1.7rem;line-height:1.2;margin:0 0 18px;letter-spacing:-.02em;}
  .doc :global(h2){font-size:1.16rem;margin:32px 0 10px;letter-spacing:-.01em;}
  .doc :global(h3){font-size:1rem;margin:24px 0 8px;}
  .doc :global(p),.doc :global(li){color:#33415C;}
  .doc :global(ul),.doc :global(ol){padding-left:22px;}
  .doc :global(li){margin:5px 0;}
  .doc :global(code){font-family:var(--ide-mono);font-size:.86em;background:var(--ide-panel);border:1px solid var(--ide-border);border-radius:3px;padding:1px 4px;}
  .doc :global(pre){background:var(--ide-panel);border:1px solid var(--ide-border);border-radius:6px;padding:12px 14px;overflow-x:auto;}
  .doc :global(pre code){background:none;border:0;padding:0;font-size:12.5px;line-height:1.6;}
  .doc :global(table){border-collapse:collapse;width:100%;font-size:13px;display:block;overflow-x:auto;}
  .doc :global(th),.doc :global(td){border:1px solid var(--ide-border);padding:7px 10px;text-align:left;vertical-align:top;}
  .doc :global(th){background:var(--ide-panel);font-size:11.5px;text-transform:uppercase;letter-spacing:.05em;}
  .doc :global(hr){border:0;border-top:1px solid var(--ide-border);margin:28px 0;}
  .doc :global(blockquote){border-left:3px solid var(--ide-accent);margin:16px 0;padding-left:14px;color:#33415C;}

  /* pipeline */
  .pl{min-height:100%;padding:17px 24px 36px;background:#F8FAFD;}
  .pl-head h2{margin:0;font-size:1.1rem;letter-spacing:-.015em;}
  .pl-head p{margin:3px 0 0;font-size:11.5px;color:var(--ide-ink-soft);}
  .pl-canvas{list-style:none;margin:15px auto 0;max-width:900px;padding:0 0 20px;display:grid;gap:8px;}
  .pl-canvas > li{position:relative;display:grid;grid-template-columns:30px minmax(0,1fr);gap:9px;align-items:center;}
  .pl-canvas > li:not(:last-child)::after{content:"";position:absolute;left:39px;top:100%;height:8px;border-left:2px dashed #BFC9D8;}
  .segment-drag{display:grid;place-items:center;width:28px;height:32px;border:0;border-radius:6px;background:transparent;color:var(--ide-ink-soft);font-size:19px;letter-spacing:-.15em;cursor:grab;}
  .segment-drag:hover{background:var(--ide-hover);color:var(--ide-ink);}.segment-drag:active{cursor:grabbing;}.segment-drag:focus-visible{outline:2px solid var(--ide-accent);outline-offset:1px;}
  .segment-card{position:relative;display:grid;grid-template-columns:27px minmax(0,1fr) auto;gap:9px;align-items:start;min-width:0;padding:10px 48px 10px 12px;border:1px solid #AEB9C8;border-left:5px solid #C78900;border-radius:10px;background:#FFFBEF;box-shadow:0 4px 11px rgba(39,67,107,.08);cursor:pointer;transition:box-shadow 140ms,transform 140ms;}
  .segment-card:hover{box-shadow:0 6px 15px rgba(39,67,107,.13);transform:translateY(-1px);}.segment-card:focus-visible{outline:2px solid var(--ide-accent);outline-offset:2px;}
  .segment-card.ethosProxyGetFilter{border-left-color:#0782D7;background:#EEF7FF;}
  .segment-card.SubPipeline{border-left-color:#8E69C6;background:#F7F2FF;}
  .segment-card.forEach,.segment-card.reducer{border-left-color:#3C9C69;background:#F0FBF5;}
  .segment-icon{display:grid;place-items:center;width:27px;height:27px;border-radius:6px;background:#FFF5D8;color:#B77200;font-family:var(--ide-mono);font-size:11px;font-weight:700;}
  .ethosProxyGetFilter .segment-icon{background:#DFF0FF;color:#0076CC;font-size:18px;}
  .SubPipeline .segment-icon{background:#EFE2FF;color:#7752AE;font-size:17px;}
  .forEach .segment-icon,.reducer .segment-icon{background:#DDF4E5;color:#287451;font-size:18px;}
  .segment-copy{min-width:0;}
  .segment-copy h3{margin:0;color:#1B2331;font-size:.92rem;line-height:1.22;letter-spacing:-.01em;overflow-wrap:anywhere;}
  .segment-kind{margin:3px 0 0;color:#B77200;font-family:var(--ide-mono);font-size:.7rem;line-height:1.2;}
  .ethosProxyGetFilter .segment-kind{color:#0076CC;}.SubPipeline .segment-kind{color:#7752AE;}.forEach .segment-kind,.reducer .segment-kind{color:#287451;}
  .segment-detail{display:none;margin:9px 0 0;color:#4A5568;font-size:.78rem;line-height:1.35;}.segment-detail p{margin:0 0 7px;}.segment-detail code{display:block;white-space:pre-line;border:1px solid var(--ide-border);border-radius:6px;background:rgba(255,255,255,.66);padding:7px 8px;font-family:var(--ide-mono);font-size:.7rem;color:#33415C;}
  .segment-card[aria-expanded="true"] .segment-detail{display:block;animation:detailOpen .18s ease-out both;}
  .segment-actions{position:absolute;right:10px;top:9px;}
  .segment-menu-toggle{display:grid;place-items:center;width:29px;height:29px;border:1px solid #DCB56A;border-radius:8px;background:#FFF9EB;color:#9A6200;font-size:19px;line-height:1;cursor:pointer;}
  .segment-menu-toggle:hover,.segment-menu-toggle[aria-expanded="true"]{background:#FFF1C9;}
  .segment-menu-toggle:focus-visible{outline:2px solid var(--ide-accent);outline-offset:2px;}
  .segment-menu{position:absolute;z-index:5;top:35px;right:0;width:220px;padding:6px;background:#fff;border:1px solid var(--ide-border-strong);border-radius:9px;box-shadow:0 12px 24px rgba(27,35,49,.18);}
  .segment-menu[hidden]{display:none;}
  .segment-menu button{display:block;width:100%;border:0;border-radius:5px;background:transparent;padding:8px 9px;text-align:left;font:inherit;font-size:12.5px;color:var(--ide-ink);cursor:pointer;}
  .segment-menu button:hover{background:var(--ide-hover);}
  .segment-menu hr{border:0;border-top:1px solid var(--ide-border);margin:6px 0;}
  .segment-menu .delete-action{color:#B42318;}
  [data-segment][data-disabled="true"] .segment-card{filter:grayscale(.75);opacity:.45;box-shadow:none;}
  [data-segment][data-disabled="true"] .segment-copy h3,.segment-card [data-disabled="true"] .segment-copy h3{text-decoration:line-through;}
  [data-segment].is-dragging{opacity:.42;}[data-segment].is-drop-target .segment-card{box-shadow:0 0 0 2px var(--ide-accent),0 6px 15px rgba(39,67,107,.13);}
  .view.step-enter{animation:stepEnter .28s ease-out both;}
  @keyframes stepEnter{from{opacity:.25;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  @keyframes detailOpen{from{opacity:0;transform:translateY(-3px)}to{opacity:1;transform:translateY(0)}}
  @media (max-width:700px){.pl{padding:14px 12px 32px;}.pl-canvas > li{grid-template-columns:25px minmax(0,1fr);gap:6px;}.pl-canvas > li:not(:last-child)::after{left:31px;}.segment-drag{width:24px;font-size:17px;}.segment-card{padding:9px 43px 9px 10px;gap:8px;border-left-width:4px;}.segment-copy h3{font-size:.84rem;}.segment-actions{right:8px;top:8px;}.segment-menu-toggle{width:28px;height:28px;}}

  /* params */
  .form{padding:28px 32px 80px;max-width:560px;}
  .form h2{margin:0;font-size:1.35rem;letter-spacing:-.015em;}
  .form-note{margin:6px 0 22px;font-size:13px;color:var(--ide-ink-soft);}
  .field{display:block;margin-bottom:16px;}
  .fl{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;margin-bottom:5px;}
  .req{font-family:var(--ide-mono);font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:#B4451F;font-weight:700;}
  .spec{font-family:var(--ide-mono);font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ide-accent);font-weight:700;}
  .field input,.field select{
    width:100%;padding:8px 11px;border:1px solid var(--ide-border-strong);border-radius:6px;
    background:var(--ide-editor);font:inherit;font-size:13.5px;color:var(--ide-ink);
  }
  .field input:focus-visible,.field select:focus-visible{outline:2px solid var(--ide-accent);outline-offset:1px;}

  /* run */
  .run{padding:28px 32px 80px;max-width:940px;}
  .run h2{margin:0 0 14px;font-size:1.35rem;letter-spacing:-.015em;}
  .run h3{margin:30px 0 10px;font-size:1rem;}
  .log{
    font-family:var(--ide-mono);font-size:12px;line-height:1.75;margin:0;
    background:#F2F5FA;border:1px solid var(--ide-border);border-radius:8px;padding:14px 16px;
    overflow-x:auto;color:#33415C;white-space:pre;
  }
  .tw{overflow-x:auto;border:1px solid var(--ide-border);border-radius:8px;}
  .run table{border-collapse:collapse;width:100%;min-width:820px;font-size:12.5px;}
  .run th,.run td{padding:8px 11px;border-bottom:1px solid var(--ide-border);text-align:left;white-space:nowrap;}
  .run th{background:var(--ide-panel);font-family:var(--ide-mono);font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--ide-ink-soft);}
  .run tr:last-child td{border-bottom:0;}
  .empty{color:#A9B4C6;}
  .synth{margin:10px 0 0;font-size:12px;color:var(--ide-ink-soft);}
  .acc{list-style:none;margin:0;padding:0;display:grid;gap:8px;}
  .acc li{display:flex;gap:10px;align-items:flex-start;font-size:13.5px;color:#33415C;}
  .tick{color:#1E7A55;font-weight:700;}
</style>

<script>
  const canvas = document.querySelector<HTMLElement>('[data-pipeline-canvas]');
  if (canvas) {
    const segments = () => Array.from(canvas.querySelectorAll<HTMLElement>('[data-segment]'));
    let dragging: HTMLElement | null = null;
    const reindexSegments = () => segments().forEach((segment, index) => { segment.dataset.segmentIndex = String(index); });
    const closeMenus = () => canvas.querySelectorAll<HTMLElement>('[data-segment-menu]').forEach((menu) => {
      menu.hidden = true;
      menu.closest<HTMLElement>('.segment-actions')?.querySelector<HTMLButtonElement>('[data-segment-menu-toggle]')
        ?.setAttribute('aria-expanded', 'false');
    });

    canvas.querySelectorAll<HTMLButtonElement>('[data-segment-menu-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const menu = toggle.parentElement?.querySelector<HTMLElement>('[data-segment-menu]');
        const isOpen = menu?.hidden === false;
        closeMenus();
        if (menu) menu.hidden = isOpen;
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    canvas.querySelectorAll<HTMLButtonElement>('[data-segment-action]').forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.stopPropagation();
        const segment = button.closest<HTMLElement>('[data-segment]');
        if (!segment) return;
        const action = button.dataset.segmentAction;
        if (action === 'disable') segment.dataset.disabled = 'true';
        if (action === 'disable-below') {
          const start = Number(segment.dataset.segmentIndex ?? 0);
          segments().filter((item) => Number(item.dataset.segmentIndex ?? -1) >= start)
            .forEach((item) => { item.dataset.disabled = 'true'; });
        }
        if (action === 'copy') {
          await navigator.clipboard?.writeText(segment.querySelector('h3')?.textContent ?? '').catch(() => undefined);
          button.textContent = 'Copied';
          window.setTimeout(() => { button.textContent = 'Copy'; }, 900);
        }
        if (action === 'delete') segment.remove();
        closeMenus();
      });
    });

    canvas.querySelectorAll<HTMLElement>('[data-segment-card]').forEach((card) => {
      const toggleDetails = () => {
        const isOpen = card.getAttribute('aria-expanded') === 'true';
        card.setAttribute('aria-expanded', String(!isOpen));
      };
      card.addEventListener('click', (event) => {
        if ((event.target as Element).closest('.segment-actions')) return;
        toggleDetails();
      });
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggleDetails();
        }
      });
    });

    canvas.querySelectorAll<HTMLElement>('[data-segment-handle]').forEach((handle) => {
      handle.addEventListener('dragstart', (event) => {
        dragging = handle.closest<HTMLElement>('[data-segment]');
        if (!dragging) return;
        dragging.classList.add('is-dragging');
        event.dataTransfer?.setData('text/plain', dragging.dataset.segmentIndex ?? '');
        if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
      });
      handle.addEventListener('dragend', () => {
        dragging?.classList.remove('is-dragging');
        canvas.querySelectorAll<HTMLElement>('.is-drop-target').forEach((item) => item.classList.remove('is-drop-target'));
        dragging = null;
      });
    });

    segments().forEach((segment) => {
      segment.addEventListener('dragover', (event) => {
        if (!dragging || dragging === segment) return;
        event.preventDefault();
        segment.classList.add('is-drop-target');
        if (event.dataTransfer) event.dataTransfer.dropEffect = 'move';
      });
      segment.addEventListener('dragleave', () => segment.classList.remove('is-drop-target'));
      segment.addEventListener('drop', (event) => {
        event.preventDefault();
        segment.classList.remove('is-drop-target');
        if (!dragging || dragging === segment) return;
        const bounds = segment.getBoundingClientRect();
        canvas.insertBefore(dragging, event.clientY < bounds.top + bounds.height / 2 ? segment : segment.nextSibling);
        reindexSegments();
      });
    });

    document.addEventListener('click', closeMenus);
  }
</script>
