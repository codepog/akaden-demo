---
import { FILES, outputCsv } from '../../data/ide';
import testRaw from '../../data/demo/student-contact-export.pipeline-test?raw';
import pipelineRaw from '../../data/demo/student-contact-export.pipeline?raw';
const test = JSON.parse(testRaw);
const pipeline = JSON.parse(pipelineRaw);
const checks = test.segments['Verify success'].config.checks as {path:string;operator:string}[];
const operators: Record<string,string> = {notExists:'not exists',isArray:'is array',isString:'is string'};
---
<div class="view lifecycle" data-view="test" hidden>
  <header class="test-heading">
    <div><span class="eyebrow">Pipeline test case</span><h2>{test.name}</h2></div>
    <button class="primary" type="button" data-run-quick-test>Run quick test</button>
  </header>
  <p>{test.description}</p>
  <p class="muted">Test file: <b>pipelines/{FILES.test.name}</b><br />Linked pipeline: <b>./{FILES.pipeline.name}</b></p>
  <div class="revision-actions"><button type="button" data-return-to-pipeline>← Refine pipeline</button><span>Optional: revise and test again if needed.</span></div>
  <p class="demo-note">Interactive simulation · Test definition adapted to this demo’s contact-export pipeline. No tenant calls or files are written.</p>
  <details class="setting"><summary>Parameters</summary><label>fileName<input value={test.parameters[0].value} data-test-filename /></label></details>
  <details class="setting"><summary>Connections</summary><p>The linked pipeline supplies the Ethos and S3 connections. This preview uses simulated responses and needs no credentials.</p></details>
  <details class="setting"><summary>Pipeline segments</summary>
    <p>Run the full pipeline or select segments to test. Each .test_pipeline file is a separate test case stored alongside its pipeline.</p>
    <div class="selection-actions"><button type="button" data-test-select="all">Select all</button><button type="button" data-test-select="none">Unselect all</button></div>
    <div class="segment-options">{pipeline.pipeline.map((name:string)=><label><input type="checkbox" data-test-segment checked />{name}</label>)}</div>
  </details>
  <section class="test-chain" aria-label="Test verification steps">
    <h3>Verification steps</h3>
    <details class="test-check assert" open>
      <summary><span class="check-icon">✓</span><span><strong>Verify success</strong><small>Assert · 3 validations</small></span><span class="test-result" data-test-result hidden>Passed</span></summary>
      <div class="check-body"><p>{test.segments['Verify success'].description}</p>
        <div class="checks">{checks.map(check=><div><code>{check.path}</code><span>{operators[check.operator]}</span></div>)}</div>
      </div>
    </details>
    <span class="chain-link" aria-hidden="true">↓</span>
    <details class="test-check transform">
      <summary><span class="check-icon">&lt;/&gt;</span><span><strong>Extract CSV payload</strong><small>JavaScript transform</small></span><span class="test-result" data-test-result hidden>Passed</span></summary>
      <div class="check-body"><p>{test.segments['Extract CSV payload'].description}</p><pre>{test.segments['Extract CSV payload'].config.code}</pre></div>
    </details>
    <span class="chain-link" aria-hidden="true">↓</span>
    <details class="test-check compare">
      <summary><span class="check-icon">≡</span><span><strong>compareFile</strong><small>Compare file</small></span><span class="test-result" data-test-result hidden>Passed</span></summary>
      <div class="check-body"><p>{test.segments.compareFile.description}</p><dl><dt>Source</dt><dd>csv</dd><dt>Expected file</dt><dd>{test.segments.compareFile.config.expectedFile}</dd></dl>
        <details><summary>View expected CSV sample</summary><pre>{[outputCsv.header.join(','),...outputCsv.rows.slice(0,2).map(row=>row.join(','))].join('\n')}</pre><p class="muted">Synthetic preview sample; no student data.</p></details>
      </div>
    </details>
  </section>
  <p class="test-summary" data-test-summary role="status" hidden></p>
</div>

<div class="view lifecycle" data-view="publish" hidden>
  <header class="publish-heading"><div><h2 data-published-name>contact-export</h2><span class="badge draft" data-publish-badge>DRAFT</span></div><button type="button" class="primary" data-publish-button>Publish</button></header>
  <p class="demo-note">Simulated Ellucian tenant · Publishing here does not affect any live environment.</p>
  <div class="view-tabs" role="tablist" aria-label="Deployed pipeline details"><button type="button" role="tab" aria-selected="true" data-publish-tab="overview">Overview</button><button type="button" role="tab" aria-selected="false" data-publish-tab="json">Pipeline JSON</button></div>
  <div data-publish-content="overview" role="tabpanel">
    <dl class="publish-details"><dt>Name</dt><dd data-published-name>contact-export</dd><dt>Version</dt><dd data-published-version>Not published</dd><dt>Status</dt><dd data-published-status>DRAFT</dd><dt>Type</dt><dd>Pipeline</dd><dt>Package</dt><dd>demo-package</dd><dt>Tenant</dt><dd>Demo University</dd><dt>Environment</dt><dd>test-env</dd></dl>
    <p class="publish-message" data-publish-message role="status">Draft deployed to Ellucian. Publish this version to make it live in the selected environment.</p>
  </div>
  <div data-publish-content="json" role="tabpanel" hidden><pre>{pipelineRaw}</pre></div>
</div>

<div class="view lifecycle" data-view="monitor" hidden>
  <header data-monitor-heading><span class="eyebrow">Monitoring</span><h2>Demo University <span class="environment">test-env</span></h2><p class="muted">Live pipeline performance and job history</p></header>
  <p class="demo-note">Student Contact Export v0.0.1 is live · Built-in Akaden dashboard · Simulated monitoring data</p>
  <section class="failure-chart" aria-label="Failures this week: zero across all seven days"><h3>Failures this week</h3>
    <svg viewBox="0 0 600 170" role="img" aria-label="Zero failed runs each day from Thursday to Wednesday">
      <g stroke="#e2e7ef"><path d="M35 20H575M35 70H575M35 120H575" /></g>
      <g fill="#68707e" font-size="12"><text x="12" y="24">5</text><text x="12" y="74">3</text><text x="12" y="124">0</text></g>
      <path d="M65 120H545" stroke="#d76060" stroke-width="2" fill="none" />
      {['Thu','Fri','Sat','Sun','Mon','Tue','Wed'].map((day,i)=><g><circle cx={65+i*80} cy="120" r="4" fill="#d76060"/><text x={65+i*80} y="150" text-anchor="middle" fill="#68707e" font-size="13">{day}</text></g>)}
    </svg>
  </section>
  <section class="job-history" aria-label="Job runs"><h3>Job runs <small>Today</small></h3>
    <div class="run-filters" role="group" aria-label="Filter job runs">{[['all','All 2'],['running','Running 0'],['failed','Failed 0'],['terminated','Terminated 0'],['succeeded','Succeeded 2']].map(([value,label])=><button type="button" data-run-filter={value} aria-pressed={value==='all'}>{label}</button>)}</div>
    <div data-monitor-runs>{['just now','1 minute ago'].map((time,i)=><article class="job-row"><span class="success-icon" aria-hidden="true">✓</span><div><strong>Student Contact Export <small>v0.0.1</small></strong><p>Succeeded · {time} · Run #DEMO-00{i+1}</p></div><button type="button" data-view-job={i+1}>View job</button></article>)}</div>
    <p class="empty-runs" data-monitor-empty role="status" hidden>No runs with this status today.</p>
  </section>
</div>

<style>
  .view{position:absolute;inset:0;overflow:auto}.view[hidden],[hidden]{display:none!important}
  .lifecycle{padding:22px 24px 40px;background:#fafcff;font-size:13px;line-height:1.5;color:var(--ide-ink)}
  h2{font-size:19px;line-height:1.3;margin:3px 0 8px;overflow-wrap:anywhere}h3{font-size:14px;margin:0 0 14px}p{margin:8px 0 14px}.muted{color:var(--ide-ink-soft);overflow-wrap:anywhere}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:#3376cd;font-weight:700}
  button,input{font:inherit}button{cursor:pointer}button:focus-visible,summary:focus-visible{outline:2px solid #3376cd;outline-offset:3px}button:disabled{cursor:default;opacity:.6}
  .primary{border:1px solid #0078d4;background:#0078d4;color:#fff;border-radius:6px;padding:8px 13px;white-space:nowrap;font-weight:650}.primary:hover:not(:disabled){background:#0668b1}
  .test-heading,.publish-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.test-heading .primary{margin-bottom:8px}
  .test-heading>div,.publish-heading>div{min-width:0;max-width:100%}
  .demo-note{font-size:11px;color:#657389;border-left:2px solid #b8cce6;padding-left:9px}
  .revision-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:14px 0;font-size:12px;color:#596779}.revision-actions button{border:1px solid #b9cde5;border-radius:6px;background:#eef5ff;color:#205eac;padding:7px 10px;font-weight:650}
  .setting{border:1px solid #d0d5dd;border-radius:9px;padding:12px 15px;margin-top:13px}.setting>summary{font-size:11px;font-weight:750;text-transform:uppercase;letter-spacing:.04em;cursor:pointer}.setting label{display:flex;align-items:center;gap:9px;margin:10px 0 2px}.setting input:not([type=checkbox]){width:100%;min-width:0;border:1px solid #c6ceda;border-radius:5px;padding:6px}.setting input[type=checkbox]{accent-color:#0078d4}
  .segment-options{max-height:180px;overflow:auto}.segment-options label{font-size:12px}.selection-actions{display:flex;gap:12px;justify-content:end;margin-top:10px}.selection-actions button,.job-row button{border:0;background:none;color:#0078d4;font-weight:650;padding:4px}
  .test-chain{margin-top:20px}.test-check{border:1px solid #d4d2ca;border-left:4px solid #c58a00;border-radius:9px;background:#fffbec;box-shadow:0 3px 8px #1b233108}.test-check>summary{display:flex;align-items:center;gap:10px;padding:13px;cursor:pointer;list-style:none}.test-check>summary::-webkit-details-marker{display:none}.test-check summary strong{display:block;font-size:14px}.test-check summary small{display:block;font-size:11px;color:#9a6c00}.check-icon{font-family:var(--ide-mono);color:#b67c00;flex-shrink:0}.transform{border-left-color:#bd5c10;background:#fff6ed}.transform summary small,.transform .check-icon{color:#b6540b}.compare{border-left-color:#8038e7;background:#f5efff}.compare summary small,.compare .check-icon{color:#8038e7}.check-body{padding:0 16px 14px}.check-body p{font-size:12px;color:#525b69}.chain-link{display:block;text-align:center;color:#8b949f;line-height:25px}.checks{display:grid;gap:6px}.checks>div{display:grid;grid-template-columns:minmax(0,1fr) 95px;border:1px solid #dedbce;border-radius:5px;background:#ffffff90;padding:6px 8px;font-size:11px}.checks code{overflow-wrap:anywhere}.test-result{margin-left:auto;font-size:10px;font-weight:700;color:#167444}.test-summary,.publish-message{padding:13px;border:1px solid #b3d4c4;border-radius:7px;background:#eef8f2;color:#215d40}.test-summary[data-state="error"]{border-color:#e3b4b4;background:#fff2f2;color:#9b3030}
  pre{overflow:auto;max-width:100%;padding:12px;border:1px solid #dce1e8;border-radius:6px;background:#f4f6f9;font-family:var(--ide-mono);font-size:11px;line-height:1.65}.check-body dl,.publish-details{display:grid;grid-template-columns:minmax(70px,.4fr) minmax(0,1fr);gap:10px 16px;margin:20px 0}dt{color:#68707e}dd{margin:0;overflow-wrap:anywhere}.check-body summary{cursor:pointer;color:#6831ae}
  .publish-heading>div{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.publish-heading h2{margin:0}.badge{font-size:10px;font-weight:750;border:1px solid currentColor;border-radius:20px;padding:1px 8px}.draft{color:#c67b00}.published{color:#167444}.view-tabs{display:flex;gap:16px;border-bottom:1px solid #dbe0e7;margin-top:25px}.view-tabs button{border:0;border-bottom:2px solid transparent;padding:12px 3px;background:none;color:#68707e}.view-tabs button[aria-selected=true]{color:#0078d4;border-color:#0078d4}.environment{font-size:11px;font-weight:500;color:#64748b}.publish-message{margin-top:28px}
  .failure-chart{border:1px solid #d3d9e2;border-radius:10px;padding:17px;margin:20px 0 24px}.failure-chart svg{display:block;width:100%;height:auto}.job-history h3{display:flex;justify-content:space-between;align-items:center}.job-history h3 small{font-size:11px;color:#0078d4;text-transform:uppercase}.run-filters{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}.run-filters button{border:1px solid #d4d9df;border-radius:20px;padding:4px 9px;background:#fff;color:#536274;font-size:11px}.run-filters button[aria-pressed=true]{background:#e9f3ff;border-color:#3376cd;color:#175ca6}.job-row{display:flex;align-items:center;gap:10px;border:1px solid #dbe1e7;border-radius:9px;padding:13px;margin-top:9px}.job-row>div{min-width:0;flex:1}.job-row strong{font-size:12px;overflow-wrap:anywhere}.job-row p{font-size:11px;color:#68707e;margin:3px 0 0}.job-row button{font-size:11px;white-space:nowrap}.success-icon{border-radius:50%;background:#e3f4eb;color:#187747;padding:6px 10px}.empty-runs{padding:22px;text-align:center;color:#68707e;border:1px dashed #cbd3de;border-radius:8px}
  @media(max-width:600px){.lifecycle{padding:16px 14px 30px}.job-row{flex-wrap:wrap}.job-row button{margin-left:auto}.checks>div{grid-template-columns:1fr;gap:2px}.publish-details{grid-template-columns:75px 1fr}}
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-test-select]').forEach(button=>button.addEventListener('click',()=>{
    document.querySelectorAll<HTMLInputElement>('[data-test-segment]').forEach(input=>{input.checked=button.dataset.testSelect==='all';});
    document.querySelector<HTMLInputElement>('[data-test-segment]')?.dispatchEvent(new Event('change'));
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-publish-tab]').forEach(button=>button.addEventListener('click',()=>{
    document.querySelectorAll<HTMLElement>('[data-publish-content]').forEach(panel=>{panel.hidden=panel.dataset.publishContent!==button.dataset.publishTab;});
    document.querySelectorAll('[data-publish-tab]').forEach(tab=>tab.setAttribute('aria-selected',String(tab===button)));
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-run-filter]').forEach(button=>button.addEventListener('click',()=>{
    const hasRuns=button.dataset.runFilter==='all'||button.dataset.runFilter==='succeeded';
    document.querySelectorAll('[data-run-filter]').forEach(filter=>filter.setAttribute('aria-pressed',String(filter===button)));
    document.querySelector<HTMLElement>('[data-monitor-runs]')!.hidden=!hasRuns;
    document.querySelector<HTMLElement>('[data-monitor-empty]')!.hidden=hasRuns;
  }));
</script>
