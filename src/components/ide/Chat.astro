---
import { steps, AGENTS } from '../../data/ide';
---
<aside class="chat" aria-label="Assistant">
  <header class="chat-head">
    <div class="title">Integration Specification Draft</div>
    <button type="button" class="ci" aria-label="History" tabindex="-1">⌄</button>
    <button type="button" class="ci chat-help" aria-label="New chat"><span aria-hidden="true">+</span><span class="chat-tip">New chat</span></button>
    <button type="button" class="ci chat-help" aria-label="Search in chat">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.5-4.5" stroke-linecap="round"/></svg>
      <span class="chat-tip">Search in chat</span>
    </button>
  </header>

  <div class="thread" data-thread>
    {steps.map((s) => (
      <div class="turnset" data-turns={s.n} hidden>
        {s.chat.length === 0 && (
          <p class="idle">Converse with the agent.</p>
        )}
        {s.chat.map((m) => (
          m.from === 'you'
            ? <div class="you"><p>{m.text}</p></div>
            : <div class="msg">
                {m.blocks?.map((b) =>
                  b.kind === 'h' ? <h4>{b.text}</h4>
                  : b.kind === 'ul' ? <ul>{b.items!.map((i) => <li set:html={i.replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>')} />)}</ul>
                  : b.kind === 'ol' ? <ol>{b.items!.map((i) => <li set:html={i.replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>')} />)}</ol>
                  : <p set:html={(b.text ?? '').replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\*\*([^*]+)\*\*/g,'<b>$1</b>')} />
                )}
                <footer class="mfoot">
                  <span class="ficons" aria-hidden="true">⧉ &nbsp;👍 &nbsp;👎</span>
                  <span class="meta">{m.meta}</span>
                </footer>
              </div>
        ))}
      </div>
    ))}
    <div class="pending-turn" data-pending-turn hidden><div class="you"><p data-pending-message></p></div></div>
    <div class="typing" data-typing hidden aria-live="polite"><span></span><span></span><span></span> The agent is working</div>
  </div>

  <div class="composer">
    <label class="sr" for="ask">Ask anything</label>
    <textarea id="ask" placeholder="Ask anything" rows="3" data-ask></textarea>

    <div class="picker" data-picker hidden>
      <p class="pk-head">Agent</p>
      <p class="pk-sub">Skill candidates and tool policy follow this agent; edit bindings in AI Settings.</p>
      <div class="pk-list" role="radiogroup" aria-label="Agent">
        {AGENTS.map((a) => (
          <label class="pk-row"><input type="radio" name="agent" value={a} /> <span>{a}</span></label>
        ))}
      </div>
    </div>

    <div class="crow">
      <button type="button" class="cbtn on" data-agent-btn aria-expanded="false">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M14 3l7 7-9 9H5v-7z"/></svg>
        <span data-agent-label>Agent</span> <span class="cv" aria-hidden="true">⌄</span>
      </button>
      <button type="button" class="cbtn" tabindex="-1">✦ Auto <span class="cv" aria-hidden="true">⌄</span></button>
      <button type="button" class="cbtn" tabindex="-1">Skills <span class="cv" aria-hidden="true">⌄</span></button>
      <button type="button" class="cbtn" tabindex="-1">Tools <span class="cv" aria-hidden="true">⌄</span></button>
      <button type="button" class="send" data-send aria-label="Send">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
      </button>
    </div>
  </div>
</aside>

<style>
  .chat{grid-area:chat;background:var(--ide-panel);display:flex;flex-direction:column;min-height:0;min-width:0;}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);}

  .chat-head{display:flex;align-items:center;gap:4px;padding:9px 12px;border-bottom:1px solid var(--ide-border);}
  .title{
    flex:1;min-width:0;background:var(--ide-editor);border:1px solid var(--ide-border);border-radius:6px;
    padding:6px 10px;font-size:13px;color:var(--ide-ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  .ci{border:0;background:transparent;color:var(--ide-ink-soft);font-size:15px;line-height:1;cursor:default;padding:4px 5px;display:flex;align-items:center;}.chat-help{position:relative;cursor:pointer;border-radius:4px;}.chat-help:hover{background:var(--ide-hover);color:var(--ide-ink);}.chat-help:focus-visible{outline:2px solid var(--ide-accent);outline-offset:1px;}.chat-tip{display:none;position:absolute;z-index:10;right:0;top:calc(100% + 6px);width:max-content;border:1px solid var(--ide-border-strong);border-radius:5px;background:#fff;padding:5px 7px;box-shadow:0 8px 18px rgba(0,33,99,.14);color:var(--ide-ink);font-size:10.5px;white-space:nowrap;}.chat-help:hover .chat-tip,.chat-help:focus-visible .chat-tip{display:block;}

  .thread{flex:1;min-height:0;overflow-y:auto;padding:16px 14px 20px;}
  .idle{margin:0;font-size:13px;color:var(--ide-ink-soft);}
  .you{display:flex;justify-content:flex-end;margin-bottom:14px;}
  .you p{margin:0;max-width:88%;background:var(--ide-active);border:1px solid #C9D9F0;border-radius:10px 10px 2px 10px;padding:9px 12px;font-size:13.5px;line-height:1.55;}
  .msg{font-size:13.5px;line-height:1.62;color:var(--ide-ink);}
  .msg p{margin:0 0 11px;}
  .msg h4{margin:18px 0 8px;font-size:14.5px;font-weight:700;}
  .msg ul,.msg ol{margin:0 0 11px;padding-left:20px;}
  .msg li{margin:4px 0;}
  .msg :global(code){font-family:var(--ide-mono);font-size:.86em;background:var(--ide-editor);border:1px solid var(--ide-border);border-radius:3px;padding:1px 4px;}
  .mfoot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px;padding-top:10px;border-top:1px solid var(--ide-border);}
  .ficons{font-size:12px;color:var(--ide-ink-soft);letter-spacing:.06em;}
  .meta{font-size:11.5px;color:var(--ide-ink-soft);}
  .typing{display:flex;align-items:center;gap:5px;margin:10px 0;color:var(--ide-ink-soft);font-size:12px;}.typing[hidden]{display:none;}
  .typing span{width:5px;height:5px;border-radius:50%;background:var(--ide-accent);animation:typingDot .9s ease-in-out infinite;}.typing span:nth-child(2){animation-delay:.14s;}.typing span:nth-child(3){animation-delay:.28s;}
  @keyframes typingDot{0%,100%{transform:translateY(0);opacity:.35}50%{transform:translateY(-4px);opacity:1}}

  .composer{border-top:1px solid var(--ide-border);padding:12px;background:var(--ide-panel);position:relative;}
  textarea{
    width:100%;resize:none;border:1px solid var(--ide-border);border-radius:8px 8px 0 0;border-bottom:0;
    background:var(--ide-editor);padding:11px 12px;font:inherit;font-size:13.5px;color:var(--ide-ink);display:block;
  }
  textarea:focus-visible{outline:2px solid var(--ide-accent);outline-offset:-1px;}
  .crow{
    display:flex;align-items:center;gap:6px;flex-wrap:wrap;
    border:1px solid var(--ide-border);border-radius:0 0 8px 8px;background:var(--ide-editor);padding:8px 10px;
  }
  .cbtn{
    display:inline-flex;align-items:center;gap:5px;border:1px solid transparent;background:transparent;
    border-radius:6px;padding:5px 8px;font:inherit;font-size:12.5px;color:var(--ide-ink);cursor:pointer;white-space:nowrap;
  }
  .cbtn:hover{background:var(--ide-hover);}
  .cbtn.on{border-color:#E0A93A;background:#FEF8EB;}
  .cbtn:focus-visible{outline:2px solid var(--ide-ink);outline-offset:1px;}
  .cv{color:var(--ide-ink-soft);font-size:11px;}
  .send{
    margin-left:auto;width:34px;height:34px;border-radius:50%;border:0;background:var(--ide-accent);color:#fff;
    display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:background-color 120ms;
  }
  .send:hover{background:#2A64B0;}
  .send:focus-visible{outline:2px solid var(--ide-ink);outline-offset:2px;}
  .chat[data-sending="true"] .composer{opacity:.66;}.chat[data-sending="true"] .send{animation:sendPulse .75s ease-in-out infinite;}
  @keyframes sendPulse{50%{transform:scale(.9);}}

  .picker{
    position:absolute;left:12px;right:12px;bottom:62px;z-index:5;
    background:var(--ide-editor);border:1px solid var(--ide-border-strong);border-radius:10px;
    padding:14px 16px;box-shadow:0 10px 30px rgba(0,33,99,.14);
  }
  .picker[hidden]{display:none;}
  .pk-head{margin:0;font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--ide-ink-soft);}
  .pk-sub{margin:6px 0 12px;font-size:12px;color:var(--ide-ink-soft);padding-bottom:12px;border-bottom:1px solid var(--ide-border);}
  .pk-list{display:grid;gap:2px;}
  .pk-row{display:flex;align-items:center;gap:9px;padding:6px 4px;border-radius:6px;font-size:13.5px;cursor:pointer;}
  .pk-row:hover{background:var(--ide-hover);}
  .pk-row input{accent-color:var(--ide-accent);width:15px;height:15px;}
</style>
