---
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const layers = [
  {
    key: 'intelligence',
    title: 'Intelligence',
    shortTitle: 'Intelligence',
    groups: [
      {
        label: 'AI models',
        brands: [
          { name: 'Claude', logo: 'claude.svg' },
          { name: 'ChatGPT', logo: 'openai.svg' },
          { name: 'DeepSeek', logo: 'deepseek.svg' },
        ],
      },
    ],
  },
  {
    key: 'development',
    title: 'Development',
    shortTitle: 'Development',
    groups: [
      {
        label: 'Development workflow',
        brands: [
          { name: 'Git', logo: 'git.svg' },
          { name: 'GitHub', logo: 'github.svg' },
          { name: 'Akaden Custom Skills', logo: 'akaden.svg' },
        ],
      },
    ],
  },
  {
    key: 'data',
    title: 'Data & Infrastructure',
    shortTitle: 'Data & Cloud',
    groups: [
      {
        label: 'Data platforms',
        brands: [
          { name: 'Snowflake', logo: 'snowflake.svg' },
          { name: 'Databricks', logo: 'databricks.svg' },
          { name: 'Oracle', logo: 'oracle.svg' },
        ],
      },
      {
        label: 'Cloud platforms',
        brands: [
          { name: 'AWS', logo: 'aws.svg' },
          { name: 'Microsoft Azure', logo: 'azure.svg' },
          { name: 'Google Cloud', logo: 'google-cloud.svg' },
        ],
      },
    ],
  },
  {
    key: 'systems',
    title: 'Existing Systems',
    shortTitle: 'Existing Systems',
    groups: [
      {
        label: 'Existing systems',
        brands: [
          { name: 'Ellucian', logo: 'ellucian.svg', wide: true },
          { name: 'Canvas', logo: 'canvas.svg' },
          { name: 'Moodle', logo: 'moodle.svg' },
          { name: 'SAP', logo: 'sap.svg' },
        ],
      },
    ],
  },
];
---

<section class="connected-stack" data-connected-stack aria-label="Connected across your stack">
  <div class="connected-stack__stage">
    <div class="connected-stack__visual" aria-label="Four connected layers from institutional systems through intelligence">
      {layers.map((layer, index) => (
        <button
          class={`connected-layer connected-layer--${layer.key}`}
          type="button"
          data-connected-layer={layer.key}
          aria-pressed="false"
          style={`--layer-index:${index};--layer-order:${layers.length - index}`}
        >
          <span class="connected-layer__artwork">
            <span class="connected-layer__face connected-layer__face--left" aria-hidden="true"></span>
            <span class="connected-layer__face connected-layer__face--right" aria-hidden="true"></span>
            <span class="connected-layer__plane" aria-hidden="true"></span>
            <span class="connected-layer__projection" aria-hidden="true">
            {layer.key === 'intelligence' && (
              <svg viewBox="0 0 100 100" preserveAspectRatio="none"><g transform="matrix(.18 -.25 .66 0 8 30)"><g transform="rotate(90 50 50)"><g transform="translate(10 10) scale(2.5)"><path d="M16 3v5M16 24v5M3 16h5M24 16h5M7 7l3.5 3.5M21.5 21.5 25 25M25 7l-3.5 3.5M10.5 21.5 7 25" /><circle cx="16" cy="16" r="5.5" /></g></g></g></svg>
            )}
            {layer.key === 'development' && (
              <svg viewBox="0 0 100 100" preserveAspectRatio="none"><g transform="matrix(.18 -.25 .66 0 8 30)"><g transform="rotate(90 50 50)"><g transform="translate(10 10) scale(2.5)"><circle cx="8" cy="7" r="3" /><circle cx="24" cy="25" r="3" /><circle cx="8" cy="25" r="3" /><path d="M8 10v12M11 8h5a8 8 0 0 1 8 8v6" /></g></g></g></svg>
            )}
            {layer.key === 'data' && (
              <svg viewBox="0 0 100 100" preserveAspectRatio="none"><g transform="matrix(.18 -.25 .66 0 8 30)"><g transform="rotate(90 50 50)"><g transform="translate(10 10) scale(2.5)"><ellipse cx="16" cy="7" rx="10" ry="4" /><path d="M6 7v9c0 2.2 4.5 4 10 4s10-1.8 10-4V7M6 16v9c0 2.2 4.5 4 10 4s10-1.8 10-4v-9" /></g></g></g></svg>
            )}
            {layer.key === 'systems' && (
              <svg viewBox="0 0 100 100" preserveAspectRatio="none"><g transform="matrix(.18 -.25 .66 0 8 30)"><g transform="rotate(90 50 50)"><g transform="translate(10 10) scale(2.5)"><path d="M4 13 16 5l12 8M7 13v12M13 13v12M19 13v12M25 13v12M4 27h24" /></g></g></g></svg>
            )}
            </span>
            <span class="connected-layer__label">
              <strong>{layer.shortTitle}</strong>
            </span>
            <span class="connected-layer__inline-icons" aria-hidden="true">
              {layer.groups.flatMap((group) => group.brands).map((brand) => (
                <span class={`connected-layer__logo ${'wide' in brand && brand.wide ? 'connected-layer__logo--wide' : ''}`}>
                  <img src={`${basePath}brands/${brand.logo}`} alt="" loading="lazy" />
                </span>
              ))}
            </span>
          </span>
        </button>
      ))}
    </div>

    <div class="connected-stack__details">
      <p class="connected-stack__prompt"><strong>Explore the stack</strong><span>Scroll through the story or select a layer to investigate what connects.</span></p>
    </div>
  </div>
</section>

<style>
  .connected-stack{--stack-blue:#1769e0;--stack-navy:#15285d;--stack-purple:#5c2dc1;min-width:0}
  .connected-stack__stage{display:grid;grid-template-columns:1fr;grid-template-areas:"stack" "details";align-items:center;gap:.35rem;margin-top:0}.connected-stack__visual{--layer-step:5rem;position:relative;grid-area:stack;min-height:26rem;perspective:900px}
  .connected-layer{position:absolute;z-index:var(--layer-order);top:calc(var(--layer-index) * var(--layer-step));left:50%;width:min(100%,22rem);height:9rem;border:0;background:transparent;padding:0;color:#101828;font:inherit;cursor:pointer;transform:translateX(-50%);transition:opacity .28s ease,filter .28s ease,transform .28s cubic-bezier(.22,1,.36,1)}.connected-layer__plane,.connected-layer__face,.connected-layer__projection{position:absolute;top:.15rem;right:.35rem;left:.35rem;height:8.3rem}.connected-layer__plane{z-index:1;background:linear-gradient(145deg,color-mix(in srgb,var(--layer-color),#fff 13%),var(--layer-color) 61%,color-mix(in srgb,var(--layer-color),#173970 8%));clip-path:polygon(4% 34%,44% 2%,97% 20%,57% 52%);filter:drop-shadow(0 .18rem .18rem rgb(15 38 83/.17));transition:filter .28s ease,transform .28s cubic-bezier(.22,1,.36,1)}.connected-layer__face{z-index:0;filter:drop-shadow(0 .65rem .55rem rgb(15 38 83/.22))}.connected-layer__face--left{background:color-mix(in srgb,var(--layer-color),#fff 42%);clip-path:polygon(4% 34%,57% 52%,57% 78%,4% 60%)}.connected-layer__face--right{background:color-mix(in srgb,var(--layer-color),#274d84 18%);clip-path:polygon(57% 52%,97% 20%,97% 46%,57% 78%)}.connected-layer__projection{z-index:2;color:var(--layer-accent);opacity:.04;pointer-events:none;transition:opacity .28s ease}.connected-layer__projection svg{display:block;width:100%;height:100%;overflow:visible;fill:none;stroke:currentColor;stroke-width:1.15;stroke-linecap:round;stroke-linejoin:round}.connected-layer__label{position:absolute;z-index:3;top:3.48rem;left:8%;display:block;width:46%;max-width:none;border:0;background:transparent;padding:0;color:#101828;text-align:left;transform:rotate(7.5deg);transform-origin:left center}.connected-layer__label strong{display:block;overflow:hidden;font-size:.94rem;line-height:1.05;text-overflow:ellipsis;white-space:nowrap}.connected-layer--intelligence{--layer-color:#dcecff;--layer-accent:#1769e0}.connected-layer--development{--layer-color:#b9d7fb;--layer-accent:#365bc4}.connected-layer--data{--layer-color:#86b5ed;--layer-accent:#173c8f}.connected-layer--systems{--layer-color:#416fb7;--layer-accent:#17366f}.connected-stack[data-active] .connected-layer:not(.is-active){opacity:.48;filter:saturate(.68)}.connected-layer:is(:hover,:focus-visible,.is-active) .connected-layer__projection{opacity:.4}.connected-layer.is-active{transform:translateX(-50%) translateY(-1.15rem) scale(1.035)}.connected-layer.is-active .connected-layer__plane{filter:drop-shadow(0 .25rem .24rem rgb(15 38 83/.24));transform:translateY(-.13rem)}.connected-layer:focus-visible{outline:3px solid var(--stack-purple);outline-offset:-.15rem;border-radius:1rem}
  .connected-stack__details{grid-area:details;min-width:0}.connected-stack__prompt{display:grid;max-width:25rem;gap:.35rem;margin:0 auto;border-top:3px solid #bdd3ef;padding:.85rem 1rem 0;color:#66738a;text-align:center}.connected-stack__prompt strong{color:var(--stack-navy);font-size:1rem}.connected-stack__prompt span{font-size:.82rem;line-height:1.45}
  @media(max-width:760px){.connected-stack__stage{gap:.65rem}.connected-stack__visual{--layer-step:4.55rem;min-height:24rem}.connected-stack__prompt{text-align:center}.connected-layer{width:min(100%,20.5rem)}}
  @media(max-width:420px){.connected-stack__visual{--layer-step:4.25rem;min-height:22.5rem}.connected-layer{width:min(100%,19.2rem);height:8.2rem}.connected-layer__plane,.connected-layer__face,.connected-layer__projection{right:.25rem;left:.25rem;height:7.5rem}.connected-layer__label{top:3.15rem;left:8%;width:47%}.connected-layer__label strong{font-size:.82rem}.connected-brand{font-size:.62rem}}
  @media(hover:none){.connected-layer:hover{transform:translateX(-50%)}}
  @media(prefers-reduced-motion:reduce){.connected-layer,.connected-layer__plane{transition:none}}
  /* Keep the interaction bands stationary and mutually exclusive. The visible
     prism faces may overlap, but they never compete for the pointer. */
  .connected-layer{height:var(--layer-step);transition:opacity .28s ease,filter .28s ease}
  .connected-layer:last-child{height:8rem}
  .connected-layer{pointer-events:auto}
  .connected-layer__plane,.connected-layer__face,.connected-layer__projection,.connected-layer__label,.connected-layer__inline-icons{pointer-events:none}
  .connected-layer.is-active{transform:translateX(-50%)}
  .connected-layer__plane{clip-path:polygon(8% 30%,26% 5%,92% 5%,74% 30%)}
  .connected-layer__face--left{clip-path:polygon(8% 30%,74% 30%,74% 58%,8% 58%)}
  .connected-layer__face--right{clip-path:polygon(74% 30%,92% 5%,92% 33%,74% 58%)}
  .connected-layer__label{top:3.8rem;left:10%;width:62%;text-align:center;transform:translateY(-50%)}
  .connected-stack__visual{--layer-step:3.7rem;--layer-open-gap:5.65rem;min-height:24rem}
  .connected-layer{top:calc(var(--layer-open-gap) + var(--layer-index) * var(--layer-step) + 2.5rem);transition:opacity .28s ease,filter .28s ease}
  .connected-layer__artwork{position:absolute;top:-2.5rem;right:0;left:0;height:9rem;pointer-events:none;transform:translateY(var(--artwork-shift,0rem));transition:transform .38s cubic-bezier(.22,1,.36,1)}
  .connected-stack[data-active="development"] .connected-layer--intelligence,
  .connected-stack[data-active="data"] .connected-layer:is(.connected-layer--intelligence,.connected-layer--development),
  .connected-stack[data-active="systems"] .connected-layer:is(.connected-layer--intelligence,.connected-layer--development,.connected-layer--data){--artwork-shift:calc(-1 * var(--layer-open-gap))}
  .connected-layer__inline-icons{position:absolute;z-index:4;top:-2.65rem;left:8%;display:flex;width:84%;height:2.3rem;align-items:center;justify-content:center;gap:.38rem;opacity:0;pointer-events:none;transform:translateY(.3rem);transition:opacity .2s ease,transform .3s cubic-bezier(.22,1,.36,1)}
  .connected-layer.is-active .connected-layer__inline-icons{opacity:1;transform:translateY(0);transition-delay:.08s}
  .connected-layer__logo{position:relative;display:grid;width:2.25rem;height:2.25rem;flex:none;place-items:center;border:1px solid #b8cbe5;border-radius:.58rem;background:linear-gradient(145deg,#fff 0%,#f5f9ff 78%,#e7f0fb 100%);box-shadow:0 .2rem 0 #a9bfdc,0 .45rem .75rem -.45rem rgb(20 51 103/.48)}
  .connected-layer__logo img{display:block;width:1.45rem;height:1.45rem;object-fit:contain}.connected-layer__logo--wide{width:3.25rem}.connected-layer__logo--wide img{width:2.55rem}.connected-layer__logo .connected-brand__mark{width:1.45rem;height:1.45rem;font-size:.64rem}.connected-layer__logo .connected-brand__mark--oracle{width:auto;font-size:.48rem}
  @media(max-width:760px){.connected-stack__visual{--layer-step:3.5rem;--layer-open-gap:5.9rem;min-height:24rem}}
  @media(max-width:420px){.connected-layer{height:var(--layer-step)}.connected-layer:last-child{height:7.5rem}.connected-layer__label{top:3.5rem}.connected-layer__inline-icons{top:-2.85rem;left:5%;width:90%;gap:.28rem}.connected-layer__logo{width:2rem;height:2rem}.connected-layer__logo img{width:1.3rem;height:1.3rem}.connected-layer__logo--wide{width:2.75rem}.connected-layer__logo--wide img{width:2.15rem}.connected-stack__visual{--layer-step:3.35rem;--layer-open-gap:5.8rem;min-height:23.5rem}}
</style>

<script>
  type StackElement = HTMLElement & { _connectedStackCleanup?: () => void };

  const setupConnectedStack = (root: StackElement) => {
    root._connectedStackCleanup?.();
    const layerButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-connected-layer]')];
    const changesLayout = root.closest<HTMLElement>('.changes-layout');
    const changesStory = root.closest<HTMLElement>('.changes-story');
    const changePanels = changesLayout
      ? [...changesLayout.querySelectorAll<HTMLElement>('[data-change-panel]')]
      : [];
    const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const scrollStoryQuery = window.matchMedia('(min-width: 1051px)');
    const activeKey = changePanels.find((panel) => panel.classList.contains('is-active'))?.dataset.changePanel
      || layerButtons[0]?.dataset.connectedLayer
      || '';
    let panelTransitionTimer = 0;

    const render = (key: string) => {
      if (!key) return;
      root.dataset.active = key;

      layerButtons.forEach((button) => {
        const buttonKey = button.dataset.connectedLayer || '';
        const active = buttonKey === key;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      const previousPanel = changePanels.find((panel) => panel.classList.contains('is-active'));
      const nextPanel = changePanels.find((panel) => panel.dataset.changePanel === key);
      const panelChanged = previousPanel && nextPanel && previousPanel !== nextPanel;
      window.clearTimeout(panelTransitionTimer);
      changePanels.forEach((panel) => panel.classList.remove('is-leaving'));
      if (panelChanged) {
        previousPanel.classList.remove('is-active');
        previousPanel.classList.add('is-leaving');
      }
      changePanels.forEach((panel) => {
        const active = panel.dataset.changePanel === key;
        panel.classList.toggle('is-active', active);
        panel.setAttribute('aria-hidden', String(!active));
      });
      if (panelChanged) {
        panelTransitionTimer = window.setTimeout(() => {
          changePanels.forEach((panel) => panel.classList.remove('is-leaving'));
        }, 700);
      }
    };

    const scrollToKey = (key: string) => {
      if (!changesStory || !scrollStoryQuery.matches) return;
      const keys = changePanels.map((panel) => panel.dataset.changePanel || '');
      const index = keys.indexOf(key);
      if (index < 0) return;
      const rect = changesStory.getBoundingClientRect();
      const activationLine = window.innerHeight * .22;
      const travel = Math.max(rect.height - window.innerHeight * .65, 1);
      const storyTop = window.scrollY + rect.top;
      const stepProgress = keys.length > 1 ? index / (keys.length - 1) : 0;
      window.scrollTo({
        top: Math.max(0, storyTop - activationLine + travel * stepProgress),
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
      });
    };

    const cleanups: Array<() => void> = [];
    layerButtons.forEach((button) => {
      const key = button.dataset.connectedLayer || '';
      const onEnter = () => {
        if (hoverQuery.matches) render(key);
      };
      const onFocus = () => render(key);
      const onClick = () => {
        render(key);
        scrollToKey(key);
      };
      button.addEventListener('mouseenter', onEnter);
      button.addEventListener('focus', onFocus);
      button.addEventListener('click', onClick);
      cleanups.push(() => {
        button.removeEventListener('mouseenter', onEnter);
        button.removeEventListener('focus', onFocus);
        button.removeEventListener('click', onClick);
      });
    });

    let scrollFrame = 0;
    const syncToScroll = () => {
      scrollFrame = 0;
      if (!changesStory || !scrollStoryQuery.matches || changePanels.length === 0) return;
      const rect = changesStory.getBoundingClientRect();
      const activationLine = window.innerHeight * .22;
      const travel = Math.max(rect.height - window.innerHeight * .65, 1);
      const progress = Math.min(1, Math.max(0, (activationLine - rect.top) / travel));
      const index = Math.min(changePanels.length - 1, Math.round(progress * (changePanels.length - 1)));
      const key = changePanels[index]?.dataset.changePanel;
      if (key) render(key);
    };
    const requestScrollSync = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(syncToScroll);
    };
    window.addEventListener('scroll', requestScrollSync, { passive: true });
    window.addEventListener('resize', requestScrollSync);
    cleanups.push(() => {
      window.removeEventListener('scroll', requestScrollSync);
      window.removeEventListener('resize', requestScrollSync);
      if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
      window.clearTimeout(panelTransitionTimer);
    });

    render(activeKey);
    requestScrollSync();
    root._connectedStackCleanup = () => cleanups.forEach((cleanup) => cleanup());
  };

  document.querySelectorAll<StackElement>('[data-connected-stack]').forEach(setupConnectedStack);
</script>
