---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ConnectedStack from './ConnectedStack.astro';
import { benefits, contact, hero, proof } from '../data/site';
import { changeRequest } from '../data/caseStudy';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (name: string) => `${basePath}${name}`;
const demoPage = import.meta.env.DEV ? `${basePath}overview-demo-embed` : `${basePath}overview-demo-embed.html`;
const demoUrl = `${demoPage}?intro=always`;

const caseStudyRows = [
  {
    step: 'Understand and map the legacy system',
    estimated: 110,
    actual: 70,
    impactLead: 'Reduced integration complexity.',
    impact: 'Akaden mapped how data moved through the legacy system, revealing the rules and relationships needed to rebuild it without tracing every path by hand.',
  },
  {
    step: 'Translate the pipeline to the new system',
    estimated: 120,
    actual: 80,
    impactLead: 'Kept knowledge with the team.',
    impact: 'Instead of developing new pipelines from scratch, Akaden agents used context from the existing systems to help design, generate, and refine pipelines for the new platform.',
  },
  {
    step: 'Test, validate, and monitor the pipeline',
    estimated: 382,
    actual: 294,
    impactLead: 'Accelerated pipeline delivery.',
    impact: 'Akaden introduced built-in pipeline testing and monitoring, capabilities the team did not have before. Test results and live run data made it easier to catch issues before release and troubleshoot them afterward.',
  },
  {
    step: 'Other',
    estimated: 212,
    actual: 146,
    impactLead: 'Applied best practices by default.',
    impact: 'Specialized agents carry proven delivery patterns into routine development work, making the process faster and more consistent.',
  },
];

const caseStudyTotal = { estimated: 824, actual: 590, saved: 234 };

---

<Base title="Akaden | AI-assisted IDE for Ellucian pipeline development">
  <Nav />

  <main id="main" class="product-test">
    <section class="test-hero" aria-labelledby="test-hero-title">
      <div class="test-hero__glow test-hero__glow--one" aria-hidden="true"></div>
      <div class="test-hero__glow test-hero__glow--two" aria-hidden="true"></div>
      <div class="test-shell test-hero__grid">
        <div class="test-hero__copy">
          <p class="test-eyebrow">{hero.eyebrow}</p>
          <h1 id="test-hero-title">{hero.headline}</h1>
          <p class="test-hero__lead">{hero.lead}</p>
          <div class="test-actions">
            <a class="test-button test-button--light" href="#interactive-demo">
              View interactive demo
            </a>
            <a class="test-link test-link--light" href="#form">Contact Us <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="test-hero__visual" aria-label="How Akaden coordinates connected systems and specialized agents">
          <div class="test-hero__visual-bar" aria-hidden="true">
            <span><i></i><i></i><i></i></span>
          </div>
          <img
            class="test-hero__image"
            src={assetPath('hero-agent-network.png')}
            alt="An engineer directing specialized agents connected to legacy systems, a data warehouse, pipelines, student records, an LMS, and future systems."
            width="1680"
            height="882"
          />
        </div>
      </div>
    </section>

    <div class="overview-stage">
      <div class="overview-backdrop" aria-hidden="true">
        <span class="overview-backdrop__arc"></span>
        <span class="overview-backdrop__tiles"></span>
      </div>

      <div class="test-scroll-gate" data-scroll-gate>
        <a class="test-hero__scroll-cue" href="#overview">
          <span>Scroll to explore</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="m5 8 5 5 5-5" />
          </svg>
        </a>
      </div>

      <section id="overview" class="test-section test-section--white">
        <div class="test-shell">
        <div class="test-section__intro">
          <p class="test-eyebrow test-eyebrow--blue">Overview</p>
          <h2>{hero.thesis}</h2>
          <p>{hero.thesisSub}</p>
        </div>

          <div class="overview-comparison" aria-label="How Akaden changes who does the work">
            <article class="overview-comparison__panel">
              <header>
                <p class="test-eyebrow">The old way</p>
                <h3>One engineer carries the complexity.</h3>
              </header>
              <img
                src={assetPath('overview-old-way.png')}
                alt="An engineer manually coordinating legacy systems, Ellucian platforms, data warehouses, student records, pipelines, learning systems, and future systems."
                width="1197"
                height="666"
                loading="lazy"
              />
            </article>
            <article class="overview-comparison__panel overview-comparison__panel--akaden">
              <header>
                <p class="test-eyebrow">With Akaden</p>
                <h3>Engineers direct specialized agents.</h3>
              </header>
              <img
                src={assetPath('overview-with-akaden.png')}
                alt="An engineer directing Akaden agents that coordinate shared knowledge and connected integration systems."
                width="1197"
                height="666"
                loading="lazy"
              />
            </article>
          </div>

        </div>
      </section>
    </div>

    <section id="outcomes" class="test-section test-section--tint">
      <div class="test-shell">
        <div class="changes-story">
          <div class="changes-scene">
            <div class="test-section__intro test-section__intro--wide">
              <p class="test-eyebrow test-eyebrow--blue">{benefits.eyebrow}</p>
              <h2>Your engineers set the direction. <span class="benefits-headline__agents">Specialized agents move it forward.</span></h2>
            </div>

            <div class="changes-layout">
              <div class="changes-copy">
                <div class="change-detail" aria-live="polite" aria-label="Connected stack layer details">
                  {benefits.items.map((item, index) => (
                    <article
                      id={`change-detail-${item.key}`}
                      class:list={['change-detail__panel', index === 0 && 'is-active']}
                      data-change-panel={item.key}
                      aria-hidden={index === 0 ? 'false' : 'true'}
                    >
                      <h3>{item.title}</h3>
                      <p>{item.body}</p>
                    </article>
                  ))}
                </div>
              </div>
              <ConnectedStack />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="interactive-demo" class="test-section demo-section" aria-labelledby="interactive-demo-title">
      <div class="test-shell">
        <div class="test-section__intro test-section__intro--wide">
          <p class="test-eyebrow test-eyebrow--blue">Interactive Demo</p>
          <h2 id="interactive-demo-title">Try Akaden for yourself.</h2>
          <p>Follow the guided workspace to see how Akaden turns a real business request into a reviewed, deployable pipeline.</p>
        </div>

        <div class="demo-embed" data-demo-embed>
          <img
            src={assetPath('hero-demo-preview.png')}
            alt="Akaden workspace ready to begin the guided interactive demo."
            width="2798"
            height="1302"
            loading="lazy"
          />
          <button class="demo-embed__play" type="button" data-demo-play aria-label="Start the Akaden interactive demo">
            <span class="demo-embed__play-icon" aria-hidden="true">
              <svg viewBox="0 0 72 72"><circle cx="36" cy="36" r="34" /><path d="m30 24 20 12-20 12Z" /></svg>
            </span>
            <strong>Start interactive demo</strong>
          </button>
          <iframe data-src={demoUrl} title="Akaden interactive walkthrough" loading="lazy" hidden></iframe>
        </div>
      </div>
    </section>

    <section id="specification" class="test-section test-section--lavender">
      <div class="test-shell">
        <article class="case-study-card">
          <header class="case-study-card__header">
            <div>
            <p class="test-eyebrow test-eyebrow--blue">{changeRequest.when}</p>
            <h3>{changeRequest.ask}</h3>
            <p>Moving the university’s integrations to Ellucian Data Connect meant carrying years of business logic into a new platform. Akaden helped the delivery team get past the manual analysis and troubleshooting that made that work demanding.</p>
            </div>
          </header>

          <div class="case-study-table-wrap">
            <table class="case-study-table">
              <thead>
                <tr>
                  <th scope="col">Project step</th>
                  <th scope="col">Estimated hours</th>
                  <th scope="col">Actual hours</th>
                  <th scope="col">How Akaden helped</th>
                </tr>
              </thead>
              <tbody>
                {caseStudyRows.map((row) => (
                  <tr class:list={[row.step === 'Other' && 'case-study-table__other']}>
                    <th scope="row" data-label="Project step">{row.step}</th>
                    <td data-label="Estimated hours">{row.estimated}</td>
                    <td data-label="Actual hours"><strong>{row.actual}</strong></td>
                    <td data-label="How Akaden helped">
                      <strong class="case-study-table__impact-lead">{row.impactLead}</strong>
                      {row.impact}
                    </td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row" data-label="Project step">Total</th>
                  <td data-label="Estimated hours">{caseStudyTotal.estimated}</td>
                  <td data-label="Actual hours"><strong>{caseStudyTotal.actual}</strong></td>
                  <td data-label="How Akaden helped"><strong>{caseStudyTotal.saved} engineering hours saved across the project.</strong></td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="case-study-card__evidence">
            <figure class="case-study-card__testimonial">
              <blockquote><p>“I was able to begin with an almost complete pipeline design and focus on refinement, testing, debugging, and validation.”</p></blockquote>
              <figcaption>Data Integration Engineer, ABCloudz</figcaption>
            </figure>
          </div>
        </article>
      </div>
    </section>

    <section id="proof" class="test-section test-section--ink">
      <div class="test-shell">
        <div class="test-section__intro test-section__intro--dark">
          <p class="test-eyebrow test-eyebrow--blue">{proof.eyebrow}</p>
          <h2>{proof.headline}</h2>
          <p>{proof.lead}</p>
        </div>
        <div class="stat-grid">
          {proof.stats.map((stat) => (
            <article><strong>{stat.figure}</strong><span>{stat.label}</span></article>
          ))}
        </div>
      </div>
    </section>

    <section id="form" class="contact-section" aria-labelledby="contact-heading">
      <div class="test-shell contact-layout">
        <div class="contact-copy">
          <p class="test-eyebrow">{contact.eyebrow}</p>
          <h2 id="contact-heading">{contact.headline}</h2>
          <p>{contact.lead}</p>
          <p>{contact.close}</p>
        </div>

        <div class="contact-form" role="form" aria-label="Contact Akaden">
          <div class="contact-form__row">
            <label>
              <span>First Name <b aria-hidden="true">*</b></span>
              <input type="text" name="first-name" autocomplete="given-name" maxlength="400" required />
            </label>
            <label>
              <span>Last Name <b aria-hidden="true">*</b></span>
              <input type="text" name="last-name" autocomplete="family-name" maxlength="400" required />
            </label>
          </div>

          <label>
            <span>Company Email <b aria-hidden="true">*</b></span>
            <input type="email" name="company-email" autocomplete="email" inputmode="email" maxlength="400" required />
          </label>

          <label>
            <span>Company Name <b aria-hidden="true">*</b></span>
            <input type="text" name="company-name" autocomplete="organization" maxlength="400" placeholder="Institution or organization name" required />
          </label>

          <label>
            <span>Your Message <b aria-hidden="true">*</b></span>
            <textarea name="your-message" rows="4" maxlength="2000" placeholder="Tell us about your current integration, systems, or modernization plans." required></textarea>
          </label>

          {contact.ctaHref ? (
            <a class="contact-form__submit" href={contact.ctaHref}>{contact.ctaLabel}</a>
          ) : (
            <button class="contact-form__submit" type="button" disabled>{contact.ctaLabel}</button>
          )}
          <p class="contact-form__note">We’ll use these details only to follow up about your Akaden demo.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  :global(html){scroll-behavior:smooth}
  .product-test{--test-blue:#1769e0;--test-indigo:#281489;--test-purple:#5c2dc1;--test-ink:#101828;--test-soft:#4b5872;--test-canvas:#eef5ff;color:var(--test-ink);background:var(--test-canvas)}
  .test-shell{width:min(100% - 2rem,1200px);margin-inline:auto}
  .test-hero{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(120deg,#1d116b 0%,#3d24a8 47%,#126dcc 100%);color:#fff}
  .test-hero::after{position:absolute;z-index:-1;right:-10%;bottom:-52%;width:55rem;height:55rem;border:1px solid rgb(255 255 255 / .19);border-radius:50%;content:""}
  .test-hero__glow{position:absolute;z-index:-1;border-radius:50%;filter:blur(16px);opacity:.5}.test-hero__glow--one{top:-16rem;right:20%;width:34rem;height:34rem;background:#5b8cff}.test-hero__glow--two{bottom:-18rem;left:-9rem;width:32rem;height:32rem;background:#8d42d8}
  .test-hero__grid{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(26rem,.94fr);align-items:center;gap:clamp(2.5rem,4vw,4rem);min-height:33rem;padding-block:clamp(2.75rem,4.8vw,4.2rem)}
  .test-hero__copy{max-width:39rem}.test-eyebrow{margin:0;font-family:var(--font-mono);font-size:.84rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.test-hero__copy>.test-eyebrow{padding-left:.15rem}.test-hero h1{max-width:17ch;margin:1rem 0 0;font-size:clamp(2.75rem,4.7vw,4.4rem);font-weight:600;letter-spacing:-.045em;line-height:1.01}.test-hero__lead{max-width:34rem;margin:1.75rem 0 0;color:rgb(255 255 255 / .82);font-size:clamp(1rem,1.35vw,1.16rem);line-height:1.65}
  .test-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.4rem;margin-top:2rem}.test-button{display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--test-blue);background:var(--test-blue);padding:.82rem 1.35rem;color:#fff;font:inherit;font-weight:700;line-height:1;text-decoration:none;cursor:pointer;transition:background .16s ease,border-color .16s ease,transform .16s ease}.test-button:hover{border-color:#0e55bb;background:#0e55bb;transform:translateY(-1px)}.test-button--light{border-color:#fff;background:#fff;color:#1c2380}.test-button--light:hover{border-color:#eef4ff;background:#eef4ff}.test-button--small{padding:.6rem 1rem;font-size:.88rem}.test-link{display:inline-flex;align-items:center;gap:.45rem;color:var(--test-blue);font-weight:700;text-decoration:none}.test-link span{transition:transform .16s ease}.test-link:hover span{transform:translateX(.2rem)}.test-link--light{color:#fff}
  .test-hero__visual{position:relative;width:88%;max-width:30rem;justify-self:end;overflow:hidden;border:2px solid #fff;border-radius:1.2rem;background:#fff;padding:2.35rem .55rem .55rem;box-shadow:0 42px 80px -34px rgb(0 0 0 / .64);transform:perspective(1200px) rotateY(-4deg) rotateX(1deg)}.test-hero__visual-bar{position:absolute;top:0;right:0;left:0;display:flex;height:2.35rem;align-items:center;padding:0 1rem;background:#fff}.test-hero__visual-bar span{display:flex;gap:.34rem}.test-hero__visual-bar i{display:block;width:.52rem;height:.52rem;border-radius:50%;background:#ccd6e6}.test-hero__image{display:block;width:100%;height:auto;border-radius:.75rem;background:#fff}.test-hero__scroll-cue{position:absolute;z-index:4;bottom:.9rem;left:50%;display:flex;align-items:center;gap:.55rem;border:1px solid rgb(255 255 255 / .65);border-radius:999px;background:rgb(255 255 255 / .95);padding:.62rem 1rem;color:#1c2380;font-size:.78rem;font-weight:750;letter-spacing:.015em;text-decoration:none;box-shadow:0 12px 30px -16px rgb(0 0 0 / .65);transform:translateX(-50%)}.test-hero__scroll-cue svg{width:1.05rem;height:1.05rem;fill:none;stroke:#1769e0;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;animation:scroll-cue-bounce 1.45s ease-in-out infinite}.test-hero__scroll-cue:hover{background:#fff}.test-hero__scroll-cue:focus-visible{outline:3px solid #fff;outline-offset:3px}@keyframes scroll-cue-bounce{0%,100%{transform:translateY(-1px)}50%{transform:translateY(3px)}}
  .overview-stage{position:relative;isolation:isolate;overflow:hidden;background:var(--test-canvas)}.overview-stage>.overview-backdrop{z-index:0}.overview-stage>.overview-backdrop .overview-backdrop__arc{top:-4rem;right:-19rem;bottom:auto}.overview-stage>.overview-backdrop .overview-backdrop__tiles{top:2.5rem}.overview-stage>.test-scroll-gate,.overview-stage>#overview{position:relative;z-index:1;background:transparent}.test-scroll-gate{height:max(5.5rem,calc(100svh - 37rem));overflow:hidden;transition:height .38s cubic-bezier(.22,1,.36,1)}.test-scroll-gate .test-hero__scroll-cue{top:40%;bottom:auto;flex-direction:column;gap:.3rem;border:0;border-radius:0;background:transparent;padding:.65rem 1.5rem;color:#1769e0;font-size:1.1rem;box-shadow:none;transform:translate(-50%,-50%);transition:opacity .2s ease,transform .2s ease}.test-scroll-gate .test-hero__scroll-cue svg{width:1.45rem;height:1.45rem}.test-scroll-gate.is-dismissed{height:0}.test-scroll-gate.is-dismissed .test-hero__scroll-cue{opacity:0;transform:translate(-50%,-65%);pointer-events:none}
  .test-section{scroll-margin-top:5rem;padding-block:clamp(4.8rem,8vw,7.4rem)}#overview{position:relative;isolation:isolate;overflow:hidden;padding-top:clamp(2rem,3vw,2.5rem);background:var(--test-canvas)}#overview>.test-shell{position:relative;z-index:1}.overview-backdrop{position:absolute;z-index:0;inset:0;overflow:hidden;pointer-events:none}.overview-backdrop__arc{position:absolute;top:3.5rem;right:-21rem;width:39rem;height:39rem;border:5.5rem solid rgb(105 201 245 / .18);border-radius:50%;box-shadow:0 0 0 1px rgb(23 105 224 / .05)}.overview-backdrop__tiles{position:absolute;top:10.5rem;left:-8rem;width:22rem;height:14rem;background:linear-gradient(90deg,rgb(92 45 193 / .09) 0 46%,transparent 46% 51%,rgb(23 105 224 / .08) 51% 100%),linear-gradient(180deg,transparent 0 55%,rgb(157 214 255 / .12) 55% 100%);transform:rotate(-7deg)}.test-section--white,.test-section--tint,.test-section--lavender,.test-section--dark,.test-section--ink{background:var(--test-canvas);color:var(--test-ink)}.test-section__intro{max-width:46rem}.test-section__intro--wide{max-width:57rem}.test-eyebrow--blue{color:var(--test-blue)}.test-section__intro h2,.contact-card h2{margin:.8rem 0 0;color:#15285d;font-size:clamp(2.35rem,4.6vw,4.2rem);font-weight:650;letter-spacing:-.055em;line-height:1}.test-section__intro>p:last-child,.contact-card>div>p:last-child{max-width:52rem;margin:1.3rem 0 0;color:var(--test-soft);font-size:1.13rem;line-height:1.65}.test-section__intro--dark h2{color:#15285d}.test-section__intro--dark>p:last-child{color:var(--test-soft)}#overview .test-section__intro{margin-inline:auto;text-align:center}#overview .test-section__intro>p:last-child{margin-right:auto;margin-left:auto}
  .test-section{position:relative;isolation:isolate;overflow:hidden}.test-section>.test-shell{position:relative;z-index:1}.overview-backdrop__arc{top:auto;right:-19rem;bottom:0;width:38rem;height:38rem;border-color:rgb(66 175 232 / .25);box-shadow:0 0 0 2.25rem rgb(95 61 196 / .035)}.overview-backdrop__tiles{top:12rem;background:linear-gradient(90deg,rgb(92 45 193 / .12) 0 46%,transparent 46% 51%,rgb(23 105 224 / .11) 51% 100%),linear-gradient(180deg,transparent 0 55%,rgb(93 197 240 / .17) 55% 100%)}
  #outcomes::before,#outcomes::after{display:none}
  #interactive-demo::before{position:absolute;z-index:0;top:2rem;right:-13rem;width:29rem;height:29rem;border:4rem solid rgb(74 183 232 / .1);border-radius:50%;content:"";pointer-events:none}#interactive-demo::after{position:absolute;z-index:0;bottom:4.5rem;left:-5rem;width:16rem;height:10rem;background:linear-gradient(90deg,rgb(92 45 193 / .09) 0 55%,transparent 55% 62%,rgb(255 190 58 / .14) 62% 100%),linear-gradient(180deg,transparent 0 50%,rgb(74 183 232 / .13) 50% 100%);content:"";transform:rotate(-7deg);pointer-events:none}
  #specification,#proof{overflow:clip}
  #specification::before{position:absolute;z-index:0;top:1.5rem;right:-14rem;width:29rem;height:29rem;border:4rem solid rgb(74 183 232 / .11);border-radius:50%;content:"";pointer-events:none}#specification::after{position:absolute;z-index:0;top:.7rem;left:max(1rem,calc((100% - 1200px)/2));width:6.5rem;height:.4rem;background:linear-gradient(90deg,#1769e0 0 52%,#5c2dc1 52% 82%,#ffd466 82% 100%);content:"";opacity:.38;pointer-events:none}
  #proof::before{position:absolute;z-index:0;top:5rem;right:-9rem;width:21rem;height:21rem;border:2.25rem solid rgb(92 45 193 / .07);content:"";transform:rotate(12deg);pointer-events:none}#proof::after{position:absolute;z-index:0;top:1.25rem;left:max(1rem,calc((100% - 1200px)/2));width:6.5rem;height:.4rem;background:linear-gradient(90deg,#1769e0 0 43%,#4ab7e8 43% 72%,#ffd466 72% 100%);content:"";opacity:.45;pointer-events:none}
  #book-a-call::before{position:absolute;z-index:0;bottom:-12rem;left:-10rem;width:26rem;height:26rem;border:3.5rem solid rgb(74 183 232 / .1);border-radius:50%;content:"";pointer-events:none}#book-a-call::after{position:absolute;z-index:0;top:3.5rem;right:-4rem;width:13rem;height:8rem;background:linear-gradient(90deg,rgb(92 45 193 / .09) 0 62%,transparent 62% 68%,rgb(255 190 58 / .17) 68% 100%);content:"";transform:rotate(-8deg);pointer-events:none}
