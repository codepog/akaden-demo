<script>
  const inlineDemo = document.querySelector<HTMLElement>('[data-demo-embed]');
  const inlineDemoPlay = inlineDemo?.querySelector<HTMLButtonElement>('[data-demo-play]');
  const inlineDemoFrame = inlineDemo?.querySelector<HTMLIFrameElement>('iframe[data-src]');

  inlineDemoPlay?.addEventListener('click', () => {
    if (!inlineDemo || !inlineDemoFrame) return;
    const currentSource = inlineDemoFrame.getAttribute('src');
    if (!currentSource || currentSource === 'about:blank') {
      inlineDemoFrame.src = inlineDemoFrame.dataset.src ?? '';
    }
    inlineDemoFrame.hidden = false;
    inlineDemo.classList.add('is-playing');
    window.requestAnimationFrame(() => inlineDemoFrame.focus({ preventScroll: true }));
  });

  const scrollGate = document.querySelector<HTMLElement>('[data-scroll-gate]');
  const dismissScrollGate = () => {
    if (window.scrollY <= 12) return;
    scrollGate?.classList.add('is-dismissed');
    window.removeEventListener('scroll', dismissScrollGate);
  };
  window.addEventListener('scroll', dismissScrollGate, { passive: true });
  dismissScrollGate();

  const contactSection = document.querySelector<HTMLElement>('#form');
  const scrollToContact = (behavior: ScrollBehavior = 'smooth') => {
    if (!contactSection) return;
    scrollGate?.classList.add('is-dismissed');
    if (scrollGate) {
      scrollGate.style.transition = 'none';
      scrollGate.style.height = '0px';
      scrollGate.getBoundingClientRect();
    }
    window.requestAnimationFrame(() => {
      contactSection.scrollIntoView({ behavior, block: 'start' });
    });
  };

  document.querySelectorAll<HTMLAnchorElement>('a[href$="#form"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      window.history.pushState(null, '', '#form');
      scrollToContact();
    });
  });

  if (window.location.hash === '#form') scrollToContact('auto');

  const scrollRevealGroups = [
    { selector: '#overview .test-section__intro', stagger: 0, startDelay: 0 },
    { selector: '#outcomes .test-section__intro, .changes-list, .changes-layout > .connected-stack', stagger: 95, startDelay: 0 },
    { selector: '#interactive-demo .test-section__intro, .demo-embed', stagger: 100, startDelay: 0 },
    { selector: '#specification .case-study-card', stagger: 0, startDelay: 0 },
    { selector: '#proof .test-section__intro, .stat-grid article', stagger: 70, startDelay: 0 },
  ];
  const scrollRevealElements = new Set<HTMLElement>();

  scrollRevealGroups.forEach(({ selector, stagger, startDelay }) => {
    document.querySelectorAll<HTMLElement>(selector).forEach((element, index) => {
      element.dataset.scrollReveal = '';
      element.style.setProperty('--scroll-reveal-delay', `${Math.min(startDelay + index * stagger, 420)}ms`);
      scrollRevealElements.add(element);
    });
  });

  document.documentElement.classList.add('scroll-reveal-enabled');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    scrollRevealElements.forEach((element) => element.classList.add('is-scroll-revealed'));
  } else {
    const scrollRevealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-scroll-revealed');
        scrollRevealObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: .12 });

    scrollRevealElements.forEach((element) => scrollRevealObserver.observe(element));
  }
</script>
