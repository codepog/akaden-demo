---
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
// Astro's local development server serves page routes without the static .html
// extension; GitHub Pages serves the built demo.html file. Keep the iframe valid
// in both places so the product tour is always embedded rather than a broken link.
const demoUrl = import.meta.env.DEV ? `${basePath}demo` : `${basePath}demo.html`;
---

<!-- The supplied workspace demo stays in this page, fully interactive. -->
<section id="product-tour" class="border-b border-rule bg-ground scroll-mt-20">
  <div class="mx-auto max-w-[1440px] px-4 py-16 sm:px-6 sm:py-20">
    <div class="max-w-[52ch]">
      <p class="u-label text-blue">Product tour</p>
      <h2 class="u-h2 tour-title mt-4 text-blue-deep">See the workflow in action.</h2>
      <p class="u-lead mt-4">
        This recorded demo follows a fictional campus communications team that needs a nightly file of student contact details. See the request become a specification, then a pipeline the team can review, run, and change with confidence.
      </p>
      <p class="tour-skill-note">Akaden brings the right supporting tools into each phase. Developers can inspect and adjust them when they need to.</p>
    </div>

    <div class="workspace-preview mt-8 min-w-0">
      <iframe
        src={demoUrl}
        title="Interactive Akaden workspace demo"
        loading="lazy"
        data-workspace-demo
      ></iframe>
    </div>
    <p class="mt-3 text-[0.8125rem] text-ink-soft">
      Recorded walkthrough. No live tenant, student data, or production changes.
    </p>
  </div>
</section>

<style>
  .workspace-preview {
    overflow: hidden;
    border: 1px solid var(--color-rule-strong);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 20px 50px rgba(0, 0, 0, .28);
  }
  .tour-title{white-space:nowrap;font-size:clamp(1.6rem,3.1vw,2.75rem);}
  .tour-skill-note{margin:1rem 0 0;border-left:3px solid var(--color-agent);padding-left:.8rem;color:var(--color-ink-soft);font-size:.95rem;line-height:1.5;}
  .workspace-preview iframe {
    display: block;
    width: 100%;
    height: clamp(40rem, 59vw, 50rem);
    min-height: 0;
    border: 0;
    background: #fff;
  }
  @media (max-width: 560px){.tour-title{white-space:normal;}}
</style>

<script>
  const workspaceDemo = document.querySelector<HTMLIFrameElement>('[data-workspace-demo]');

  function fitDemoToContents() {
    const documentInFrame = workspaceDemo?.contentDocument;
    if (!workspaceDemo || !documentInFrame) return;
    const height = Math.max(
      documentInFrame.body.scrollHeight,
      documentInFrame.documentElement.scrollHeight,
    );
    workspaceDemo.style.height = `${height}px`;
  }

  workspaceDemo?.addEventListener('load', () => {
    fitDemoToContents();
    const documentInFrame = workspaceDemo.contentDocument;
    if (!documentInFrame?.body) return;
    new ResizeObserver(fitDemoToContents).observe(documentInFrame.body);
  });
</script>
