---
import { proof, benefits } from '../data/site';
---
<section id="proof" class="border-b border-rule bg-paper scroll-mt-20">
  <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 sm:py-28">
    <p class="u-label text-blue">{proof.eyebrow}</p>
    <h2 class="u-h2 mt-4 text-blue-deep">{proof.headline}</h2>
    <p class="u-lead u-measure mt-5">{proof.lead}</p>

    <dl class="mt-12 grid gap-8 sm:grid-cols-3">
      {proof.stats.map((s) => (
        <div class="border-t-2 border-blue pt-5">
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="block font-mono text-[2.5rem] font-medium leading-none tracking-tight text-blue-deep tabular-nums">
              {s.figure}
            </span>
            <span class="mt-3 block max-w-[30ch] text-[0.9375rem] text-ink-soft">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>

    <!-- Partnership evidence, deliberately NOT filed as a product endorsement.
         The quote names Modernization Studio, a different product (review finding 11). -->
    <figure class="mt-16 max-w-[52rem] border-l-2 border-blue pl-6 sm:pl-8">
      <p class="u-label text-ink-soft">{proof.partnership.label}</p>
      <blockquote class="mt-4">
        <p class="text-[1.125rem] leading-relaxed text-ink">“{proof.partnership.quote}”</p>
      </blockquote>
      <figcaption class="mt-4 text-[0.9375rem] text-ink-soft">
        <span class="font-semibold text-ink">{proof.partnership.attribution}</span>
        — {proof.partnership.role}
      </figcaption>
    </figure>

    <p class="mt-8 max-w-[52rem] text-[0.9375rem] text-ink-soft">{proof.badgeNote}</p>

    {proof.partnership.pendingPermission && (
      <p class="mt-4 max-w-[52rem] rounded-md border border-dashed border-rule-strong bg-ground px-4 py-3 font-mono text-[0.8125rem] text-ink-soft">
        NEEDS-SOURCE — permission to reuse this quote, scoped to this page and this product.
        Quote is public on abcloudz.com and refers to Modernization Studio, not Akaden.
      </p>
    )}

    <div class="mt-20 border-t border-rule pt-14">
      <p class="u-label text-blue">{benefits.eyebrow}</p>
      <h3 class="u-h2 u-measure mt-4 text-blue-deep">{benefits.headline}</h3>
      <div class="mt-12 grid gap-10 sm:grid-cols-3">
        {benefits.items.map((b) => (
          <div>
            <h4 class="u-h3 text-blue-deep">{b.title}</h4>
            <p class="mt-3 text-ink-soft">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
