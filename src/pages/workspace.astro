---
import '../styles/global.css';
import MockIDE from '../components/ide/MockIDE.astro';
import { steps } from '../data/ide';
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Akaden Workspace Demo</title>
    <meta name="description" content="Walk a customer requirement through the Akaden SDLC, from inputs to a running pipeline." />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${basePath}brands/akaden.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,900&family=JetBrains+Mono:wght@400;500;700&display=swap" />
  </head>
  <body class="page">
    <!-- Keep the controls in DOM before the workspace so its script can bind to them. -->
    <aside class="coach-callout" data-callout aria-live="polite" aria-atomic="true" hidden>
      <p data-callout-text></p>
      <div class="coach-actions">
        <button type="button" class="coach-next" data-callout-next>Upload request</button>
      </div>
    </aside>

    <nav class="guide" data-guide aria-label="Walkthrough controls">
      <div class="guide-heading">
        <span class="guide-heading__progress" data-guide-progress>1 of 10</span>
        <strong class="guide-heading__title" data-guide-title>Prepare workspace</strong>
        <small data-guide-status>Interactive simulation</small>
      </div>
      <ol class="g-dots" data-g-dots>
        {steps.map((s) => (
          <li><button type="button" data-dot={s.n} aria-label={`Step ${s.n}: ${s.title}`}></button></li>
        ))}
      </ol>
    </nav>

    <div class="frame"><MockIDE /></div>
  </body>
</html>

<style>
  .page{background:var(--color-paper);margin:0;display:grid;grid-template-areas:"guide" "frame";grid-template-rows:auto minmax(0,1fr);height:100dvh;overflow:hidden;}

  .frame{
    grid-area:frame;
    margin:0;
    min-height:0;
    border:0;border-radius:0;overflow:hidden;
    box-shadow:none;
    background:#FAFCFF;
  }

  /* ---------- walkthrough control bar ---------- */
  .guide{
    grid-area:guide;
    margin:0;
    background:var(--color-ground);
    border:0;border-bottom:1px solid var(--color-rule-strong);
    border-radius:0;
    padding:10px clamp(12px,2.4vw,20px);
  }
  .g-dots{list-style:none;display:flex;gap:6px;margin:0;padding:0;}
  .guide-heading{display:flex;align-items:center;gap:7px;margin-bottom:9px;font-size:12px;color:#205eac}.guide-heading__progress,.guide-heading__title{font-weight:700}.guide-heading__progress::before{content:"Step "}.guide-heading__progress::after{content:" ·"}.guide-heading small{margin-left:auto;font-size:10px;font-weight:500;color:#68707e}
  .g-dots li{flex:1;}
  .g-dots button{
    display:block;width:100%;height:4px;border:0;padding:0;border-radius:2px;
    background:var(--color-rule);cursor:pointer;transition:background-color 180ms,transform 180ms;
  }
  .g-dots button.past{background:#9CC0A8;}
  .g-dots button.on{background:var(--color-blue);transform:scaleY(1.65);}
  .g-dots button:hover{background:var(--color-rule-strong);}
  .g-dots button:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}

  /* The guide is only navigation. The explanation lives beside the product control it describes. */
  .coach-callout{
    position:fixed;z-index:80;width:min(21rem,calc(100vw - 2rem));
    border:1px solid #B9CDEA;border-radius:12px;background:#F3F7FD;
    box-shadow:0 18px 40px rgba(0,33,99,.2);padding:10px 17px 12px;
    color:var(--color-ink);pointer-events:auto;
  }
  .coach-callout[hidden]{display:none;}
  .coach-callout::after{content:"";position:absolute;width:0;height:0;border:10px solid transparent;}
  .coach-callout[data-side="right"]::after{left:-20px;top:var(--callout-arrow-y,50%);transform:translateY(-50%);border-right-color:#F3F7FD;}
  .coach-callout[data-side="left"]::after{right:-20px;top:var(--callout-arrow-y,50%);transform:translateY(-50%);border-left-color:#F3F7FD;}
  .coach-callout[data-side="bottom"]::after{top:-20px;left:var(--callout-arrow-x,50%);transform:translateX(-50%);border-bottom-color:#F3F7FD;}
  .coach-callout[data-side="top"]::after{bottom:-20px;left:var(--callout-arrow-x,50%);transform:translateX(-50%);border-top-color:#F3F7FD;}
  .coach-callout p:last-child{margin:10px 0 0;color:var(--color-ink-soft);font-size:.88rem;line-height:1.48;}
  .coach-actions{margin-top:10px;border-top:1px solid #D3DFEF;padding-top:10px;}
  .coach-next{width:100%;min-height:34px;border:1px solid var(--color-blue);border-radius:7px;background:var(--color-blue);padding:7px 11px;color:#fff;font:inherit;font-size:.8rem;font-weight:700;cursor:pointer;transition:background-color 140ms,border-color 140ms;}
  .coach-next:hover:not(:disabled){border-color:var(--color-blue-deep);background:var(--color-blue-deep);}.coach-next:disabled{opacity:.5;cursor:not-allowed;}.coach-next:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}

  @media (max-width:620px){
    .page{
      grid-template-areas:"guide" "coach" "frame";
      grid-template-rows:auto auto minmax(0,1fr);
      height:auto;
      min-height:100dvh;
    }
    .frame{
      position:relative;
      width:100%;
      height:clamp(15.25rem,66vw,18rem);
      align-self:start;
      overflow:hidden;
      border-top:1px solid #d8e3f1;
      background:#f7faff;
      box-shadow:inset 0 16px 30px -30px rgb(0 33 99 / .55);
    }
    .frame::after{
      position:absolute;
      z-index:4;
      inset:0;
      box-shadow:inset 0 0 22px rgb(18 53 112 / .1);
      content:"";
      pointer-events:none;
    }
    .g-dots{gap:4px;}
    .guide{position:relative;z-index:6;padding:10px 12px 9px;}
    .guide-heading{display:grid;grid-template-columns:auto minmax(0,1fr);gap:2px 10px;margin-bottom:9px;}
    .guide-heading__progress{grid-column:1;color:#1769e0;font-family:var(--font-mono);font-size:.7rem;letter-spacing:.045em;white-space:nowrap;}
    .guide-heading__progress::before,.guide-heading__progress::after{content:""}
    .guide-heading__title{grid-column:2;color:#15285d;font-size:.98rem;line-height:1.2;}
    .guide-heading small{display:none;}
    .coach-callout{
      position:relative!important;
      inset:auto!important;
      grid-area:coach;
      box-sizing:border-box;
      width:100%;
      max-width:none;
      border-width:0 0 1px;
      border-radius:0;
      background:#fff;
      display:block;
      min-height:6.3rem;
      padding:12px 12px 13px;
      box-shadow:0 10px 26px rgb(0 33 99 / .1);
    }
    .coach-callout::after{display:none;}
    .coach-callout p:last-child{margin:0;color:#344661;font-size:.94rem;line-height:1.42;}
    .coach-actions{position:fixed;z-index:95;right:10px;bottom:10px;margin:0;border:0;padding:0;}
    .coach-next{width:auto;max-width:9.5rem;min-width:5.1rem;min-height:42px;padding:8px 13px;box-shadow:0 10px 24px rgb(17 75 156 / .28);}
    .frame :global(.ide){
      position:absolute;
      top:0;
      left:0;
      width:100%;
      height:100%;
      grid-template-rows:minmax(0,1fr)!important;
      pointer-events:none;
      will-change:opacity;
      transition:opacity .2s ease;
    }
    .frame :global(.ide .menubar){display:none!important;}
    .frame :global(.ide .rail),
    .frame :global(.ide .side),
    .frame :global(.ide .ed),
    .frame :global(.ide .chat){display:none!important;}
    .frame :global(.ide[data-mobile-pane="side"]){grid-template-columns:48px minmax(0,1fr)!important;grid-template-areas:"rail side"!important;}
    .frame :global(.ide[data-mobile-pane="side"] .rail),
    .frame :global(.ide[data-mobile-pane="side"] .side){display:flex!important;}
    .frame :global(.ide[data-mobile-pane="ed"]){grid-template-columns:minmax(0,1fr)!important;grid-template-areas:"ed"!important;}
    .frame :global(.ide[data-mobile-pane="ed"] .ed){display:flex!important;}
    .frame :global(.ide[data-mobile-pane="chat"]){grid-template-columns:minmax(0,1fr)!important;grid-template-areas:"chat"!important;}
    .frame :global(.ide[data-mobile-pane="chat"] .chat){display:flex!important;}
    .frame :global(.ide[data-mobile-pane="side"] .side){animation:mobilePaneFromLeft .42s cubic-bezier(.22,1,.36,1) both;}
    .frame :global(.ide[data-mobile-pane="ed"] .ed){animation:mobilePaneFromCenter .38s cubic-bezier(.22,1,.36,1) both;}
    .frame :global(.ide[data-mobile-pane="chat"] .chat){animation:mobilePaneFromRight .42s cubic-bezier(.22,1,.36,1) both;}
    @keyframes mobilePaneFromLeft{from{opacity:.45;transform:translateX(-1.5rem)}to{opacity:1;transform:none}}
    @keyframes mobilePaneFromCenter{from{opacity:.45;transform:translateY(.65rem)}to{opacity:1;transform:none}}
    @keyframes mobilePaneFromRight{from{opacity:.45;transform:translateX(1.5rem)}to{opacity:1;transform:none}}
  }
  @media (prefers-reduced-motion: reduce){
    .g-dots button,.coach-next{transition:none;}
  }
</style>

<script>
  const workspaceFrame = document.querySelector<HTMLElement>('.frame');
  const workspaceIde = workspaceFrame?.querySelector<HTMLElement>('[data-ide]');
  const mobileWorkspace = window.matchMedia('(max-width:620px)');
  let mobileTarget: HTMLElement | null = null;
  let mobilePane: 'side' | 'ed' | 'chat' = 'side';
  let mobileReframeToken = 0;

  const revealTargetWithinPane = (target: HTMLElement | null, pane: HTMLElement | null) => {
    if (!target || !pane || !pane.contains(target)) return;
    let scrollParent = target.parentElement;
    while (scrollParent && scrollParent !== pane) {
      const overflow = window.getComputedStyle(scrollParent).overflowY;
      if ((overflow === 'auto' || overflow === 'scroll') && scrollParent.scrollHeight > scrollParent.clientHeight) break;
      scrollParent = scrollParent.parentElement;
    }
    if (!scrollParent) return;
    const targetRect = target.getBoundingClientRect();
    const parentRect = scrollParent.getBoundingClientRect();
    scrollParent.scrollTo({
      top: scrollParent.scrollTop + targetRect.top - parentRect.top - (parentRect.height - targetRect.height) / 2,
      behavior: 'smooth',
    });
  };

  const frameMobileWorkspace = (target = mobileTarget, pane = mobilePane) => {
    if (!workspaceFrame || !workspaceIde) return;
    if (!mobileWorkspace.matches) {
      workspaceIde.style.removeProperty('opacity');
      delete workspaceIde.dataset.mobilePane;
      return;
    }
    const token = ++mobileReframeToken;
    workspaceIde.style.opacity = '.45';
    workspaceIde.dataset.mobilePane = pane;
    window.requestAnimationFrame(() => {
      if (token !== mobileReframeToken) return;
      workspaceIde.style.opacity = '1';
      const paneElement = workspaceIde.querySelector<HTMLElement>(`.${pane}`);
      window.setTimeout(() => revealTargetWithinPane(target, paneElement), 80);
    });
  };

  const workspaceObserver = workspaceFrame && 'ResizeObserver' in window
    ? new ResizeObserver(() => frameMobileWorkspace())
    : null;
  if (workspaceFrame) workspaceObserver?.observe(workspaceFrame);
  mobileWorkspace.addEventListener('change', () => frameMobileWorkspace());
  window.addEventListener('akaden-step-rendered', (event) => {
    const detail = (event as CustomEvent<{
      target?: HTMLElement | null;
      mobilePane?: 'side' | 'ed' | 'chat';
    }>).detail;
    mobileTarget = detail?.target ?? null;
    mobilePane = detail?.mobilePane ?? 'ed';
    frameMobileWorkspace(mobileTarget, mobilePane);
  });
  window.addEventListener('load', () => frameMobileWorkspace(), { once: true });
  window.requestAnimationFrame(() => {
    mobileTarget = workspaceIde?.querySelector<HTMLElement>('.is-target') ?? null;
    frameMobileWorkspace();
  });
</script>
