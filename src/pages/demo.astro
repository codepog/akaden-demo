---
import '../styles/global.css';
import MockIDE from '../components/ide/MockIDE.astro';
import { steps } from '../data/ide';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Akaden Workspace Demo</title>
    <meta name="description" content="Walk a customer requirement through the Akaden SDLC, from inputs to a running pipeline." />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,900&family=JetBrains+Mono:wght@400;500;700&display=swap" />
  </head>
  <body class="page">
    <!-- Keep the controls in DOM before the workspace so its script can bind to them. -->
    <aside class="coach-callout" data-callout aria-live="polite" aria-atomic="true" hidden>
      <p class="coach-kicker" data-callout-count>Step 1 of 8</p>
      <h1 data-callout-title>Upload request</h1>
      <p data-callout-text></p>
    </aside>

    <nav class="guide" data-guide aria-label="Walkthrough controls">
      <ol class="g-dots" data-g-dots>
        {steps.map((s) => (
          <li><button type="button" data-dot={s.n} aria-label={`Step ${s.n}: ${s.title}`}></button></li>
        ))}
      </ol>
      <div class="g-row">
        <div class="g-copy">
          <p class="g-head"><span data-g-count>Step 1 of 8</span> <span aria-hidden="true">·</span> <b data-g-title>Upload request</b></p>
        </div>
        <div class="g-btns">
          <button type="button" class="g-btn" data-g-prev>Back</button>
          <button type="button" class="g-btn primary" data-g-next>Next</button>
        </div>
      </div>
    </nav>

    <div class="frame"><MockIDE /></div>
  </body>
</html>

<style>
  .page{background:var(--color-paper);margin:0;display:grid;grid-template-areas:"frame" "guide";grid-template-rows:minmax(0,1fr) auto;height:clamp(40rem,59vw,50rem);overflow:hidden;}

  .frame{
    grid-area:frame;
    margin:0;
    min-height:0;
    border:0;border-radius:0;overflow:hidden;
    box-shadow:none;
    background:#FAFCFF;
  }

  /* ---------- walkthrough control bar ---------- */
  .guide{
    grid-area:guide;
    margin:0;
    background:var(--color-ground);
    border:0;border-top:1px solid var(--color-rule-strong);
    border-radius:0;
    padding:7px clamp(12px,2.4vw,20px) 8px;
    min-height:94px;
  }
  .g-dots{list-style:none;display:flex;gap:6px;margin:0 0 6px;padding:0;}
  .g-dots li{flex:1;}
  .g-dots button{
    display:block;width:100%;height:4px;border:0;padding:0;border-radius:2px;
    background:var(--color-rule);cursor:pointer;transition:background-color 180ms,transform 180ms;
  }
  .g-dots button.past{background:#9CC0A8;}
  .g-dots button.on{background:var(--color-blue);transform:scaleY(1.65);}
  .g-dots button:hover{background:var(--color-rule-strong);}
  .g-dots button:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}

  .g-row{display:flex;align-items:center;gap:20px;}
  .g-copy{flex:1;min-width:0;min-height:50px;}
  .g-head{
    margin:0;font-family:var(--font-mono);font-size:11px;letter-spacing:.09em;
    text-transform:uppercase;color:var(--color-ink-soft);
  }
  .g-head b{color:var(--color-blue);font-weight:700;}
  .g-btns{display:flex;gap:10px;flex:0 0 18rem;margin-left:auto;}
  .g-btn{
    border:1px solid var(--color-rule-strong);background:var(--color-ground);color:var(--color-ink);
    height:39px;border-radius:7px;padding:8px 14px;font:inherit;font-size:.8125rem;font-weight:600;cursor:pointer;
    white-space:nowrap;transition:background-color 140ms,border-color 140ms;
  }
  .g-btn:hover:not(:disabled){border-color:var(--color-ink);}
  .g-btn:disabled{opacity:.4;cursor:not-allowed;}
  .g-btn.primary{background:var(--color-blue);border-color:var(--color-blue);color:#fff;}
  .g-btn.primary{width:12.5rem;}
  .g-btn.primary:hover{background:var(--color-blue-deep);border-color:var(--color-blue-deep);}
  .g-btn:focus-visible{outline:2px solid var(--color-ink);outline-offset:2px;}
  /* the gate reads differently from the rest of the spine */
  .guide[data-step="3"] .g-btn.primary{box-shadow:0 0 0 4px rgba(33,83,196,.18);}

  /* The guide is only navigation. The explanation lives beside the product control it describes. */
  .coach-callout{
    position:fixed;z-index:80;width:min(21rem,calc(100vw - 2rem));
    border:1px solid #B9CDEA;border-radius:12px;background:#F3F7FD;
    box-shadow:0 18px 40px rgba(0,33,99,.2);padding:15px 17px;
    color:var(--color-ink);pointer-events:none;
  }
  .coach-callout[hidden]{display:none;}
  .coach-callout::after{content:"";position:absolute;width:0;height:0;border:10px solid transparent;}
  .coach-callout[data-side="right"]::after{left:-20px;top:var(--callout-arrow-y,50%);transform:translateY(-50%);border-right-color:#F3F7FD;}
  .coach-callout[data-side="left"]::after{right:-20px;top:var(--callout-arrow-y,50%);transform:translateY(-50%);border-left-color:#F3F7FD;}
  .coach-callout[data-side="bottom"]::after{top:-20px;left:var(--callout-arrow-x,50%);transform:translateX(-50%);border-bottom-color:#F3F7FD;}
  .coach-callout[data-side="top"]::after{bottom:-20px;left:var(--callout-arrow-x,50%);transform:translateX(-50%);border-top-color:#F3F7FD;}
  .coach-kicker{margin:0 0 5px;font-family:var(--font-mono);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--color-blue);}
  .coach-callout h1{margin:0;color:var(--color-blue-deep);font-size:1.05rem;line-height:1.2;letter-spacing:-.015em;}
  .coach-callout p:last-child{margin:7px 0 0;color:var(--color-ink-soft);font-size:.88rem;line-height:1.48;}

  @media (max-width:620px){
    .page{height:100dvh;}
    .g-row{gap:10px;}
    .g-copy{min-height:0;}
    .g-btns{flex:0 1 auto;margin-left:auto;}
    .g-btn{height:auto;padding:8px 10px;white-space:normal;min-width:0;}
    .g-btn.primary{width:auto;}
    .g-btn[data-g-prev]{flex:0 0 auto;}
    .g-btn[data-g-next]{flex:1 1 auto;}
    .g-dots{gap:4px;}
    .coach-callout{width:min(19rem,calc(100vw - 1.5rem));padding:13px 14px;}
  }
  @media (prefers-reduced-motion: reduce){
    .g-dots button,.g-btn{transition:none;}
  }
</style>
