---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import EngineerAgentDiagram from '../components/EngineerAgentDiagram.astro';
import { benefits, hero, install, proof } from '../data/site';
import { changeRequest, stages } from '../data/walkthrough';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (name: string) => `${basePath}${name}`;
const experimentPage = import.meta.env.DEV ? `${basePath}overview-demo-embed` : `${basePath}overview-demo-embed.html`;
const experimentUrl = `${experimentPage}?intro=always`;
const playlistId = 'PLZHQObOWTQDM4E-dwvbnQTiyKDO-y9T2t';
const playlistUrl = `https://www.youtube.com/embed?listType=playlist&list=${playlistId}&autoplay=1`;

const workflowArt = [
  'workflow-upload.png',
  'workflow-spec-agent.png',
  'workflow-review.png',
  'workflow-build-agent.png',
  'workflow-deploy.png',
];

const changeComparison = {
  oldWay: [
    changeRequest.oldWay,
    'Documentation can drift from the pipeline, while the reason behind the mapping lives in code or institutional memory.',
    'The next engineer has to reconstruct the original intent before they can make a safe change.',
  ],
  newWay: [
    changeRequest.newWay,
    'The reviewed Git diff records the requested change, the decision, and the approval in language the team can check.',
    'Because the specification builds the pipeline, documentation stays current and knowledge remains usable when the team changes.',
  ],
};

const overviewCards = [
  {
    kicker: 'Define',
    title: 'Start with the real request',
    body: 'Bring the business need, institutional context, and constraints into one workspace before anything is generated.',
    href: '#workflow',
    action: 'demo',
    linkLabel: 'Try a demo',
    image: 'hero-demo-preview.png',
    imageAlt: 'Akaden interactive walkthrough showing a guided integration request.',
    imageKind: 'demo',
  },
  {
    kicker: 'Review',
    title: 'Keep decisions with your team',
    body: 'Read, edit, and approve the specification in language your institution can check before the pipeline is built.',
    href: '#specification',
    action: 'video',
    linkLabel: 'Watch a video',
    image: 'agentic-sdlc.png',
    imageAlt: 'Akaden agentic delivery workflow video preview.',
    imageKind: 'video',
  },
  {
    kicker: 'Deliver',
    title: 'Move from plan to pipeline',
    body: 'Generate, test, deploy, and validate against the acceptance criteria recorded in the approved specification.',
    href: '#book-a-call',
    action: 'contact',
    linkLabel: 'Contact us',
    image: 'akaden-app-icon-reference.svg',
    imageAlt: 'Akaden app icon.',
    imageKind: 'brand',
  },
];
---

<Base title="Akaden — Accelerate pipeline development and cloud migration">
  <Nav />

  <main id="main" class="product-test">
    <section class="test-hero" aria-labelledby="test-hero-title">
      <div class="test-hero__glow test-hero__glow--one" aria-hidden="true"></div>
      <div class="test-hero__glow test-hero__glow--two" aria-hidden="true"></div>
      <div class="test-shell test-hero__grid">
        <div class="test-hero__copy">
          <h1 id="test-hero-title">Accelerate pipeline development and cloud migration.</h1>
          <p>{hero.lead}</p>
          <div class="test-actions">
            <a class="test-button test-button--light" href="#demo">View interactive demo</a>
            <a class="test-link test-link--light" href="#book-a-call">Book a call <span aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="test-hero__visual" aria-label="Akaden interactive workspace preview">
          <div class="test-hero__visual-bar">
            <span><i></i><i></i><i></i></span>
            <b>Akaden workspace</b>
          </div>
          <img src={assetPath('hero-demo-preview.png')} alt="Akaden workspace showing a guided integration request." width="2798" height="1302" />
          <div class="test-hero__badge">
            <span>01</span>
            <p><b>Request received</b><small>Ready for specification</small></p>
          </div>
        </div>
      </div>
    </section>

    <section id="overview" class="test-section test-section--white">
      <div class="overview-backdrop" aria-hidden="true">
        <span class="overview-backdrop__arc"></span>
        <span class="overview-backdrop__tiles"></span>
      </div>
      <div class="test-shell">
        <div class="test-section__intro">
          <p class="test-eyebrow test-eyebrow--blue">Overview</p>
          <h2>{hero.thesis}</h2>
          <p>{hero.thesisSub}</p>
        </div>

        <div class="overview-grid">
          {overviewCards.map((card) => (
            <article class="overview-card">
              <button
                class:list={['overview-card__media', `overview-card__media--${card.imageKind}`]}
                type="button"
                data-overview-trigger={card.action}
                aria-expanded="false"
                aria-controls={`overview-${card.action}-panel`}
                aria-label={card.linkLabel}
              >
                <img src={assetPath(card.image)} alt={card.imageAlt} loading="lazy" />
                {card.imageKind === 'video' && (
                  <span class="overview-card__play" aria-hidden="true">
                    <svg viewBox="0 0 48 48"><rect x="4" y="4" width="40" height="40" rx="20" /><path d="m20 16 13 8-13 8Z" /></svg>
                  </span>
                )}
              </button>
              <div class="overview-card__content">
                {card.action ? (
                  <button
                    class="overview-card__action"
                    type="button"
                    data-overview-trigger={card.action}
                    aria-expanded="false"
                    aria-controls={`overview-${card.action}-panel`}
                  >
                    {card.linkLabel} <span aria-hidden="true">→</span>
                  </button>
                ) : (
                  <a class="overview-card__action" href={card.href}>{card.linkLabel} <span aria-hidden="true">→</span></a>
                )}
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <div id="overview-modal-layer" class="overview-panels" aria-live="polite" hidden>
      <section
        id="overview-demo-panel"
        class="overview-panel overview-panel--demo"
        data-overview-panel="demo"
        role="dialog"
        aria-modal="true"
        aria-labelledby="overview-demo-title"
        tabindex="-1"
        hidden
      >
        <header class="overview-panel__header">
          <div>
            <p class="test-eyebrow test-eyebrow--blue">Interactive demo</p>
            <h3 id="overview-demo-title">Try Akaden for yourself.</h3>
            <p>Follow the guided workspace to see how Akaden turns a real business request into a reviewed, deployable pipeline.</p>
          </div>
          <button type="button" class="overview-panel__close" data-overview-close aria-label="Close demo">Close</button>
        </header>
        <div class="overview-panel__body overview-panel__body--demo">
          <iframe data-src={experimentUrl} title="Akaden interactive walkthrough" loading="lazy"></iframe>
        </div>
      </section>

      <section
        id="overview-video-panel"
        class="overview-panel overview-panel--video"
        data-overview-panel="video"
        role="dialog"
        aria-modal="true"
        aria-labelledby="overview-video-title"
        tabindex="-1"
        hidden
      >
        <header class="overview-panel__header">
          <div>
            <p class="test-eyebrow test-eyebrow--blue">{hero.actions.video.eyebrow}</p>
            <h3 id="overview-video-title">{hero.actions.video.headline}</h3>
            <p>{hero.actions.video.body}</p>
          </div>
          <button type="button" class="overview-panel__close" data-overview-close aria-label="Close video">Close</button>
        </header>
        <div class="overview-panel__body overview-panel__body--video">
          <div class="overview-video-frame">
            <iframe
              data-src={playlistUrl}
              title="Akaden video playlist"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </section>

      <section
        id="overview-contact-panel"
        class="overview-panel overview-panel--contact"
        data-overview-panel="contact"
        role="dialog"
        aria-modal="true"
        aria-labelledby="overview-contact-title"
        tabindex="-1"
        hidden
      >
        <header class="overview-panel__header">
          <div>
            <p class="test-eyebrow test-eyebrow--blue">Contact Akaden</p>
            <h3 id="overview-contact-title">Plan your next pipeline with us.</h3>
            <p>{install.lead}</p>
          </div>
          <button type="button" class="overview-panel__close" data-overview-close aria-label="Close contact panel">Close</button>
        </header>
        <div class="overview-panel__body overview-panel__body--contact">
          <div class="overview-contact-actions">
            <a class="test-button" href={install.ctaHref}>{install.ctaLabel}</a>
            <a class="test-link" href={install.secondary.href}>{install.secondary.label} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </div>

    <section id="outcomes" class="test-section test-section--tint">
      <div class="test-shell">
        <div class="test-section__intro test-section__intro--wide">
          <p class="test-eyebrow test-eyebrow--blue">{benefits.eyebrow}</p>
          <h2>Your engineers lead the way. <span class="benefits-headline__agents">Specialized agents move it forward.</span></h2>
        </div>

        <div class="changes-layout">
          <div class="changes-list">
            {benefits.items.map((item, index) => (
              <details class="change-point" name="what-changes" open={index === 0}>
                <summary>
                  <span class="change-point__number">0{index + 1}</span>
                  <h3>{item.title}</h3>
                  <span class="change-point__toggle" aria-hidden="true"></span>
                </summary>
                <div class="change-point__body">
                  <p>{item.body}</p>
                </div>
              </details>
            ))}
          </div>
          <EngineerAgentDiagram />
        </div>
      </div>
    </section>

    <section id="workflow" class="test-section test-section--dark">
      <div class="test-shell">
        <div class="test-section__intro test-section__intro--dark">
          <p class="test-eyebrow test-eyebrow--blue">How it works</p>
          <h2>A clear path from request to pipeline.</h2>
          <p>Akaden brings practical guidance to each stage. Your team sets the direction, reviews the decisions, and stays accountable for the result.</p>
        </div>

        <div class="workflow-tabs" role="tablist" aria-label="Akaden workflow stages">
          {stages.map((stage, index) => (
            <button
              type="button"
              role="tab"
              id={`workflow-tab-${stage.id}`}
              aria-controls={`workflow-panel-${stage.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-workflow-tab={stage.id}
            >
              <span>{stage.n}</span>{stage.title}
            </button>
          ))}
        </div>

        <div class="workflow-stage">
          {stages.map((stage, index) => (
            <article
              id={`workflow-panel-${stage.id}`}
              class="workflow-panel"
              role="tabpanel"
              aria-labelledby={`workflow-tab-${stage.id}`}
              data-workflow-panel={stage.id}
              hidden={index !== 0}
            >
              <div class="workflow-panel__copy">
                <p class="test-eyebrow test-eyebrow--blue">Stage {stage.n}</p>
                <h3>{stage.caption}</h3>
                <p>{stage.body}</p>
                {stage.iterate && <aside>{stage.iterate}</aside>}
              </div>
              <div class="workflow-panel__art">
                <img src={assetPath(workflowArt[index])} alt="" aria-hidden="true" />
                <span>{stage.actor === 'human' ? 'Human decision' : stage.actor === 'agent' ? 'Agent-assisted work' : 'System validation'}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="specification" class="test-section test-section--lavender">
      <div class="test-shell">
        <article class="change-card">
          <div class="change-card__intro">
            <p class="test-eyebrow test-eyebrow--blue">{changeRequest.when}</p>
            <h3>{changeRequest.ask}</h3>
            <p>One routine request reveals the difference between maintaining a pipeline and maintaining a clear, durable specification.</p>
          </div>
          <div class="change-card__comparison">
            <section>
              <h4>Old way</h4>
              <ul>
                {changeComparison.oldWay.map((point) => <li>{point}</li>)}
              </ul>
            </section>
            <section class="change-card__new-way">
              <h4>With Akaden</h4>
              <ul>
                {changeComparison.newWay.map((point) => <li>{point}</li>)}
              </ul>
            </section>
          </div>
        </article>
      </div>
    </section>

    <section id="proof" class="test-section test-section--ink">
      <div class="test-shell">
        <div class="test-section__intro test-section__intro--dark">
          <p class="test-eyebrow test-eyebrow--amber">{proof.eyebrow}</p>
          <h2>{proof.headline}</h2>
          <p>{proof.lead}</p>
        </div>
        <div class="stat-grid">
          {proof.stats.map((stat) => (
            <article><strong>{stat.figure}</strong><span>{stat.label}</span></article>
          ))}
        </div>
        <blockquote class="proof-quote">
          <p>“{proof.partnership.quote}”</p>
          <footer><b>{proof.partnership.attribution}</b><span>{proof.partnership.role}</span></footer>
        </blockquote>
        <p class="proof-note">{proof.badgeNote}</p>
      </div>
    </section>

    <section id="book-a-call" class="test-section test-section--white">
      <div class="test-shell contact-card">
        <div>
          <p class="test-eyebrow test-eyebrow--blue">{install.eyebrow}</p>
          <h2>{install.headline}</h2>
          <p>{install.lead}</p>
        </div>
        <div class="contact-card__actions">
          <a class="test-button" href={install.ctaHref}>{install.ctaLabel}</a>
          <a class="test-link" href={install.secondary.href}>{install.secondary.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  :global(html){scroll-behavior:smooth}
  .product-test{--test-blue:#1769e0;--test-indigo:#281489;--test-purple:#5c2dc1;--test-ink:#101828;--test-soft:#4b5872;--test-canvas:#eef5ff;color:var(--test-ink);background:var(--test-canvas)}
  .test-shell{width:min(100% - 2rem,1200px);margin-inline:auto}
  .test-hero{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(120deg,#1d116b 0%,#3d24a8 47%,#126dcc 100%);color:#fff}
  .test-hero::after{position:absolute;z-index:-1;right:-10%;bottom:-52%;width:55rem;height:55rem;border:1px solid rgb(255 255 255 / .19);border-radius:50%;content:""}
  .test-hero__glow{position:absolute;z-index:-1;border-radius:50%;filter:blur(16px);opacity:.5}.test-hero__glow--one{top:-16rem;right:20%;width:34rem;height:34rem;background:#5b8cff}.test-hero__glow--two{bottom:-18rem;left:-9rem;width:32rem;height:32rem;background:#8d42d8}
  .test-hero__grid{display:grid;grid-template-columns:minmax(0,1.06fr) minmax(26rem,.94fr);align-items:center;gap:clamp(2.5rem,4vw,4rem);min-height:32rem;padding-block:clamp(2.75rem,4.8vw,4.2rem)}
  .test-hero__copy{max-width:39rem}.test-eyebrow{margin:0;font-family:var(--font-mono);font-size:.84rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.test-hero h1{max-width:17ch;margin:1rem 0 0;font-size:clamp(2.75rem,4.7vw,4.4rem);font-weight:600;letter-spacing:-.045em;line-height:1.01}.test-hero__copy>p:last-of-type{max-width:34rem;margin:1.75rem 0 0;color:rgb(255 255 255 / .82);font-size:clamp(1rem,1.35vw,1.16rem);line-height:1.65}
  .test-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.4rem;margin-top:2rem}.test-button{display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--test-blue);background:var(--test-blue);padding:.82rem 1.35rem;color:#fff;font-weight:700;line-height:1;text-decoration:none;transition:background .16s ease,border-color .16s ease,transform .16s ease}.test-button:hover{border-color:#0e55bb;background:#0e55bb;transform:translateY(-1px)}.test-button--light{border-color:#fff;background:#fff;color:#1c2380}.test-button--light:hover{border-color:#eef4ff;background:#eef4ff}.test-button--small{padding:.6rem 1rem;font-size:.88rem}.test-link{display:inline-flex;align-items:center;gap:.45rem;color:var(--test-blue);font-weight:700;text-decoration:none}.test-link span{transition:transform .16s ease}.test-link:hover span{transform:translateX(.2rem)}.test-link--light{color:#fff}
  .test-hero__visual{position:relative;overflow:visible;border:1px solid rgb(255 255 255 / .38);border-radius:1.2rem;background:#f5f8ff;padding:2.8rem .55rem .55rem;box-shadow:0 42px 80px -34px rgb(0 0 0 / .64);transform:perspective(1200px) rotateY(-4deg) rotateX(1deg)}.test-hero__visual>img{display:block;width:100%;aspect-ratio:16/9;border-radius:.75rem;object-fit:cover}.test-hero__visual-bar{position:absolute;top:0;right:0;left:0;display:flex;height:2.8rem;align-items:center;justify-content:space-between;padding:0 1rem;color:#48546b;font-size:.74rem}.test-hero__visual-bar span{display:flex;gap:.34rem}.test-hero__visual-bar i{display:block;width:.52rem;height:.52rem;border-radius:50%;background:#ccd6e6}.test-hero__visual-badge{}.test-hero__badge{position:absolute;right:-1.8rem;bottom:-2.2rem;display:flex;align-items:center;gap:.8rem;width:min(16rem,52%);border-left:4px solid #77a9ff;background:#fff;padding:1rem 1.15rem;color:#172254;box-shadow:0 18px 46px -18px rgb(2 12 62 / .72)}.test-hero__badge>span{display:grid;width:2.3rem;height:2.3rem;flex:none;place-items:center;border-radius:50%;background:#e6efff;color:#185fcf;font-family:var(--font-mono);font-size:.76rem;font-weight:700}.test-hero__badge p{display:grid;margin:0;line-height:1.2}.test-hero__badge small{margin-top:.25rem;color:#667089;font-size:.72rem}
  .test-section{scroll-margin-top:5rem;padding-block:clamp(4.8rem,8vw,7.4rem)}#overview{position:relative;isolation:isolate;overflow:hidden;padding-top:clamp(2rem,3vw,2.5rem);background:var(--test-canvas)}#overview>.test-shell{position:relative;z-index:1}.overview-backdrop{position:absolute;z-index:0;inset:0;overflow:hidden;pointer-events:none}.overview-backdrop__arc{position:absolute;top:3.5rem;right:-21rem;width:39rem;height:39rem;border:5.5rem solid rgb(105 201 245 / .18);border-radius:50%;box-shadow:0 0 0 1px rgb(23 105 224 / .05)}.overview-backdrop__tiles{position:absolute;top:10.5rem;left:-8rem;width:22rem;height:14rem;background:linear-gradient(90deg,rgb(92 45 193 / .09) 0 46%,transparent 46% 51%,rgb(23 105 224 / .08) 51% 100%),linear-gradient(180deg,transparent 0 55%,rgb(157 214 255 / .12) 55% 100%);transform:rotate(-7deg)}.test-section--white,.test-section--tint,.test-section--lavender,.test-section--dark,.test-section--ink{background:var(--test-canvas);color:var(--test-ink)}.test-section__intro{max-width:46rem}.test-section__intro--wide{max-width:57rem}.test-eyebrow--blue{color:var(--test-blue)}.test-eyebrow--amber{color:#8a5900}.test-section__intro h2,.contact-card h2{margin:.8rem 0 0;color:#15285d;font-size:clamp(2.35rem,4.6vw,4.2rem);font-weight:650;letter-spacing:-.055em;line-height:1}.test-section__intro>p:last-child,.contact-card>div>p:last-child{max-width:52rem;margin:1.3rem 0 0;color:var(--test-soft);font-size:1.13rem;line-height:1.65}.test-section__intro--dark h2{color:#15285d}.test-section__intro--dark>p:last-child{color:var(--test-soft)}#overview .test-section__intro{margin-inline:auto;text-align:center}#overview .test-section__intro>p:last-child{margin-right:auto;margin-left:auto}
  .test-section{position:relative;isolation:isolate;overflow:hidden}.test-section>.test-shell{position:relative;z-index:1}.overview-backdrop__arc{top:auto;right:-19rem;bottom:0;width:38rem;height:38rem;border-color:rgb(66 175 232 / .25);box-shadow:0 0 0 2.25rem rgb(95 61 196 / .035)}.overview-backdrop__tiles{top:12rem;background:linear-gradient(90deg,rgb(92 45 193 / .12) 0 46%,transparent 46% 51%,rgb(23 105 224 / .11) 51% 100%),linear-gradient(180deg,transparent 0 55%,rgb(93 197 240 / .17) 55% 100%)}
  #outcomes::before{position:absolute;z-index:0;top:4rem;left:-13rem;width:28rem;height:28rem;border:3.25rem solid rgb(23 105 224 / .075);border-radius:50%;content:"";pointer-events:none}#outcomes::after{position:absolute;z-index:0;right:-5rem;bottom:4rem;width:17rem;height:12rem;background:linear-gradient(90deg,rgb(92 45 193 / .09) 0 58%,transparent 58% 64%,rgb(255 190 58 / .16) 64% 100%),linear-gradient(180deg,transparent 0 52%,rgb(74 183 232 / .13) 52% 100%);content:"";transform:rotate(7deg);pointer-events:none}
  #workflow::before{position:absolute;z-index:0;top:2rem;right:-12rem;width:27rem;height:27rem;border:4.5rem solid rgb(92 45 193 / .075);border-radius:50%;content:"";pointer-events:none}
  #specification::before{position:absolute;z-index:0;top:1.5rem;right:-14rem;width:29rem;height:29rem;border:4rem solid rgb(74 183 232 / .11);border-radius:50%;content:"";pointer-events:none}#specification::after{position:absolute;z-index:0;bottom:5rem;left:-2rem;width:11rem;height:.7rem;background:linear-gradient(90deg,#1769e0 0 52%,#5c2dc1 52% 82%,#ffd466 82% 100%);content:"";opacity:.38;pointer-events:none}
  #proof::before{position:absolute;z-index:0;top:5rem;right:-9rem;width:21rem;height:21rem;border:2.25rem solid rgb(92 45 193 / .07);content:"";transform:rotate(12deg);pointer-events:none}#proof::after{position:absolute;z-index:0;top:5rem;left:0;width:7rem;height:.65rem;background:linear-gradient(90deg,#1769e0 0 43%,#4ab7e8 43% 72%,#ffd466 72% 100%);content:"";opacity:.45;pointer-events:none}
  #book-a-call::before{position:absolute;z-index:0;bottom:-12rem;left:-10rem;width:26rem;height:26rem;border:3.5rem solid rgb(74 183 232 / .1);border-radius:50%;content:"";pointer-events:none}#book-a-call::after{position:absolute;z-index:0;top:3.5rem;right:-4rem;width:13rem;height:8rem;background:linear-gradient(90deg,rgb(92 45 193 / .09) 0 62%,transparent 62% 68%,rgb(255 190 58 / .17) 68% 100%);content:"";transform:rotate(-8deg);pointer-events:none}
  #overview{padding-bottom:clamp(1.8rem,3vw,2.8rem)}#outcomes{padding-top:clamp(1.8rem,3vw,2.8rem)}#outcomes>.test-shell{width:min(100% - 2rem,1320px)}
