<script>
  const overviewTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-overview-trigger]'));
  const overviewPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-overview-panel]'));
  const overviewModalLayer = document.querySelector<HTMLElement>('#overview-modal-layer');
  let lastOverviewTrigger: HTMLButtonElement | null = null;

  const setOverviewPanel = (requestedPanel: string | null) => {
    const openPanel = overviewPanels.find((panel) => panel.dataset.overviewPanel === requestedPanel);
    const activePanel = openPanel && openPanel.hidden ? openPanel : null;

    overviewTriggers.forEach((trigger) => {
      trigger.setAttribute('aria-expanded', String(activePanel?.dataset.overviewPanel === trigger.dataset.overviewTrigger));
    });

    overviewPanels.forEach((panel) => {
      const shouldOpen = panel === activePanel;
      panel.hidden = !shouldOpen;
      const frame = panel.querySelector<HTMLIFrameElement>('iframe[data-src]');
      const currentSource = frame?.getAttribute('src');

      if (shouldOpen && frame && (!currentSource || currentSource === 'about:blank')) {
        frame.src = frame.dataset.src ?? '';
      }
      if (!shouldOpen && frame && currentSource && currentSource !== 'about:blank') {
        frame.src = 'about:blank';
      }
    });

    if (overviewModalLayer) overviewModalLayer.hidden = !activePanel;
    document.documentElement.classList.toggle('overview-modal-open', Boolean(activePanel));

    if (activePanel) {
      window.requestAnimationFrame(() => {
        activePanel.querySelector<HTMLButtonElement>('[data-overview-close]')?.focus({ preventScroll: true });
      });
    } else if (lastOverviewTrigger) {
      const triggerToRestore = lastOverviewTrigger;
      lastOverviewTrigger = null;
      window.requestAnimationFrame(() => triggerToRestore.focus({ preventScroll: true }));
    }
  };

  overviewTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      lastOverviewTrigger = trigger;
      setOverviewPanel(trigger.dataset.overviewTrigger ?? null);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-overview-close]').forEach((closeButton) => {
    closeButton.addEventListener('click', () => setOverviewPanel(null));
  });

  overviewModalLayer?.addEventListener('click', (event) => {
    if (event.target === overviewModalLayer) setOverviewPanel(null);
  });

  document.addEventListener('keydown', (event) => {
    if (!overviewModalLayer || overviewModalLayer.hidden) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setOverviewPanel(null);
      return;
    }

    if (event.key !== 'Tab') return;
    const activePanel = overviewPanels.find((panel) => !panel.hidden);
    if (!activePanel) return;
    const focusable = Array.from(activePanel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), iframe, [tabindex]:not([tabindex="-1"])'))
      .filter((element) => !element.hasAttribute('hidden'));
    const firstFocusable = focusable[0];
    const lastFocusable = focusable.at(-1);

    if (event.shiftKey && document.activeElement === firstFocusable) {
      event.preventDefault();
      lastFocusable?.focus();
    } else if (!event.shiftKey && document.activeElement === lastFocusable) {
      event.preventDefault();
      firstFocusable?.focus();
    }
  });

  const workflowTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-workflow-tab]'));
  const workflowPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-workflow-panel]'));

  const selectWorkflowStage = (id: string) => {
    workflowTabs.forEach((tab) => {
      const selected = tab.dataset.workflowTab === id;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });
    workflowPanels.forEach((panel) => { panel.hidden = panel.dataset.workflowPanel !== id; });
  };

  workflowTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectWorkflowStage(tab.dataset.workflowTab ?? ''));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const nextTab = workflowTabs[(index + direction + workflowTabs.length) % workflowTabs.length];
      nextTab?.focus();
      selectWorkflowStage(nextTab?.dataset.workflowTab ?? '');
    });
  });

  const scrollRevealGroups = [
    { selector: '#overview .test-section__intro', stagger: 0 },
    { selector: '.overview-card', stagger: 85 },
    { selector: '#outcomes .test-section__intro, .changes-list, .changes-layout > .supervision-diagram', stagger: 95 },
    { selector: '#workflow .test-section__intro, .workflow-tabs, .workflow-stage', stagger: 90 },
    { selector: '#specification .change-card', stagger: 0 },
    { selector: '#proof .test-section__intro, .stat-grid article, .proof-quote, .proof-note', stagger: 70 },
    { selector: '#book-a-call .contact-card', stagger: 0 },
  ];
  const scrollRevealElements = new Set<HTMLElement>();

  scrollRevealGroups.forEach(({ selector, stagger }) => {
    document.querySelectorAll<HTMLElement>(selector).forEach((element, index) => {
      element.dataset.scrollReveal = '';
      element.style.setProperty('--scroll-reveal-delay', `${Math.min(index * stagger, 210)}ms`);
      scrollRevealElements.add(element);
    });
  });

  document.documentElement.classList.add('scroll-reveal-enabled');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window)) {
    scrollRevealElements.forEach((element) => element.classList.add('is-scroll-revealed'));
  } else {
    const scrollRevealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-scroll-revealed');
        scrollRevealObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: .12 });

    scrollRevealElements.forEach((element) => scrollRevealObserver.observe(element));
  }
</script>
