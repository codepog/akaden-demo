<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-demo-dialog]');
  const frame = dialog?.querySelector<HTMLIFrameElement>('iframe[data-src]');
  let returnFocus: HTMLElement | null = null;

  document.querySelectorAll<HTMLElement>('[data-demo-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog) return;
      returnFocus = trigger;
      if (frame && (!frame.src || frame.src === 'about:blank')) frame.src = frame.dataset.src ?? '';
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-demo-close]')?.focus();
    });
  });

  const closeDemo = () => {
    if (!dialog?.open) return;
    dialog.close();
    if (frame) frame.src = 'about:blank';
  };

  dialog?.querySelector('[data-demo-close]')?.addEventListener('click', closeDemo);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeDemo();
  });
  dialog?.addEventListener('close', () => {
    if (frame && frame.src !== 'about:blank') frame.src = 'about:blank';
    returnFocus?.focus({ preventScroll: true });
    returnFocus = null;
  });
</script>
