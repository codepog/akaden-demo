---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
  announcement,
  controls,
  evidence,
  faq,
  hero,
  lifecycle,
  maintenance,
  overview,
} from '../data/site';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const assetPath = (name: string) => `${basePath}${name}`;
const demoPage = import.meta.env.DEV
  ? `${basePath}overview-demo-embed`
  : `${basePath}overview-demo-embed.html`;
const demoUrl = `${demoPage}?intro=always`;
---

<Base title="Akaden — AI-assisted IDE for Ellucian pipeline development">
  <a class="announcement" href={announcement.href}>
    <span>{announcement.text}</span>
    <strong>{announcement.detail}</strong>
    <span aria-hidden="true">→</span>
  </a>
  <Nav />

  <main id="main" class="product-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__shape hero__shape--one" aria-hidden="true"></div>
      <div class="hero__shape hero__shape--two" aria-hidden="true"></div>
      <div class="shell hero__grid">
        <div class="hero__copy">
          <p class="eyebrow">{hero.eyebrow}</p>
          <h1 id="hero-title">{hero.headline}</h1>
          <p class="hero__lead">{hero.lead}</p>
          <div class="actions">
            <button class="button button--light" type="button" data-demo-open>
              {hero.primaryAction}
            </button>
            <a class="text-link text-link--light" href="#workflow">
              {hero.secondaryAction}<span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <button class="hero-preview" type="button" data-demo-open aria-label="Open the Akaden interactive product walkthrough">
          <span class="hero-preview__bar">
            <span aria-hidden="true"><i></i><i></i><i></i></span>
            <b>{hero.previewLabel}</b>
          </span>
          <img
            src={assetPath('hero-demo-preview.png')}
            alt="Akaden workspace showing a guided pipeline requirement."
            width="2798"
            height="1302"
          />
          <span class="hero-preview__play" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="m20 15 14 9-14 9Z" /></svg>
          </span>
          <span class="hero-preview__caption">
            <small>Product tour</small>
            <strong>{hero.previewStatus}</strong>
          </span>
        </button>
      </div>
    </section>

    <nav class="section-nav" aria-label="On this page">
      <div class="shell section-nav__inner">
        <a href="#overview">Overview</a>
        <a href="#workflow">Workflow</a>
        <a href="#control">Developer control</a>
        <a href="#proof">Evidence</a>
        <a href="#faq">FAQ</a>
        <button type="button" data-demo-open>Explore demo</button>
      </div>
    </nav>

    <section id="overview" class="section section--paper">
      <div class="shell">
        <div class="section-heading section-heading--center">
          <p class="eyebrow eyebrow--blue">Overview</p>
          <h2>{hero.thesis}</h2>
          <p>{hero.thesisSub}</p>
        </div>

        <div class="overview-grid">
          {overview.map((item) => (
            <article class="overview-card">
              <span class="overview-card__number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="product-demo" class="section section--white">
      <div class="shell demo-feature">
        <div class="demo-feature__copy">
          <p class="eyebrow eyebrow--blue">Guided product experience</p>
          <h2>Follow a real request through the Akaden workspace.</h2>
          <p>See how context becomes a specification, where your team reviews the work, and how the pipeline moves toward deployment.</p>
          <button class="button button--primary" type="button" data-demo-open>Open interactive demo</button>
          <p class="demo-feature__note">Guided product walkthrough · Does not connect to a live tenant</p>
        </div>
        <button class="product-frame" type="button" data-demo-open aria-label="Open the interactive Akaden product demo">
          <span class="product-frame__bar"><i></i><i></i><i></i><b>Akaden workspace</b></span>
          <img src={assetPath('hero-demo-preview.png')} alt="Preview of the Akaden interactive product walkthrough." loading="lazy" width="2798" height="1302" />
          <span class="product-frame__action">Explore the workspace <span aria-hidden="true">→</span></span>
        </button>
      </div>
    </section>

    <section id="workflow" class="section section--navy">
      <div class="shell">
        <div class="section-heading section-heading--light">
          <p class="eyebrow eyebrow--amber">How it works</p>
          <h2>One reviewable path from source material to monitored pipeline.</h2>
          <p>The workflow now reflects the full product direction, including test generation and monitoring.</p>
        </div>

        <ol class="lifecycle" aria-label="Akaden pipeline development lifecycle">
          {lifecycle.map((step) => (
            <li class:list={['lifecycle-card', `lifecycle-card--${step.kind}`]}>
              <div class="lifecycle-card__meta">
                <span>{step.number}</span>
                <small>{step.actor}</small>
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>

        <div class="workflow-legend" aria-label="Workflow legend">
          <span><i class="legend-human"></i>Team decision or system step</span>
          <span><i class="legend-agent"></i>AI-assisted work</span>
        </div>
      </div>
    </section>

    <section id="control" class="section section--control">
      <div class="shell control-grid">
        <div class="control-copy">
          <p class="eyebrow eyebrow--blue">{controls.eyebrow}</p>
          <h2>{controls.headline}</h2>
          <p>{controls.lead}</p>
          <div class="approval-line" aria-label="Human approval points">
            <span>Inputs</span><i>→</i><span>Specification</span><i>→</i><span>Functionality</span><i>→</i><span>Deployment</span>
          </div>
        </div>

        <div class="control-list">
          {controls.items.map((item, index) => (
            <article>
              <span>0{index + 1}</span>
              <div><h3>{item.title}</h3><p>{item.body}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--maintenance" aria-labelledby="maintenance-title">
      <div class="shell maintenance-card">
        <div class="maintenance-card__heading">
          <p class="eyebrow eyebrow--blue">{maintenance.eyebrow}</p>
          <h2 id="maintenance-title">{maintenance.headline}</h2>
          <blockquote>“{maintenance.request}”</blockquote>
        </div>
        <div class="comparison">
          <article>
            <p class="comparison__label">Without a living specification</p>
            <ol>{maintenance.oldWay.map((point) => <li>{point}</li>)}</ol>
          </article>
          <article class="comparison__akaden">
            <p class="comparison__label">With Akaden</p>
            <ol>{maintenance.akadenWay.map((point) => <li>{point}</li>)}</ol>
          </article>
        </div>
      </div>
    </section>

    <section id="proof" class="section section--white">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow eyebrow--blue">{evidence.eyebrow}</p>
          <h2>{evidence.headline}</h2>
          <p>{evidence.lead}</p>
        </div>
        <div class="evidence-grid">
          {evidence.points.map((point, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="section section--paper">
      <div class="shell faq-grid">
        <div class="section-heading">
          <p class="eyebrow eyebrow--blue">Product questions</p>
          <h2>What evaluators should understand first.</h2>
          <p>Clear answers now, with security and deployment documentation to follow as the external offering is finalized.</p>
        </div>
        <div class="faq-list">
          {faq.map((item, index) => (
            <details open={index === 0}>
              <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
      <div class="final-cta__shape" aria-hidden="true"></div>
      <div class="shell final-cta__inner">
        <div>
          <p class="eyebrow">Explore Akaden</p>
          <h2 id="final-cta-title">See the specification-driven workflow in context.</h2>
        </div>
        <button class="button button--light" type="button" data-demo-open>Open interactive demo</button>
      </div>
    </section>
  </main>

  <Footer />

  <dialog class="demo-dialog" data-demo-dialog aria-labelledby="demo-dialog-title">
    <div class="demo-dialog__header">
      <div>
        <p class="eyebrow eyebrow--blue">Interactive demo</p>
        <h2 id="demo-dialog-title">Follow one request through Akaden.</h2>
      </div>
      <button type="button" class="demo-dialog__close" data-demo-close aria-label="Close interactive demo">Close</button>
    </div>
    <div class="demo-dialog__body">
      <iframe data-src={demoUrl} title="Akaden interactive product walkthrough"></iframe>
    </div>
  </dialog>
</Base>

<style>
  .product-page{--brand-blue:#1769e0;--brand-navy:#112a55;--brand-purple:#3e259f;--brand-ink:#111827;--brand-soft:#4b5568;--brand-paper:#f4f6f9;color:var(--brand-ink);background:#fff}
  .shell{width:min(100% - 2rem,75rem);margin-inline:auto}
  .announcement{display:flex;min-height:2.9rem;align-items:center;justify-content:center;gap:.65rem;background:#1e355d;padding:.55rem 1rem;color:#fff;font-size:.9rem;text-align:center;text-decoration:none}.announcement strong{font-weight:700}.announcement:hover{text-decoration:underline;text-underline-offset:.2rem}
  .eyebrow{margin:0;font-family:var(--font-mono);font-size:.73rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.eyebrow--blue{color:#1558bd}.eyebrow--amber{color:#ffcc55}
  .hero{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(112deg,#75d7f2 0%,#aeb9ff 56%,#ceb1f3 100%)}
  .hero__shape{position:absolute;z-index:-1;border-radius:50%}.hero__shape--one{right:-11rem;bottom:-16rem;width:44rem;height:44rem;background:rgb(22 105 224/.76)}.hero__shape--two{right:-3rem;top:-7rem;width:18rem;height:18rem;background:#efd33c}
  .hero__grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(28rem,1.08fr);align-items:center;gap:clamp(2.5rem,5vw,5rem);min-height:38rem;padding-block:clamp(4.5rem,8vw,7rem)}
  .hero__copy{max-width:37rem}.hero h1{max-width:13ch;margin:1.15rem 0 0;font-size:clamp(3rem,5.4vw,5rem);font-weight:600;letter-spacing:-.055em;line-height:.99;text-wrap:balance}.hero__lead{max-width:36rem;margin:1.7rem 0 0;color:#25324a;font-size:clamp(1.05rem,1.5vw,1.22rem);line-height:1.58}.actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.35rem;margin-top:2rem}
  .button{display:inline-flex;min-height:3.1rem;align-items:center;justify-content:center;border:2px solid transparent;border-radius:0;padding:.72rem 1.35rem;font:inherit;font-size:.98rem;font-weight:700;line-height:1.15;cursor:pointer;transition:background-color .16s ease,color .16s ease,transform .16s ease}.button:hover{transform:translateY(-1px)}.button--primary{background:#18365f;color:#fff}.button--primary:hover{background:#0e2549}.button--light{background:#fff;color:#17233e}.button--light:hover{background:#eef3fb}
  .text-link{display:inline-flex;min-height:2.75rem;align-items:center;gap:.45rem;font-weight:700;text-decoration:none}.text-link span{transition:transform .16s ease}.text-link:hover span{transform:translateX(.22rem)}.text-link--light{color:#17233e}
  .hero-preview{position:relative;display:block;overflow:hidden;border:1px solid rgb(255 255 255/.78);border-radius:1.2rem;background:rgb(255 255 255/.55);padding:2.65rem .55rem .55rem;box-shadow:0 2rem 4.5rem -2.5rem rgb(26 35 82/.62);text-align:left;cursor:pointer}.hero-preview>img{display:block;width:100%;aspect-ratio:16/9;border-radius:.75rem;object-fit:cover}.hero-preview__bar{position:absolute;top:0;right:0;left:0;display:flex;height:2.65rem;align-items:center;justify-content:space-between;padding:0 .9rem;color:#3f4a60;font-size:.72rem}.hero-preview__bar>span{display:flex;gap:.3rem}.hero-preview__bar i{display:block;width:.48rem;height:.48rem;border-radius:50%;background:#aeb8c9}.hero-preview__play{position:absolute;top:50%;left:50%;display:grid;width:4.4rem;height:4.4rem;place-items:center;border-radius:50%;background:#1c335c;color:#fff;box-shadow:0 .8rem 2rem rgb(16 29 63/.32);transform:translate(-50%,-42%)}.hero-preview__play svg{width:2rem;height:2rem;fill:currentColor}.hero-preview__caption{position:absolute;right:1.2rem;bottom:1.2rem;display:grid;min-width:12.5rem;border-left:4px solid #1769e0;background:#fff;padding:.85rem 1rem;box-shadow:0 .7rem 1.8rem rgb(16 29 63/.2)}.hero-preview__caption small{color:#667085;font-size:.68rem;text-transform:uppercase}.hero-preview__caption strong{margin-top:.15rem;color:#15213a;font-size:.9rem}
  .section-nav{position:sticky;top:4.25rem;z-index:30;border-bottom:1px solid #d9dee8;background:rgb(255 255 255/.96);box-shadow:0 .5rem 1.5rem rgb(17 42 85/.06);backdrop-filter:blur(12px)}.section-nav__inner{display:flex;min-height:3.8rem;align-items:center;gap:1.7rem;overflow-x:auto}.section-nav a{flex:none;color:#273044;font-size:.86rem;font-weight:650;text-decoration:none}.section-nav a:hover{text-decoration:underline;text-underline-offset:.25rem}.section-nav button{min-height:2.6rem;margin-left:auto;border:0;background:#1e355d;padding:.55rem 1rem;color:#fff;font:inherit;font-size:.86rem;font-weight:700;white-space:nowrap;cursor:pointer}
  .section{scroll-margin-top:8rem;padding-block:clamp(5.5rem,9vw,8rem)}.section--paper{background:var(--brand-paper)}.section--white{background:#fff}.section--navy{background:#0d2349;color:#fff}.section--control{background:linear-gradient(122deg,#e8f5fb 0%,#eef0ff 54%,#f5ebfb 100%)}.section--maintenance{background:#dcecff}
  .section-heading{max-width:48rem}.section-heading--center{margin-inline:auto;text-align:center}.section-heading h2,.control-copy h2,.maintenance-card h2,.final-cta h2{margin:.85rem 0 0;font-size:clamp(2.25rem,4.5vw,3.8rem);font-weight:600;letter-spacing:-.047em;line-height:1.04;text-wrap:balance}.section-heading>p:last-child,.control-copy>p:last-of-type{max-width:45rem;margin:1.35rem 0 0;color:var(--brand-soft);font-size:1.08rem;line-height:1.65}.section-heading--center>p:last-child{margin-inline:auto}.section-heading--light h2{max-width:52rem}.section-heading--light>p:last-child{color:#c6d4eb}
  .overview-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:3.5rem}.overview-card{min-height:21rem;border:1px solid #d6dbe4;border-radius:1.1rem;background:#fff;padding:2rem;box-shadow:0 .6rem 1.6rem rgb(17 42 85/.07)}.overview-card__number{display:grid;width:2.6rem;height:2.6rem;place-items:center;background:#e4efff;color:#1558bd;font-family:var(--font-mono);font-size:.76rem;font-weight:700}.overview-card h3{margin:4.5rem 0 0;font-size:1.55rem;letter-spacing:-.025em;line-height:1.15}.overview-card p{margin:1rem 0 0;color:var(--brand-soft);line-height:1.6}
  .demo-feature{display:grid;grid-template-columns:minmax(18rem,.72fr) minmax(30rem,1.28fr);align-items:center;gap:clamp(2.5rem,6vw,6rem)}.demo-feature__copy h2{margin:.85rem 0 0;font-size:clamp(2.2rem,4.2vw,3.65rem);font-weight:600;letter-spacing:-.045em;line-height:1.05}.demo-feature__copy>p:not(.eyebrow):not(.demo-feature__note){margin:1.35rem 0 0;color:var(--brand-soft);font-size:1.08rem;line-height:1.65}.demo-feature__copy .button{margin-top:1.75rem}.demo-feature__note{margin:1rem 0 0;color:#6b7280;font-size:.78rem}.product-frame{position:relative;overflow:hidden;border:1px solid #8998ad;border-radius:1rem;background:#eff4fb;padding:2.55rem .6rem .6rem;box-shadow:0 2rem 3.5rem -2.7rem rgb(17 42 85/.56);cursor:pointer}.product-frame>img{display:block;width:100%;aspect-ratio:16/9;border-radius:.55rem;object-fit:cover}.product-frame__bar{position:absolute;top:0;right:0;left:0;display:flex;height:2.55rem;align-items:center;gap:.28rem;padding:0 .85rem}.product-frame__bar i{width:.47rem;height:.47rem;border-radius:50%;background:#b5becb}.product-frame__bar b{margin-left:auto;color:#536077;font-size:.7rem}.product-frame__action{position:absolute;right:1.15rem;bottom:1.15rem;background:#16355f;padding:.7rem .9rem;color:#fff;font-size:.82rem;font-weight:700}
  .lifecycle{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:3.5rem 0 0;padding:0;list-style:none}.lifecycle-card{position:relative;min-height:20rem;border-top:4px solid #72a8ff;background:#fff;padding:1.45rem 1.35rem;color:#111827}.lifecycle-card--agent{border-top-color:#ffbf2e}.lifecycle-card__meta{display:flex;align-items:center;justify-content:space-between;gap:.75rem}.lifecycle-card__meta>span{font-family:var(--font-mono);font-size:.75rem;font-weight:700}.lifecycle-card__meta small{border:1px solid #c8d1df;padding:.25rem .45rem;color:#48566b;font-size:.63rem;font-weight:700;text-transform:uppercase}.lifecycle-card--agent .lifecycle-card__meta small{border-color:#d7a11c;background:#fff3cb;color:#594000}.lifecycle-card h3{margin:4.3rem 0 0;font-size:1.32rem;line-height:1.17}.lifecycle-card p{margin:.9rem 0 0;color:#4b5568;font-size:.91rem;line-height:1.55}.workflow-legend{display:flex;flex-wrap:wrap;gap:1.3rem;margin-top:1.4rem;color:#c6d4eb;font-size:.78rem}.workflow-legend span{display:inline-flex;align-items:center;gap:.45rem}.workflow-legend i{display:block;width:1.8rem;height:.2rem;background:#72a8ff}.workflow-legend .legend-agent{background:#ffbf2e}
  .control-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(28rem,1.1fr);gap:clamp(3rem,8vw,8rem)}.control-copy{align-self:start}.control-copy>p:last-of-type{max-width:35rem}.approval-line{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;margin-top:2rem}.approval-line span{border:1px solid #7892b7;background:rgb(255 255 255/.74);padding:.48rem .66rem;color:#18345b;font-family:var(--font-mono);font-size:.69rem;font-weight:700;text-transform:uppercase}.approval-line i{font-style:normal;color:#365d92}.control-list{border-top:1px solid #a7b7cc}.control-list article{display:grid;grid-template-columns:3rem 1fr;gap:1.1rem;border-bottom:1px solid #a7b7cc;padding:1.5rem .25rem}.control-list article>span{color:#1769e0;font-family:var(--font-mono);font-size:.72rem;font-weight:700}.control-list h3{margin:0;font-size:1.2rem}.control-list p{margin:.55rem 0 0;color:#47566d;line-height:1.55}
  .maintenance-card{display:grid;grid-template-columns:minmax(17rem,.72fr) minmax(30rem,1.28fr);gap:clamp(3rem,7vw,7rem)}.maintenance-card__heading blockquote{margin:2rem 0 0;border-left:4px solid #1769e0;background:#fff;padding:1.2rem 1.35rem;color:#18345b;font-size:1.12rem;font-weight:650;line-height:1.5}.comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.comparison article{border-top:4px solid #8190a4;background:#fff;padding:1.65rem}.comparison .comparison__akaden{border-top-color:#1769e0}.comparison__label{margin:0;color:#34435a;font-weight:750}.comparison ol{display:grid;gap:1.15rem;margin:1.5rem 0 0;padding:0;counter-reset:item;list-style:none}.comparison li{position:relative;padding-left:2.15rem;color:#4b5568;line-height:1.55}.comparison li::before{position:absolute;top:0;left:0;display:grid;width:1.45rem;height:1.45rem;place-items:center;border:1px solid #9ba9ba;border-radius:50%;content:counter(item);counter-increment:item;font-family:var(--font-mono);font-size:.62rem}.comparison__akaden li::before{border-color:#1769e0;color:#1558bd}
  .evidence-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin-top:3.5rem;background:#cbd2dc}.evidence-grid article{min-height:18rem;background:#f7f9fc;padding:1.8rem}.evidence-grid span{font-family:var(--font-mono);font-size:.72rem;font-weight:700;color:#1558bd}.evidence-grid h3{margin:4.2rem 0 0;font-size:1.35rem}.evidence-grid p{margin:.9rem 0 0;color:var(--brand-soft);line-height:1.58}.evidence-note{margin:1.2rem 0 0;color:#657083;font-size:.78rem;line-height:1.55}
  .faq-grid{display:grid;grid-template-columns:minmax(18rem,.72fr) minmax(30rem,1.28fr);gap:clamp(3rem,8vw,8rem)}.faq-list{border-top:1px solid #b7c0cd}.faq-list details{border-bottom:1px solid #b7c0cd}.faq-list summary{display:flex;min-height:4.8rem;align-items:center;justify-content:space-between;gap:1.5rem;padding:1rem 0;font-size:1.12rem;font-weight:700;cursor:pointer;list-style:none}.faq-list summary::-webkit-details-marker{display:none}.faq-list summary i{position:relative;width:1.2rem;height:1.2rem;flex:none}.faq-list summary i::before,.faq-list summary i::after{position:absolute;top:50%;left:0;width:100%;height:2px;background:#18345b;content:""}.faq-list summary i::after{transform:rotate(90deg);transition:transform .16s ease}.faq-list details[open] summary i::after{transform:rotate(0)}.faq-list details p{max-width:44rem;margin:0;padding:0 2rem 1.5rem 0;color:var(--brand-soft);line-height:1.65}
  .final-cta{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(110deg,#271587 0%,#3349bd 54%,#1380d1 100%);padding-block:clamp(4.5rem,8vw,7rem);color:#fff}.final-cta__shape{position:absolute;z-index:-1;right:-9rem;bottom:-15rem;width:34rem;height:34rem;border:6rem solid rgb(255 255 255/.12);border-radius:50%}.final-cta__inner{display:flex;align-items:end;justify-content:space-between;gap:3rem}.final-cta h2{max-width:47rem}.final-cta .button{flex:none}
