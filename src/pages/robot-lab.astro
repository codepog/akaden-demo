---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---

<Base title="Akaden Robot Lab" description="A motion study for Akaden's specialist agents.">
  <Nav />
  <main id="main" class="robot-lab-page">
    <section class="robot-lab" aria-labelledby="robot-lab-heading">
      <div class="robot-lab__intro">
        <p class="u-label text-blue">Motion study</p>
        <h1 id="robot-lab-heading">A small agent with a clear job.</h1>
        <p>Use the controls to test the motions an Akaden agent needs when it gathers context, carries work through the application, and sends it onward.</p>
      </div>

      <div class="robot-lab__workspace">
        <div class="robot-stage" aria-label="Animated Akaden agent preview">
          <div class="robot-stage__floor" aria-hidden="true"></div>
          <div class="robot" data-robot data-motion="idle" aria-label="Akaden agent in idle mode">
            <img class="robot__body" src="/akaden-robot-body.png" alt="" />

            <div class="robot__arm robot__arm--left" aria-hidden="true">
              <span class="robot__piece robot__shoulder"><img src="/akaden-robot-shoulder.png" alt="" /></span>
              <span class="robot__piece robot__upper-arm"><img src="/akaden-robot-upper-arm.png" alt="" />
                <span class="robot__piece robot__elbow"><img src="/akaden-robot-elbow.png" alt="" />
                  <span class="robot__piece robot__forearm"><img src="/akaden-robot-forearm.png" alt="" />
                    <span class="robot__piece robot__wrist"><img src="/akaden-robot-wrist.png" alt="" />
                      <span class="robot__piece robot__claw"><img src="/akaden-robot-claw.png" alt="" /></span>
                    </span>
                  </span>
                </span>
              </span>
            </div>

            <div class="robot__arm robot__arm--right" aria-hidden="true">
              <span class="robot__piece robot__shoulder"><img src="/akaden-robot-shoulder.png" alt="" /></span>
              <span class="robot__piece robot__upper-arm"><img src="/akaden-robot-upper-arm.png" alt="" />
                <span class="robot__piece robot__elbow"><img src="/akaden-robot-elbow.png" alt="" />
                  <span class="robot__piece robot__forearm"><img src="/akaden-robot-forearm.png" alt="" />
                    <span class="robot__piece robot__wrist"><img src="/akaden-robot-wrist.png" alt="" />
                      <span class="robot__piece robot__claw"><img src="/akaden-robot-claw.png" alt="" /></span>
                    </span>
                  </span>
                </span>
              </span>
            </div>

            <span class="robot__input-orb robot__input-orb--one" aria-hidden="true"></span>
            <span class="robot__input-orb robot__input-orb--two" aria-hidden="true"></span>
            <span class="robot__input-orb robot__input-orb--three" aria-hidden="true"></span>
            <span class="robot__output-orb robot__output-orb--one" aria-hidden="true"></span>
            <span class="robot__output-orb robot__output-orb--two" aria-hidden="true"></span>
            <span class="robot__output-orb robot__output-orb--three" aria-hidden="true"></span>
            <span class="robot__signal robot__signal--one" aria-hidden="true"></span>
            <span class="robot__signal robot__signal--two" aria-hidden="true"></span>
            <span class="robot__signal robot__signal--three" aria-hidden="true"></span>
          </div>
          <p class="robot-stage__status" data-status>Idle and ready</p>
        </div>

        <div class="robot-controls" aria-label="Robot movement controls">
          <p class="u-label text-blue">Try a motion</p>
          <div class="robot-controls__buttons">
            <button type="button" data-motion-button="idle" aria-pressed="true">Idle</button>
            <button type="button" data-motion-button="wave" aria-pressed="false">Wave</button>
            <button type="button" data-motion-button="gather" aria-pressed="false">Gather</button>
            <button type="button" data-motion-button="specification" aria-pressed="false">Specification agent</button>
            <button type="button" data-motion-button="push" aria-pressed="false">Push</button>
          </div>
          <p class="robot-controls__note">The specification agent catches blue context orbs, turns them into a coherent plan, then places the resulting yellow orbs in a clear handoff line.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script is:inline>
  const motionLabels = {
    idle: 'Idle and ready',
    wave: 'Greeting the team',
    gather: 'Gathering context',
    specification: 'Specification agent coordinating context',
    push: 'Dispatching delivery work',
  };

  const robot = document.querySelector('[data-robot]');
  const status = document.querySelector('[data-status]');
  const motionButtons = document.querySelectorAll('[data-motion-button]');

  motionButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const motion = button.dataset.motionButton;
      if (!robot || !motion || !status) return;
      robot.dataset.motion = motion;
      robot.setAttribute('aria-label', `Akaden agent: ${motionLabels[motion]}`);
      status.textContent = motionLabels[motion];
      motionButtons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
    });
  });
</script>

<style>
  .robot-lab-page{min-height:calc(100vh - 4rem);background:linear-gradient(180deg,#f8fbff 0%,#eef5ff 100%);padding:clamp(3rem,6vw,6.5rem) 1.25rem 6rem}
  .robot-lab{max-width:70rem;margin:0 auto}.robot-lab__intro{max-width:42rem}.robot-lab__intro h1{margin:.8rem 0 0;color:var(--color-blue-deep);font-size:clamp(2.25rem,5vw,4.9rem);line-height:.97;letter-spacing:-.055em}.robot-lab__intro p:last-child{margin:1.15rem 0 0;color:var(--color-ink-soft);font-size:clamp(1rem,1.8vw,1.22rem);line-height:1.55}
  .robot-lab__workspace{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(15rem,.75fr);gap:clamp(1.25rem,3vw,2.5rem);align-items:center;margin-top:clamp(2.25rem,5vw,4rem)}.robot-stage{position:relative;display:grid;min-height:30rem;place-items:center;overflow:hidden;border:1px solid #c9d9f2;border-radius:2rem;background:radial-gradient(circle at 50% 40%,#fff 0%,#f8fbff 46%,#e8f2ff 100%);box-shadow:0 1.75rem 4rem -3.3rem rgb(21 83 177/.55)}.robot-stage::before,.robot-stage::after{position:absolute;content:"";width:13rem;height:13rem;border:1px solid rgb(38 105 205/.14);border-radius:2.5rem;transform:rotate(45deg)}.robot-stage::before{top:-8rem;right:-4rem}.robot-stage::after{bottom:-8rem;left:-5rem}.robot-stage__floor{position:absolute;bottom:5.75rem;left:16%;width:68%;height:1px;background:linear-gradient(90deg,transparent,#99b8e9 18%,#99b8e9 82%,transparent)}.robot-stage__status{position:absolute;bottom:1.9rem;margin:0;color:#4d658a;font-family:var(--font-mono);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .robot{position:relative;z-index:1;width:31rem;height:28rem;filter:drop-shadow(0 1.4rem 1.1rem rgb(27 80 155/.15))}
  .robot__body{position:absolute;z-index:2;bottom:2.8rem;left:50%;width:14rem;transform:translateX(-50%);animation:robot-breathe 3.3s ease-in-out infinite}
  .robot__arm{position:absolute;z-index:1;top:12.1rem;width:9rem;height:14.5rem;pointer-events:none}.robot__arm--left{left:calc(50% - 11.25rem);--upper-rest:16deg;--forearm-rest:-21deg;--forearm-idle:-12deg}.robot__arm--right{left:calc(50% + 2.75rem);--upper-rest:-16deg;--forearm-rest:21deg;--forearm-idle:12deg}
  .robot__piece{position:absolute;display:block;line-height:0;will-change:transform}.robot__piece img{display:block;width:100%;height:auto}.robot__shoulder{top:-.72rem;left:6.35rem;width:2.1rem}.robot__upper-arm{top:.3rem;left:5.45rem;width:2.75rem;transform-origin:50% 0;transform:rotate(var(--upper-rest))}.robot__elbow{top:2.86rem;left:.28rem;width:2.3rem;transform-origin:50% 50%}.robot__forearm{top:.82rem;left:-.1rem;width:2.78rem;transform-origin:50% 0;transform:rotate(var(--forearm-rest))}.robot__wrist{top:3.18rem;left:.68rem;width:1.42rem;transform-origin:50% 50%}.robot__claw{top:.1rem;left:-1.05rem;width:3.55rem;transform-origin:50% 0}.robot__arm--right .robot__shoulder{left:.55rem}.robot__arm--right .robot__upper-arm{left:.15rem}.robot__arm--right .robot__piece > img{transform:scaleX(-1)}
  .robot__input-orb,.robot__output-orb{position:absolute;z-index:5;width:1.55rem;height:1.55rem;border-radius:50%;opacity:0}.robot__input-orb{top:18.72rem;left:0;background:radial-gradient(circle at 32% 28%,#ebf5ff 0 10%,#9fcfff 12% 27%,#4389e9 54%,#1f5db9 100%);box-shadow:0 0 0 .23rem rgb(67 137 233/.16),0 .35rem .6rem rgb(16 68 143/.25)}.robot__input-orb--two{--orb-delay:-1.35s}.robot__input-orb--three{--orb-delay:-2.7s}.robot__output-orb{left:26rem;background:radial-gradient(circle at 32% 28%,#fff6cf 0 10%,#ffd96b 12% 27%,#ffbe32 54%,#e89408 100%);box-shadow:0 0 0 .23rem rgb(255 190 50/.16),0 .35rem .6rem rgb(138 91 0/.25)}.robot__output-orb--one{top:16.05rem;--output-delay:0s}.robot__output-orb--two{top:18.72rem;--output-delay:-1.35s}.robot__output-orb--three{top:21.39rem;--output-delay:-2.7s}
  .robot__signal{position:absolute;z-index:4;width:.52rem;height:.52rem;border-radius:50%;background:#ffbe32;box-shadow:0 0 .62rem rgb(255 190 50/.88);opacity:0}.robot__signal--one{left:4%;top:57%}.robot__signal--two{left:9%;top:63%;animation-delay:-.22s}.robot__signal--three{left:13%;top:70%;animation-delay:-.44s}
  .robot[data-motion='idle'] .robot__arm--left .robot__upper-arm{animation:robot-idle-left 2.8s ease-in-out infinite}.robot[data-motion='idle'] .robot__arm--right .robot__upper-arm{animation:robot-idle-right 2.8s ease-in-out infinite}.robot[data-motion='idle'] .robot__forearm{animation:robot-idle-forearm 2.8s ease-in-out infinite}
  .robot[data-motion='wave'] .robot__arm--right .robot__upper-arm{animation:robot-wave-upper .65s ease-in-out infinite alternate}.robot[data-motion='wave'] .robot__arm--right .robot__forearm{animation:robot-wave-forearm .65s ease-in-out infinite alternate}.robot[data-motion='wave'] .robot__arm--right .robot__claw{animation:robot-wave-claw .36s ease-in-out infinite alternate}
  .robot[data-motion='gather'] .robot__arm--left .robot__upper-arm{animation:robot-gather-left 1.05s cubic-bezier(.32,1.5,.56,1) infinite alternate}.robot[data-motion='gather'] .robot__arm--right .robot__upper-arm{animation:robot-gather-right 1.05s cubic-bezier(.32,1.5,.56,1) infinite alternate}.robot[data-motion='gather'] .robot__forearm{animation:robot-gather-forearm 1.05s cubic-bezier(.32,1.5,.56,1) infinite alternate}.robot[data-motion='gather'] .robot__signal{animation:robot-orb-in 1.4s ease-in infinite}
  .robot[data-motion='specification'] .robot__body{animation:robot-carry-body 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__arm--left .robot__upper-arm{animation:robot-catch-upper 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__arm--left .robot__forearm{animation:robot-catch-forearm 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__arm--right .robot__upper-arm{animation:robot-handoff-upper 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__arm--right .robot__forearm{animation:robot-handoff-forearm 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__arm--left .robot__claw{animation:robot-specification-claw-left 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__arm--right .robot__claw{animation:robot-specification-claw-right 4.05s ease-in-out infinite}.robot[data-motion='specification'] .robot__input-orb{animation:robot-specification-input 4.05s linear infinite;animation-delay:var(--orb-delay,0s)}.robot[data-motion='specification'] .robot__output-orb{animation:robot-specification-output 4.05s linear infinite;animation-delay:var(--output-delay,0s)}
  .robot[data-motion='push'] .robot__body{animation:robot-push-body 1.15s ease-in-out infinite}.robot[data-motion='push'] .robot__arm--right .robot__upper-arm{animation:robot-push-upper 1.15s ease-in-out infinite}.robot[data-motion='push'] .robot__arm--right .robot__forearm{animation:robot-push-forearm 1.15s ease-in-out infinite}.robot[data-motion='push'] .robot__arm--left .robot__upper-arm{animation:robot-brace-upper 1.15s ease-in-out infinite}.robot[data-motion='push'] .robot__signal{animation:robot-orb-out 1.15s ease-in infinite}
  @keyframes robot-breathe{50%{transform:translate(-50%,-.25rem)}}@keyframes robot-idle-left{50%{transform:rotate(22deg)}}@keyframes robot-idle-right{50%{transform:rotate(-22deg)}}@keyframes robot-idle-forearm{50%{transform:rotate(var(--forearm-idle))}}@keyframes robot-wave-upper{to{transform:rotate(-38deg)}}@keyframes robot-wave-forearm{to{transform:rotate(34deg)}}@keyframes robot-wave-claw{to{transform:rotate(10deg)}}@keyframes robot-gather-left{to{transform:rotate(-13deg)}}@keyframes robot-gather-right{to{transform:rotate(13deg)}}@keyframes robot-gather-forearm{to{transform:rotate(0)}}@keyframes robot-orb-in{0%{opacity:0;transform:translate(0,0) scale(.5)}15%,67%{opacity:1}80%,100%{opacity:0;transform:translate(8.2rem,-2.2rem) scale(.2)}}@keyframes robot-carry-body{0%,100%{transform:translateX(-50%)}42%,58%{transform:translate(-50%,-.22rem)}}@keyframes robot-catch-upper{0%,14%{transform:rotate(28deg)}38%,56%{transform:rotate(-2deg)}75%,100%{transform:rotate(16deg)}}@keyframes robot-catch-forearm{0%,14%{transform:rotate(-38deg)}38%,56%{transform:rotate(4deg)}75%,100%{transform:rotate(-21deg)}}@keyframes robot-handoff-upper{0%,57%{transform:rotate(-16deg)}76%,88%{transform:rotate(-36deg)}100%{transform:rotate(-16deg)}}@keyframes robot-handoff-forearm{0%,57%{transform:rotate(21deg)}76%,88%{transform:rotate(36deg)}100%{transform:rotate(21deg)}}@keyframes robot-specification-claw-left{0%,17%,100%{transform:rotate(0) scale(1)}27%,45%{transform:rotate(14deg) scaleX(.78)}}@keyframes robot-specification-claw-right{0%,62%,100%{transform:rotate(0) scale(1)}74%,88%{transform:rotate(-14deg) scaleX(.78)}}@keyframes robot-specification-input{0%{opacity:0;transform:translate(-10rem,.2rem) scale(.65)}8%,20%{opacity:1}31%{opacity:1;transform:translate(8.7rem,.2rem) scale(1)}40%,100%{opacity:0;transform:translate(11.25rem,.2rem) scale(.84)}}@keyframes robot-specification-output{0%,51%{opacity:0;transform:translate(-6rem,.2rem) scale(.65)}61%,82%{opacity:1;transform:translate(0,.2rem) scale(1)}100%{opacity:0;transform:translate(3.2rem,.2rem) scale(.7)}}@keyframes robot-push-body{0%,100%{transform:translateX(-50%)}45%{transform:translateX(calc(-50% + .95rem))}}@keyframes robot-push-upper{0%,100%{transform:rotate(-16deg)}45%{transform:rotate(-38deg)}}@keyframes robot-push-forearm{0%,100%{transform:rotate(21deg)}45%{transform:rotate(34deg)}}@keyframes robot-brace-upper{0%,100%{transform:rotate(16deg)}45%{transform:rotate(6deg)}}@keyframes robot-orb-out{0%,43%{opacity:0;transform:translate(0,0) scale(.3)}50%,70%{opacity:1}100%{opacity:0;transform:translate(18rem,-.2rem) scale(.2)}}
  .robot-controls{padding:clamp(1.35rem,2.5vw,2rem);border:1px solid #c9d9f2;border-radius:1.45rem;background:rgb(255 255 255/.76)}.robot-controls__buttons{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1rem}.robot-controls button{border:1px solid #a9c2e7;border-radius:.65rem;background:#fff;padding:.58rem .78rem;color:var(--color-blue-deep);font:700 .78rem/1 var(--font-mono);letter-spacing:.025em;transition:background .2s ease,color .2s ease,transform .2s ease}.robot-controls button:hover{transform:translateY(-2px);background:#edf4ff}.robot-controls button[aria-pressed='true']{border-color:#1f68d5;background:#1f68d5;color:#fff}.robot-controls__note{margin:1.2rem 0 0;color:var(--color-ink-soft);font-size:.9rem;line-height:1.55}
  @media(max-width:760px){.robot-lab__workspace{grid-template-columns:1fr}.robot-stage{min-height:24rem}.robot{width:17rem}.robot-stage__floor{bottom:4.5rem}.robot-stage__status{bottom:1.35rem}.robot-controls{max-width:none}}
  @media(prefers-reduced-motion:reduce){.robot *{animation:none!important}.robot__signal{display:none}}
</style>
