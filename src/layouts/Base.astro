---
import '../styles/global.css';
import { site } from '../data/site';

interface Props { title: string; description?: string }
const { title, description = site.description } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalPath = Astro.url.pathname.endsWith('/index.html')
  ? basePath
  : Astro.url.pathname;
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImage = new URL(`${basePath}hero-demo-preview.png`, siteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  description,
  applicationCategory: 'DeveloperApplication',
  creator: {
    '@type': 'Organization',
    name: site.owner,
    url: site.ownerUrl,
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#271587" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;0,700;0,800;1,900&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <script is:inline>
      (() => {
        const refreshMarkerKey = 'akaden-site-refresh-marker-v1';
        const navigationEntry = window.performance.getEntriesByType('navigation')[0];
        const isRefresh = Reflect.get(navigationEntry ?? {}, 'type') === 'reload';

        try {
          const currentMarker = Number(window.sessionStorage.getItem(refreshMarkerKey) ?? '0');
          window.sessionStorage.setItem(refreshMarkerKey, String(isRefresh ? currentMarker + 1 : currentMarker));
        } catch {
          // The site still works when browser storage is unavailable.
        }
      })();
    </script>
  </head>
  <body>
    <a class="u-skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
